# MediCare Docker Environment Configuration Template
# Copy this file to .env and adjust variables as needed for local demonstration.
# DO NOT commit .env containing real credentials to Git.

# SQL Server Configuration
MSSQL_SA_PASSWORD=YourStrong@Passw0rd!
MSSQL_PORT=1433

# Web Application Settings
ASPNETCORE_ENVIRONMENT=Development
WEB_HTTP_PORT=5000
PUBLIC_BASE_URL=http://localhost:5000

# Demonstration Seeding Passwords (Development Mode Only)
SEED_DEFAULT_PASSWORD=Demo@Pass123!
SEED_ADMIN_PASSWORD=Admin@Demo123456!
SEED_PHARMACIST_PASSWORD=Pharm@Demo123!

# Email Delivery (Optional - SendGrid Free Tier)
SENDGRID_API_KEY=
SENDGRID_ENABLED=false
SENDGRID_SENDER_EMAIL=noreply@medicare.local
SENDGRID_SENDER_NAME=MediCare Clinic System

# AI Assistant Settings (Optional)
OPENAI_API_KEY=
AI_PROVIDER=OpenAI
