@model MediCare.Services.DTOs.PaymentReceiptDto
@{
    ViewData["Title"] = $"Receipt #{Model.TransactionReference}";
}

<div class="row mb-3 d-print-none">
    <div class="col-12">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index"><i class="bi bi-house-door"></i> Home</a></li>
                <li class="breadcrumb-item"><a asp-controller="Appointments" asp-action="MyAppointments">My Appointments</a></li>
                <li class="breadcrumb-item"><a asp-controller="Appointments" asp-action="Details" asp-route-id="@Model.AppointmentId">Appointment #@Model.AppointmentId</a></li>
                <li class="breadcrumb-item active" aria-current="page">Receipt</li>
            </ol>
        </nav>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card bg-white shadow-sm border-0 p-4 p-md-5 position-relative overflow-hidden" id="receiptCard">
            <!-- Paid Watermark Stamp -->
            <div class="position-absolute end-0 top-0 mt-4 me-4 d-none d-sm-block" style="opacity: 0.15; transform: rotate(12deg); pointer-events: none;">
                <div class="border border-success border-5 rounded-4 p-3 text-center text-success fw-bolder" style="font-size: 2.2rem; letter-spacing: 0.15em;">
                    PAID &bull; VERIFIED
                </div>
            </div>

            <!-- Receipt Header -->
            <div class="d-flex justify-content-between align-items-start border-bottom pb-4 mb-4 flex-wrap gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="brand-icon shadow-sm" style="width: 48px; height: 48px; font-size: 1.5rem;">
                        <i class="bi bi-heart-pulse-fill text-white"></i>
                    </div>
                    <div>
                        <h3 class="fw-bold text-dark mb-0" data-i18n="receiptTitle">MediCare Clinics</h3>
                        <span class="text-muted small">Certified Medical Appointment & Telehealth System</span>
                    </div>
                </div>
                <div class="text-sm-end">
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 fs-6">
                        <i class="bi bi-check-circle-fill me-1"></i> <span data-i18n="apptPaidOnline">Payment Completed</span>
                    </span>
                    <div class="text-muted small mt-1">Ref: <strong>@Model.TransactionReference</strong></div>
                </div>
            </div>

            <!-- Key Info Grid -->
            <div class="row g-4 mb-4">
                <div class="col-sm-6">
                    <div class="p-3 bg-light rounded-3 border h-100">
                        <span class="text-muted small fw-semibold text-uppercase d-block mb-1">Billed To (Patient)</span>
                        <h5 class="fw-bold text-dark mb-1">@Model.PatientName</h5>
                        <div class="text-secondary small">Appointment Reference #@Model.AppointmentId</div>
                        <div class="text-secondary small">Clinic Visit Date: @Model.FormattedDate (@Model.FormattedTime)</div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="p-3 bg-light rounded-3 border h-100">
                        <span class="text-muted small fw-semibold text-uppercase d-block mb-1">Service Provider</span>
                        <h5 class="fw-bold text-dark mb-1">@Model.DoctorName</h5>
                        <div class="text-secondary small">Specialty: <strong>@Model.Specialization</strong></div>
                        <div class="text-secondary small">Licensed Medical Practitioner</div>
                    </div>
                </div>
            </div>

            <!-- Line Items Table -->
            <div class="table-responsive mb-4">
                <table class="table align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Description</th>
                            <th>Schedule Date</th>
                            <th>Payment Method</th>
                            <th class="text-end">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>
                                <div class="fw-bold text-dark">Clinical Consultation Fee</div>
                                <div class="text-muted small">Appointment #@Model.AppointmentId &bull; @Model.Specialization</div>
                            </td>
                            <td>
                                <div>@Model.FormattedDate</div>
                                <div class="text-muted small">@Model.FormattedTime</div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    <i class="bi bi-credit-card me-1 text-primary"></i> @Model.PaymentMethod
                                </span>
                            </td>
                            <td class="text-end fw-bold text-dark">
                                $@Model.AmountPaid.ToString("F2")
                            </td>
                        </tr>
                    </tbody>
                    <tfoot class="border-top">
                        @if (Model.DiscountAmount > 0)
                        {
                            <tr>
                                <td colspan="3" class="text-end fw-semibold text-muted">Original Consultation Fee:</td>
                                <td class="text-end fw-semibold text-dark">$@Model.OriginalAmount.ToString("F2")</td>
                            </tr>
                            <tr class="text-success">
                                <td colspan="3" class="text-end fw-semibold">
                                    <i class="bi bi-tag-fill me-1"></i> Promo Discount Applied (@(Model.AppliedPromoCode ?? "PROMO")):
                                </td>
                                <td class="text-end fw-bold">-$@Model.DiscountAmount.ToString("F2")</td>
                            </tr>
                        }
                        <tr>
                            <td colspan="3" class="text-end fw-semibold text-muted">Subtotal:</td>
                            <td class="text-end fw-semibold text-dark">$@Model.AmountPaid.ToString("F2")</td>
                        </tr>
                        <tr>
                            <td colspan="3" class="text-end fw-semibold text-muted">Applicable Taxes (0%):</td>
                            <td class="text-end fw-semibold text-dark">$0.00</td>
                        </tr>
                        <tr class="fs-5">
                            <td colspan="3" class="text-end fw-bold text-dark">Total Paid:</td>
                            <td class="text-end fw-bold text-success">$@Model.AmountPaid.ToString("F2")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <!-- Transaction Audit Metadata -->
            <div class="p-3 bg-light rounded-3 border mb-4">
                <div class="row g-2 text-muted small">
                    <div class="col-md-6">
                        <strong>Transaction ID:</strong> @Model.TransactionReference
                    </div>
                    <div class="col-md-6">
                        <strong>Processed At:</strong> @Model.PaidAt.ToString("yyyy-MM-dd HH:mm:ss") UTC
                    </div>
                    <div class="col-md-6">
                        <strong>Status:</strong> <span class="text-success fw-semibold">Settled & Confirmed</span>
                    </div>
                    <div class="col-md-6">
                        <strong>Authorized Gateway:</strong> MediCare Secure Card Services
                    </div>
                </div>
            </div>

            <!-- Footer / Disclaimers -->
            <div class="text-center text-muted small border-top pt-4">
                <p class="mb-1">This is an electronically generated official receipt. No physical signature is required.</p>
                <p class="mb-0">For billing inquiries or insurance claim disputes, please contact support@medicare.local or visit the clinic front desk.</p>
            </div>

            <!-- Actions (Hidden in Print) -->
            <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top d-print-none flex-wrap gap-2">
                <a asp-controller="Appointments" asp-action="MyAppointments" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> <span data-i18n="receiptReturn">Back to Appointments</span>
                </a>
                <div class="d-flex gap-2">
                    <a asp-controller="Appointments" asp-action="Details" asp-route-id="@Model.AppointmentId" class="btn btn-outline-primary">
                        <i class="bi bi-info-circle me-1"></i> <span data-i18n="apptViewReceipt">View Details</span>
                    </a>
                    <button type="button" class="btn btn-primary" onclick="window.print();">
                        <i class="bi bi-printer-fill me-1"></i> <span data-i18n="receiptPrint">Print / Download PDF</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    @@media print {
        body {
            background: #fff !important;
            padding: 0 !important;
            margin: 0 !important;
        }
        .mc-header, .mc-footer, .d-print-none, #aiChatbotContainer, .toast-container {
            display: none !important;
        }
        #receiptCard {
            border: none !important;
            box-shadow: none !important;
            padding: 0 !important;
        }
    }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.browser.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            if (window.confetti) {
                confetti({
                    particleCount: 100,
                    spread: 70,
                    origin: { y: 0.6 }
                });
            }
        });
    </script>
}
