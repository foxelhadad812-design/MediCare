@model AdminDashboardMetricsDto
@{
    ViewData["Title"] = "Admin Management Dashboard";
    var completionRate = Model.TotalAppointments > 0 ? (Model.CompletedVisitsCount * 100.0 / Model.TotalAppointments) : 0.0;
}

<div class="row mb-3">
    <div class="col-12">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item active" aria-current="page">Admin Dashboard</li>
            </ol>
        </nav>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold mb-1">&#9881;&#65039; Clinic Management Dashboard</h2>
        <p class="text-muted mb-0">Operational performance, revenue intelligence, and clinical activity overview.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Approvals" class="btn btn-warning position-relative fw-semibold">
            &#128104;&#8205;&#9877;&#65039; Doctor Approvals
            @if (Model.PendingDoctorsCount > 0)
            {
                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                    @Model.PendingDoctorsCount
                </span>
            }
        </a>
        <a asp-action="ExportAppointmentsCsv" class="btn btn-outline-success fw-semibold">
            &#128229; Export CSV
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        &#10004; @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        &#9888; @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Top Metrics Ribbon -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card shadow-sm border-0 h-100 bg-white">
            <div class="card-body p-3">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-primary-subtle text-primary p-3 me-3 fs-3">
                        &#128197;
                    </div>
                    <div>
                        <div class="text-muted small fw-semibold">TOTAL APPOINTMENTS</div>
                        <h3 class="fw-bold mb-0 text-dark">@Model.TotalAppointments.ToString("N0")</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card shadow-sm border-0 h-100 bg-white">
            <div class="card-body p-3">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-success-subtle text-success p-3 me-3 fs-3">
                        &#129658;
                    </div>
                    <div>
                        <div class="text-muted small fw-semibold">ACTIVE DOCTORS</div>
                        <h3 class="fw-bold mb-0 text-dark">@Model.ActiveDoctorsCount</h3>
                        @if (Model.PendingDoctorsCount > 0)
                        {
                            <span class="badge bg-warning-subtle text-warning-emphasis border mt-1">
                                @Model.PendingDoctorsCount Pending Review
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card shadow-sm border-0 h-100 bg-white">
            <div class="card-body p-3">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-info-subtle text-info p-3 me-3 fs-3">
                        &#10004;
                    </div>
                    <div>
                        <div class="text-muted small fw-semibold">COMPLETED VISITS</div>
                        <h3 class="fw-bold mb-0 text-dark">@Model.CompletedVisitsCount.ToString("N0")</h3>
                        <span class="text-muted small">@completionRate.ToString("F1")% Completion Rate</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card shadow-sm border-0 h-100 bg-white">
            <div class="card-body p-3">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-warning-subtle text-warning p-3 me-3 fs-3">
                        &#128178;
                    </div>
                    <div>
                        <div class="text-muted small fw-semibold">TOTAL REVENUE (PAID)</div>
                        <h3 class="fw-bold mb-0 text-dark">@Model.TotalRevenueCollected.ToString("N0") <span class="fs-6 fw-normal text-muted">EGP</span></h3>
                        <span class="text-muted small">Pending: @Model.TotalPendingRevenue.ToString("N0") EGP</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Charts Section -->
<div class="row g-4 mb-4">
    <!-- Chart 1: Monthly Appointment Trends -->
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 h-100 bg-white">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-dark">&#128200; Monthly Appointment Volumes by Status</h5>
                <span class="badge bg-light text-muted border">Past 12 Months</span>
            </div>
            <div class="card-body p-3">
                <canvas id="monthlyStatusChart" height="260"></canvas>
            </div>
        </div>
    </div>

    <!-- Chart 2: Specializations Breakdown -->
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 h-100 bg-white">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="fw-bold mb-0 text-dark">&#127919; Visits by Specialization</h5>
            </div>
            <div class="card-body p-3 d-flex align-items-center justify-content-center">
                @if (Model.SpecializationBreakdown.Any(s => s.AppointmentCount > 0))
                {
                    <canvas id="specializationChart" height="260"></canvas>
                }
                else
                {
                    <div class="text-center text-muted p-4">
                        <div class="fs-2 mb-2">&#127796;</div>
                        <p class="mb-0">No specialization visit data recorded yet.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Chart 3: Monthly Financial Revenue Breakdown -->
<div class="row g-4 mb-4">
    <div class="col-12">
        <div class="card shadow-sm border-0 bg-white">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-dark">&#128181; Monthly Consultation Revenue (Collected vs. Pending)</h5>
                <a asp-action="Reports" class="btn btn-sm btn-outline-primary">View Detailed Reports</a>
            </div>
            <div class="card-body p-3">
                <canvas id="revenueChart" height="120"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Data from model
            const monthlyLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyTrends.Select(m => m.MonthLabel)));
            const completedData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyTrends.Select(m => m.CompletedCount)));
            const cancelledData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyTrends.Select(m => m.CancelledCount)));
            const noShowData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyTrends.Select(m => m.NoShowCount)));

            const paidRevenueData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyTrends.Select(m => m.PaidRevenue)));
            const unpaidRevenueData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyTrends.Select(m => m.UnpaidRevenue)));

            const specLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SpecializationBreakdown.Select(s => s.SpecializationName)));
            const specData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SpecializationBreakdown.Select(s => s.AppointmentCount)));

            // 1. Monthly Status Chart (Grouped Bar)
            const ctxStatus = document.getElementById("monthlyStatusChart");
            if (ctxStatus) {
                new Chart(ctxStatus, {
                    type: "bar",
                    data: {
                        labels: monthlyLabels,
                        datasets: [
                            {
                                label: "Completed",
                                data: completedData,
                                backgroundColor: "rgba(25, 135, 84, 0.7)",
                                borderColor: "rgba(25, 135, 84, 1)",
                                borderWidth: 1
                            },
                            {
                                label: "Cancelled",
                                data: cancelledData,
                                backgroundColor: "rgba(108, 117, 125, 0.7)",
                                borderColor: "rgba(108, 117, 125, 1)",
                                borderWidth: 1
                            },
                            {
                                label: "No-Show",
                                data: noShowData,
                                backgroundColor: "rgba(220, 53, 69, 0.7)",
                                borderColor: "rgba(220, 53, 69, 1)",
                                borderWidth: 1
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: { stepSize: 1 }
                            }
                        }
                    }
                });
            }

            // 2. Specializations Doughnut Chart
            const ctxSpec = document.getElementById("specializationChart");
            if (ctxSpec && specData.some(v => v > 0)) {
                new Chart(ctxSpec, {
                    type: "doughnut",
                    data: {
                        labels: specLabels,
                        datasets: [{
                            data: specData,
                            backgroundColor: [
                                "#0d6efd", "#20c997", "#ffc107", "#fd7e14",
                                "#6f42c1", "#d63384", "#0dcaf0", "#6c757d"
                            ]
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: {
                            legend: {
                                position: "bottom"
                            }
                        }
                    }
                });
            }

            // 3. Revenue Chart (Bar)
            const ctxRev = document.getElementById("revenueChart");
            if (ctxRev) {
                new Chart(ctxRev, {
                    type: "bar",
                    data: {
                        labels: monthlyLabels,
                        datasets: [
                            {
                                label: "Paid Revenue (EGP)",
                                data: paidRevenueData,
                                backgroundColor: "rgba(13, 110, 253, 0.7)",
                                borderColor: "rgba(13, 110, 253, 1)",
                                borderWidth: 1
                            },
                            {
                                label: "Pending Revenue (EGP)",
                                data: unpaidRevenueData,
                                backgroundColor: "rgba(255, 193, 7, 0.7)",
                                borderColor: "rgba(255, 193, 7, 1)",
                                borderWidth: 1
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        scales: {
                            y: {
                                beginAtZero: true
                            }
                        }
                    }
                });
            }
        });
    </script>
}
