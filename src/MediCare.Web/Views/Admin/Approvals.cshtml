@model List<DoctorApprovalSummaryDto>
@{
    ViewData["Title"] = "Doctor Registration Approvals";
}

<div class="row mb-3">
    <div class="col-12">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item"><a asp-action="Index">Admin Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">Doctor Approvals</li>
            </ol>
        </nav>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold mb-1">&#128104;&#8205;&#9877;&#65039; Doctor Registration Approvals</h2>
        <p class="text-muted mb-0">Verify physician licenses and approve new doctor accounts before they appear in public listings.</p>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            &larr; Back to Dashboard
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        &#10004; @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        &#9888; @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card bg-white shadow-sm border-0">
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Doctor</th>
                            <th>Specialization</th>
                            <th>License #</th>
                            <th>Contact</th>
                            <th>Fee</th>
                            <th>Registered</th>
                            <th class="text-end">Verification Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var doc in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold text-dark">Dr. @doc.FullName</div>
                                    <span class="text-muted small">ID #@doc.Id</span>
                                </td>
                                <td>
                                    <span class="badge bg-info-subtle text-info border">@doc.SpecializationName</span>
                                </td>
                                <td>
                                    <code class="text-dark bg-light px-2 py-1 rounded">@doc.LicenseNumber</code>
                                </td>
                                <td>
                                    <div><a href="mailto:@doc.Email" class="text-decoration-none small">@doc.Email</a></div>
                                    @if (!string.IsNullOrEmpty(doc.PhoneNumber))
                                    {
                                        <div class="text-muted small">@doc.PhoneNumber</div>
                                    }
                                </td>
                                <td>
                                    <span class="fw-semibold text-dark">@doc.ConsultationFee.ToString("N0") EGP</span>
                                </td>
                                <td>
                                    <span class="text-muted small">@doc.FormattedRegisteredAt</span>
                                </td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-2">
                                        <!-- Approve Action -->
                                        <form asp-action="ApproveDoctor" asp-route-id="@doc.Id" method="post" class="d-inline" onsubmit="return confirm('Approve Dr. @doc.FullName? They will be granted full access to patient bookings.');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-success px-3">
                                                &#10003; Approve
                                            </button>
                                        </form>

                                        <!-- Reject Trigger Modal / Inline -->
                                        <button type="button" class="btn btn-sm btn-outline-danger px-3" data-bs-toggle="modal" data-bs-target="#rejectModal-@doc.Id">
                                            &#10007; Decline
                                        </button>
                                    </div>

                                    <!-- Reject Reason Modal -->
                                    <div class="modal fade" id="rejectModal-@doc.Id" tabindex="-1" aria-labelledby="rejectModalLabel-@doc.Id" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content text-start">
                                                <form asp-action="RejectDoctor" asp-route-id="@doc.Id" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <div class="modal-header">
                                                        <h5 class="modal-title fw-bold" id="rejectModalLabel-@doc.Id">Decline Registration: Dr. @doc.FullName</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <p class="text-muted small">Please specify the reason for declining this application. An explanatory email will be dispatched to the applicant.</p>
                                                        <div class="mb-3">
                                                            <label class="form-label fw-semibold">Reason for Decline</label>
                                                            <textarea name="reason" class="form-control" rows="3" placeholder="e.g. Invalid medical syndicate registration number..."></textarea>
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                                        <button type="submit" class="btn btn-danger">Confirm Decline</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-5 text-center text-muted">
                <div class="fs-1 mb-2">&#127881;</div>
                <h5 class="fw-bold text-dark">No Pending Doctor Registrations</h5>
                <p class="mb-0">All submitted physician applications have been reviewed and approved.</p>
            </div>
        }
    </div>
</div>
