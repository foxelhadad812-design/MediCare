@model List<SpecializationDto>
@{
    ViewData["Title"] = "Clinical Specializations Management";
}

<div class="row mb-3">
    <div class="col-12">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index"><i class="bi bi-house-door"></i> Home</a></li>
                <li class="breadcrumb-item"><a asp-action="Index">Admin Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">Specializations</li>
            </ol>
        </nav>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold mb-1 text-dark d-flex align-items-center gap-2">
            <i class="bi bi-diagram-3-fill text-primary"></i> Medical Specializations
        </h2>
        <p class="text-secondary mb-0">Manage clinical departments and specializations available for patient booking.</p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-primary fw-semibold" data-bs-toggle="modal" data-bs-target="#createSpecModal">
            <i class="bi bi-plus-circle me-1"></i> Add Specialization
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Dashboard
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert">
        <i class="bi bi-check-circle-fill text-success fs-5"></i>
        <div class="flex-grow-1">@TempData["SuccessMessage"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
        <div class="flex-grow-1">@TempData["ErrorMessage"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Specializations List Card -->
<div class="card bg-white shadow-sm border-0">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0 text-dark">
            Specializations Directory <span class="badge bg-primary-subtle text-primary border ms-2">@Model.Count</span>
        </h5>
    </div>
    <div class="card-body p-0">
        @if (Model.Count == 0)
        {
            <div class="text-center py-5">
                <i class="bi bi-folder-x display-4 text-muted mb-3 d-block"></i>
                <h5 class="text-muted">No specializations configured</h5>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 80px;">ID</th>
                            <th>Department / Specialization</th>
                            <th>Description</th>
                            <th class="text-end pe-3" style="width: 180px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var spec in Model)
                        {
                            <tr>
                                <td class="text-muted fw-semibold">#@spec.Id</td>
                                <td>
                                    <span class="fw-bold text-dark fs-6">@spec.Name</span>
                                </td>
                                <td>
                                    <span class="text-secondary small">@(spec.Description ?? "No description provided.")</span>
                                </td>
                                <td class="text-end pe-3">
                                    <div class="d-flex justify-content-end gap-1">
                                        <button type="button" class="btn btn-sm btn-outline-primary"
                                                data-bs-toggle="modal" data-bs-target="#editSpecModal"
                                                data-spec-id="@spec.Id"
                                                data-spec-name="@spec.Name"
                                                data-spec-desc="@(spec.Description ?? "")">
                                            <i class="bi bi-pencil-square"></i> Edit
                                        </button>
                                        <form method="post" asp-action="DeleteSpecialization" asp-route-id="@spec.Id" class="d-inline"
                                              onsubmit="return confirm('Are you sure you want to delete specialization \'@spec.Name\'?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i> Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Modal: Create Specialization -->
<div class="modal fade" id="createSpecModal" tabindex="-1" aria-labelledby="createSpecModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-action="CreateSpecialization">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="createSpecModalLabel">
                        <i class="bi bi-plus-circle text-primary me-1"></i> Add Specialization
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-dialog-body p-3">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Specialization Name <span class="text-danger">*</span></label>
                        <input type="text" name="Name" class="form-control" placeholder="e.g. Cardiology" required maxlength="100" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Description</label>
                        <textarea name="Description" class="form-control" rows="3" placeholder="Clinical description and scope of care..." maxlength="500"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary fw-semibold">Save Specialization</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Edit Specialization -->
<div class="modal fade" id="editSpecModal" tabindex="-1" aria-labelledby="editSpecModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" id="editSpecForm" asp-action="UpdateSpecialization">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="editSpecModalLabel">
                        <i class="bi bi-pencil-square text-primary me-1"></i> Edit Specialization
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-dialog-body p-3">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Specialization Name <span class="text-danger">*</span></label>
                        <input type="text" name="Name" id="editSpecName" class="form-control" required maxlength="100" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Description</label>
                        <textarea name="Description" id="editSpecDesc" class="form-control" rows="3" maxlength="500"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary fw-semibold">Update Specialization</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const editModal = document.getElementById("editSpecModal");
            if (editModal) {
                editModal.addEventListener("show.bs.modal", function (event) {
                    const button = event.relatedTarget;
                    const id = button.getAttribute("data-spec-id");
                    const name = button.getAttribute("data-spec-name");
                    const desc = button.getAttribute("data-spec-desc");

                    const form = document.getElementById("editSpecForm");
                    form.action = `/Admin/UpdateSpecialization/${id}`;

                    document.getElementById("editSpecName").value = name;
                    document.getElementById("editSpecDesc").value = desc;
                });
            }
        });
    </script>
}
