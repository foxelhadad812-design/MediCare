@model List<AdminPatientSummaryDto>
@{
    ViewData["Title"] = "Patient Registry & Account Management";
    var currentSearch = ViewData["CurrentSearch"] as string;
}

<div class="row mb-3">
    <div class="col-12">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index"><i class="bi bi-house-door"></i> Home</a></li>
                <li class="breadcrumb-item"><a asp-action="Index">Admin Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">Patient Registry</li>
            </ol>
        </nav>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold mb-1 text-dark d-flex align-items-center gap-2">
            <i class="bi bi-people-fill text-primary"></i> Patient Registry & Management
        </h2>
        <p class="text-secondary mb-0">Inspect registered patients, view clinical profile flags, and manage system access.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Dashboard
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert">
        <i class="bi bi-check-circle-fill text-success fs-5"></i>
        <div class="flex-grow-1">@TempData["SuccessMessage"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
        <div class="flex-grow-1">@TempData["ErrorMessage"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Search & Filter Card -->
<div class="card bg-white shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Patients" class="row g-2 align-items-center">
            <div class="col-md-9 col-lg-10">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" value="@currentSearch" class="form-control border-start-0" 
                           placeholder="Search by patient name, email, or phone number..." />
                </div>
            </div>
            <div class="col-md-3 col-lg-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100 fw-semibold">
                    <i class="bi bi-filter"></i> Filter
                </button>
                @if (!string.IsNullOrWhiteSpace(currentSearch))
                {
                    <a asp-action="Patients" class="btn btn-outline-secondary" title="Clear search">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Patients List Card -->
<div class="card bg-white shadow-sm border-0">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0 text-dark">
            Registered Patients <span class="badge bg-primary-subtle text-primary border ms-2">@Model.Count</span>
        </h5>
    </div>
    <div class="card-body p-0">
        @if (Model.Count == 0)
        {
            <div class="text-center py-5">
                <i class="bi bi-people display-4 text-muted mb-3 d-block"></i>
                <h5 class="text-muted">No patient records found</h5>
                <p class="text-secondary small">Try adjusting your search criteria or register new patients.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Patient</th>
                            <th>Contact</th>
                            <th>Demographics</th>
                            <th>Allergies & History</th>
                            <th class="text-center">Visits</th>
                            <th class="text-center">Status</th>
                            <th class="text-end pe-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var patient in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center fw-bold" style="width: 40px; height: 40px; font-size: 1rem;">
                                            @(patient.FullName.Length > 0 ? patient.FullName[0].ToString().ToUpper() : "P")
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark">@patient.FullName</div>
                                            <div class="text-muted small">ID: #@patient.Id</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div><i class="bi bi-envelope small text-muted me-1"></i>@patient.Email</div>
                                    @if (!string.IsNullOrEmpty(patient.PhoneNumber))
                                    {
                                        <div class="text-muted small"><i class="bi bi-telephone small text-muted me-1"></i>@patient.PhoneNumber</div>
                                    }
                                </td>
                                <td>
                                    <div>@(DateTime.Today.Year - patient.DateOfBirth.Year) yrs (@patient.Gender)</div>
                                    @if (!string.IsNullOrEmpty(patient.BloodGroup))
                                    {
                                        <span class="badge bg-danger-subtle text-danger border">Blood: @patient.BloodGroup</span>
                                    }
                                </td>
                                <td style="max-width: 250px;">
                                    @if (!string.IsNullOrEmpty(patient.Allergies))
                                    {
                                        <div class="mb-1">
                                            <span class="badge bg-warning-subtle text-warning-emphasis border text-truncate d-inline-block" style="max-width: 240px;" title="@patient.Allergies">
                                                <i class="bi bi-shield-exclamation me-1"></i>@patient.Allergies
                                            </span>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(patient.MedicalHistory))
                                    {
                                        <div class="small text-muted text-truncate" style="max-width: 240px;" title="@patient.MedicalHistory">
                                            <i class="bi bi-file-medical me-1"></i>@patient.MedicalHistory
                                        </div>
                                    }
                                    @if (string.IsNullOrEmpty(patient.Allergies) && string.IsNullOrEmpty(patient.MedicalHistory))
                                    {
                                        <span class="text-muted small">None recorded</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-secondary-subtle text-secondary-emphasis border">@patient.TotalAppointments</span>
                                </td>
                                <td class="text-center">
                                    @if (patient.IsLockedOut)
                                    {
                                        <span class="badge bg-danger-subtle text-danger border"><i class="bi bi-lock-fill me-1"></i>Locked</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success border"><i class="bi bi-check-circle-fill me-1"></i>Active</span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <form method="post" asp-action="TogglePatientLockout" asp-route-id="@patient.Id" class="d-inline"
                                          onsubmit="return confirm('Are you sure you want to @(patient.IsLockedOut ? "unlock" : "lock") this patient account?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="lockout" value="@(patient.IsLockedOut ? "false" : "true")" />
                                        @if (patient.IsLockedOut)
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-success">
                                                <i class="bi bi-unlock-fill me-1"></i> Unlock
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-lock-fill me-1"></i> Lockout
                                            </button>
                                        }
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
