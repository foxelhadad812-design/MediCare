@model List<MediCare.Services.DTOs.AppointmentSummaryDto>
@{
    ViewData["Title"] = "Doctor Appointments Management";
    var currentStatus = ViewBag.CurrentStatus as MediCare.Data.Enums.AppointmentStatus?;
    var currentDate = ViewBag.CurrentDate as string;
}

<div class="row mb-3">
    <div class="col-12">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item active" aria-current="page">Doctor Appointments</li>
            </ol>
        </nav>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold mb-1">&#128101; Patient Appointments Queue</h2>
        <p class="text-muted mb-0">Review pending reservation requests, confirm consultations, and manage daily clinic attendance.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Schedule" class="btn btn-outline-secondary btn-sm">
            &#128197; Weekly Schedule
        </a>
        <a asp-action="Leaves" class="btn btn-outline-secondary btn-sm">
            &#127958;&#65039; Leaves
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        &#10004; @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        &#9888; @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Filters Bar -->
<div class="card bg-white shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Appointments" class="row g-2 align-items-end">
            <div class="col-md-4 col-sm-6">
                <label class="form-label small fw-medium mb-1">Filter by Status</label>
                <select name="status" class="form-select form-select-sm">
                    <option value="">All Statuses</option>
                    @foreach (MediCare.Data.Enums.AppointmentStatus s in Enum.GetValues(typeof(MediCare.Data.Enums.AppointmentStatus)))
                    {
                        <!option value="@s" @(currentStatus == s ? "selected" : "")>@s</!option>
                    }
                </select>
            </div>
            <div class="col-md-4 col-sm-6">
                <label class="form-label small fw-medium mb-1">Filter by Date</label>
                <input type="date" name="date" class="form-control form-control-sm" value="@currentDate" />
            </div>
            <div class="col-md-4 col-sm-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm flex-grow-1">Apply Filter</button>
                <a asp-action="Appointments" class="btn btn-outline-secondary btn-sm">Clear</a>
            </div>
        </form>
    </div>
</div>

<!-- Appointments Table -->
<div class="card bg-white shadow-sm border-0">
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Patient Name</th>
                            <th>Scheduled Slot</th>
                            <th>Type</th>
                            <th>Status</th>
                            <th>Notes</th>
                            <th class="text-end">Lifecycle Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold text-muted">#@item.Id</td>
                                <td>
                                    <div class="fw-bold text-dark">@item.PatientName</div>
                                    @if (!string.IsNullOrEmpty(item.PatientPhoneNumber))
                                    {
                                        <span class="text-muted small">&#128222; @item.PatientPhoneNumber</span>
                                    }
                                </td>
                                <td>
                                    <div class="fw-medium text-dark">@item.FormattedDate</div>
                                    <div class="text-muted small">&#128337; @item.FormattedTime</div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@item.Type</span>
                                </td>
                                <td>
                                    @switch (item.Status)
                                    {
                                        case MediCare.Data.Enums.AppointmentStatus.Pending:
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1">
                                                &#8987; Pending Approval
                                            </span>
                                            break;
                                        case MediCare.Data.Enums.AppointmentStatus.Confirmed:
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                                &#10003; Confirmed
                                            </span>
                                            break;
                                        case MediCare.Data.Enums.AppointmentStatus.Completed:
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                                                &#10004; Completed
                                            </span>
                                            break;
                                        case MediCare.Data.Enums.AppointmentStatus.Cancelled:
                                            <span class="badge bg-secondary-subtle text-secondary px-2 py-1">Cancelled</span>
                                            break;
                                        case MediCare.Data.Enums.AppointmentStatus.Rejected:
                                            <span class="badge bg-danger-subtle text-danger px-2 py-1">Declined</span>
                                            break;
                                        case MediCare.Data.Enums.AppointmentStatus.NoShow:
                                            <span class="badge bg-dark-subtle text-dark px-2 py-1">No-Show</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    <span class="small text-muted text-truncate d-inline-block" style="max-width: 150px;" title="@item.Notes">
                                        @(string.IsNullOrEmpty(item.Notes) ? "-" : item.Notes)
                                    </span>
                                </td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-1 flex-wrap">
                                        @if (item.Status == MediCare.Data.Enums.AppointmentStatus.Pending)
                                        {
                                            <form asp-action="ConfirmAppointment" asp-route-id="@item.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-success px-2 py-1" title="Accept and confirm visit">
                                                    &#10003; Confirm
                                                </button>
                                            </form>
                                            <form asp-action="RejectAppointment" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to decline this appointment request? The slot will be released.');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger px-2 py-1" title="Decline request">
                                                    &#10007; Decline
                                                </button>
                                            </form>
                                        }
                                        else if (item.Status == MediCare.Data.Enums.AppointmentStatus.Confirmed)
                                        {
                                            <a asp-controller="MedicalRecords" asp-action="Create" asp-route-appointmentId="@item.Id" class="btn btn-sm btn-primary px-2 py-1" title="Document clinical encounter and complete visit">
                                                &#128221; Consult
                                            </a>
                                            <form asp-action="MarkNoShow" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Confirm that the patient did not attend this scheduled visit?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-dark px-2 py-1" title="Mark patient as absent">
                                                    No-Show
                                                </button>
                                            </form>
                                        }

                                        <a asp-controller="Appointments" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary px-2 py-1">
                                            Details
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-5 text-center text-muted">
                <div class="fs-1 mb-2">&#128203;</div>
                <h5 class="fw-bold text-dark">No Appointments Found</h5>
                <p class="mb-0">There are no patient appointments matching your current filter criteria.</p>
            </div>
        }
    </div>
</div>
