@{
    ViewData["Title"] = "Modern Healthcare Management & Appointments";
}

<!-- Hero Section -->
<div class="hero-section mb-5">
    <div class="row align-items-center py-3">
        <div class="col-lg-10 mx-auto text-center">
            <div class="hero-pill-badge">
                <span class="status-dot" style="background:#10B981; box-shadow:0 0 8px #10B981;"></span>
                <span>Next-Gen Healthcare OS &bull; Cairo Clinic Network</span>
            </div>

            <h1 class="hero-title mt-2 mb-3">
                Modern Healthcare,<br />
                <span class="hero-highlight">Seamlessly Scheduled.</span>
            </h1>

            <p class="fs-5 text-secondary col-lg-9 mx-auto mb-4" style="line-height: 1.6;">
                Connect with verified medical specialists, book guaranteed conflict-free consultation slots, and track your clinical health journey in one intelligent platform.
            </p>

            <!-- Hero Search Form -->
            <form method="get" asp-controller="Doctors" asp-action="Index" class="hero-search-card text-start">
                <div class="row g-2 align-items-center p-1">
                    <div class="col-md-8 col-sm-12">
                        <div class="input-icon-group">
                            <i class="bi bi-search"></i>
                            <input type="text" name="SearchTerm" class="form-control border-0 shadow-none ps-5" placeholder="Search doctor name, specialty, condition..." />
                        </div>
                    </div>
                    <div class="col-md-4 col-sm-12">
                        <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                            <i class="bi bi-search-heart"></i> Find Doctors
                        </button>
                    </div>
                </div>
            </form>

            <!-- Specialty Quick Selector Pills -->
            <div class="d-flex flex-wrap justify-content-center gap-2 mt-3 pt-1">
                <span class="small text-muted align-self-center me-1 fw-semibold">Popular:</span>
                <a asp-controller="Doctors" asp-action="Index" asp-route-SearchTerm="Cardiology" class="specialty-quick-pill">
                    <i class="bi bi-heart-pulse text-danger"></i> Cardiology
                </a>
                <a asp-controller="Doctors" asp-action="Index" asp-route-SearchTerm="Dermatology" class="specialty-quick-pill">
                    <i class="bi bi-bandaid text-warning"></i> Dermatology
                </a>
                <a asp-controller="Doctors" asp-action="Index" asp-route-SearchTerm="Pediatrics" class="specialty-quick-pill">
                    <i class="bi bi-balloon text-info"></i> Pediatrics
                </a>
                <a asp-controller="Doctors" asp-action="Index" asp-route-SearchTerm="Orthopedics" class="specialty-quick-pill">
                    <i class="bi bi-person-walking text-primary"></i> Orthopedics
                </a>
                <a asp-controller="Doctors" asp-action="Index" asp-route-SearchTerm="Internal Medicine" class="specialty-quick-pill">
                    <i class="bi bi-capsule text-success"></i> Internal Medicine
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Trust Statistics Ribbon -->
<div class="trust-stats-ribbon mb-5">
    <div class="row g-4 align-items-center text-center">
        <div class="col-6 col-md-3">
            <div class="trust-stat-item">
                <div class="trust-stat-number text-primary">0</div>
                <div class="trust-stat-label">Double Bookings (SQL Concurrency)</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="trust-stat-item">
                <div class="trust-stat-number text-success">100%</div>
                <div class="trust-stat-label">Admin-Verified Clinicians</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="trust-stat-item">
                <div class="trust-stat-number text-info">&lt; 30s</div>
                <div class="trust-stat-label">Instant Slot Reservation</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="trust-stat-item">
                <div class="trust-stat-number text-warning">Real-Time</div>
                <div class="trust-stat-label">SignalR Live Synchronization</div>
            </div>
        </div>
    </div>
</div>

<!-- Core Architectural Pillars -->
<div class="mb-5">
    <div class="text-center mb-4">
        <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill fw-bold text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.05em;">Engineering Excellence</span>
        <h2 class="fw-bold mt-2">Why Healthcare Providers Choose MediCare</h2>
        <p class="text-muted col-md-6 mx-auto">Engineered from the ground up for medical data reliability, precision scheduling, and seamless doctor-patient interactions.</p>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card h-100 p-4 border-0 card-hover-elevate">
                <div class="feature-icon-box bg-primary-subtle text-primary">
                    <i class="bi bi-shield-check"></i>
                </div>
                <h4 class="fw-bold mb-2">Zero Double-Booking</h4>
                <p class="text-secondary small mb-3">
                    Enforced at the database engine level via SQL Server filtered concurrency indexes. Overlapping bookings are mathematically prevented even under high concurrency.
                </p>
                <div class="mt-auto pt-2">
                    <span class="badge bg-light text-dark border">
                        <i class="bi bi-database-check me-1 text-primary"></i> ACID Atomic Transactions
                    </span>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 p-4 border-0 card-hover-elevate">
                <div class="feature-icon-box bg-success-subtle text-success">
                    <i class="bi bi-person-badge"></i>
                </div>
                <h4 class="fw-bold mb-2">Verified Specialists</h4>
                <p class="text-secondary small mb-3">
                    Every physician undergoes clinical license validation before listing. View verified credentials, transparent consultation fees, and recurring shift schedules.
                </p>
                <div class="mt-auto pt-2">
                    <a asp-controller="Doctors" asp-action="Index" class="fw-bold text-success text-decoration-none small">
                        Explore Directory <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 p-4 border-0 card-hover-elevate">
                <div class="feature-icon-box bg-info-subtle text-info">
                    <i class="bi bi-file-earmark-medical"></i>
                </div>
                <h4 class="fw-bold mb-2">Digital Health Passport</h4>
                <p class="text-secondary small mb-3">
                    Automated clinical documentation upon encounter completion: diagnoses, physical symptoms, doctor notes, and printable digital prescriptions with dosage guidelines.
                </p>
                <div class="mt-auto pt-2">
                    <span class="badge bg-light text-dark border">
                        <i class="bi bi-printer me-1 text-info"></i> Printable Rx Ready
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- How It Works Section -->
<div class="card bg-white p-4 p-md-5 border-0 shadow-sm mb-5">
    <div class="row align-items-center g-4">
        <div class="col-lg-4 text-center text-lg-start">
            <span class="badge bg-secondary-subtle text-secondary px-3 py-1 rounded-pill fw-semibold small">Quick Walkthrough</span>
            <h3 class="fw-bold mt-2">Effortless Care in 3 Simple Steps</h3>
            <p class="text-muted small">Designed to remove friction for both patients and clinicians, ensuring rapid consultations and continuous care.</p>
        </div>
        <div class="col-lg-8">
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="d-flex align-items-start gap-3">
                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold flex-shrink-0" style="width: 38px; height: 38px;">1</div>
                        <div>
                            <h6 class="fw-bold mb-1">Find Specialist</h6>
                            <p class="text-muted small mb-0">Search by department, fee range, or weekly availability day.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="d-flex align-items-start gap-3">
                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold flex-shrink-0" style="width: 38px; height: 38px;">2</div>
                        <div>
                            <h6 class="fw-bold mb-1">Reserve Slot</h6>
                            <p class="text-muted small mb-0">Select an open 30-minute interval on the interactive clinic calendar.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="d-flex align-items-start gap-3">
                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold flex-shrink-0" style="width: 38px; height: 38px;">3</div>
                        <div>
                            <h6 class="fw-bold mb-1">Consult & Rx</h6>
                            <p class="text-muted small mb-0">Attend visit, receive medical diagnosis and digital prescription.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Dual CTA Section -->
<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="card p-4 border-0 h-100" style="background: linear-gradient(135deg, #EFF6FF 0%, #DBEAFE 100%);">
            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="rounded-circle bg-primary text-white p-3 fs-4 d-inline-flex">
                    <i class="bi bi-person-check-fill"></i>
                </div>
                <div>
                    <h4 class="fw-bold mb-0 text-dark">Need Medical Care?</h4>
                    <span class="text-secondary small">Access over 20+ specialized clinic doctors</span>
                </div>
            </div>
            <p class="text-secondary small mb-4">
                Explore our accredited directory, check real-time availability in Cairo time, and book your appointment with zero conflict risk.
            </p>
            <div class="mt-auto">
                <a asp-controller="Doctors" asp-action="Index" class="btn btn-primary">
                    <i class="bi bi-calendar2-plus"></i> Book Consultation Now
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card p-4 border-0 h-100" style="background: linear-gradient(135deg, #F0FDF4 0%, #DCFCE7 100%);">
            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="rounded-circle bg-success text-white p-3 fs-4 d-inline-flex">
                    <i class="bi bi-hospital-fill"></i>
                </div>
                <div>
                    <h4 class="fw-bold mb-0 text-dark">Are You a Physician?</h4>
                    <span class="text-secondary small">Expand your clinical reach with MediCare</span>
                </div>
            </div>
            <p class="text-secondary small mb-4">
                Configure your weekly shifts, review patient appointments, manage attendance, and issue structured e-prescriptions.
            </p>
            <div class="mt-auto">
                @if (User.Identity?.IsAuthenticated != true)
                {
                    <a asp-controller="Account" asp-action="RegisterDoctor" class="btn btn-outline-success bg-white">
                        <i class="bi bi-clipboard2-plus"></i> Register Doctor Practice
                    </a>
                }
                else if (User.IsInRole("Doctor"))
                {
                    <a asp-controller="Doctor" asp-action="Appointments" class="btn btn-success text-white">
                        <i class="bi bi-clipboard-pulse"></i> Open Doctor Portal
                    </a>
                }
                else
                {
                    <span class="badge bg-light text-success border p-2">Logged in as Patient</span>
                }
            </div>
        </div>
    </div>
</div>
