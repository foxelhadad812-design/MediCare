@{
    ViewData["Title"] = "Modern Healthcare Management & Appointments";
}

<!-- =====================================================================
     HERO SECTION WITH 2-COLUMN LAYOUT & CLINICAL GRAPHIC
     ===================================================================== -->
<div class="hero-section mb-5">
    <div class="row align-items-center g-5 py-3">
        <div class="col-lg-7 text-start">
            <div class="hero-pill-badge mb-3">
                <span class="status-dot" style="background:#10B981; box-shadow:0 0 8px #10B981;"></span>
                <span data-i18n="heroBadge">Next-Gen Healthcare OS &bull; Cairo Clinic Network</span>
            </div>

            <h1 class="hero-title mb-3">
                <span data-i18n="heroTitlePart1">Modern Healthcare,</span><br />
                <span class="hero-highlight" data-i18n="heroTitlePart2">Seamlessly Scheduled.</span>
            </h1>

            <p class="fs-5 text-secondary mb-4" style="line-height: 1.6;" data-i18n="heroSubtitle">
                Connect with verified medical specialists, book guaranteed conflict-free consultation slots, and track your clinical health journey in one intelligent platform.
            </p>

            <!-- Hero Search Form -->
            <form method="get" asp-controller="Doctors" asp-action="Index" class="hero-search-card text-start mb-3">
                <div class="row g-2 align-items-center p-1">
                    <div class="col-md-8 col-sm-12">
                        <div class="input-icon-group">
                            <i class="bi bi-search"></i>
                            <input type="text" name="SearchTerm" id="heroSearchInput" class="form-control border-0 shadow-none ps-5" placeholder="Search doctor name, specialty, condition..." data-i18n-ph="heroSearchPlaceholder" />
                        </div>
                    </div>
                    <div class="col-md-4 col-sm-12">
                        <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                            <i class="bi bi-search-heart"></i> <span data-i18n="heroSearchBtn">Find Doctors</span>
                        </button>
                    </div>
                </div>
            </form>

            <!-- Specialty Quick Selector Pills -->
            <div class="d-flex flex-wrap align-items-center gap-2 pt-1">
                <span class="small text-muted me-1 fw-semibold" data-i18n="popularSpecialties">Popular:</span>
                <a asp-controller="Doctors" asp-action="Index" asp-route-SearchTerm="Cardiology" class="specialty-quick-pill">
                    <i class="bi bi-heart-pulse text-danger"></i> <span data-i18n="specCardiology">Cardiology</span>
                </a>
                <a asp-controller="Doctors" asp-action="Index" asp-route-SearchTerm="Dermatology" class="specialty-quick-pill">
                    <i class="bi bi-bandaid text-warning"></i> <span data-i18n="specDermatology">Dermatology</span>
                </a>
                <a asp-controller="Doctors" asp-action="Index" asp-route-SearchTerm="Pediatrics" class="specialty-quick-pill">
                    <i class="bi bi-balloon text-info"></i> <span data-i18n="specPediatrics">Pediatrics</span>
                </a>
                <a asp-controller="Doctors" asp-action="Index" asp-route-SearchTerm="Orthopedics" class="specialty-quick-pill">
                    <i class="bi bi-person-walking text-primary"></i> <span data-i18n="specOrthopedics">Orthopedics</span>
                </a>
                <a asp-controller="Doctors" asp-action="Index" asp-route-SearchTerm="Internal Medicine" class="specialty-quick-pill">
                    <i class="bi bi-capsule text-success"></i> <span data-i18n="specInternal">Internal Medicine</span>
                </a>
            </div>
        </div>

        <!-- Right Column Hero Illustration -->
        <div class="col-lg-5 text-center d-none d-lg-block">
            <div class="position-relative hero-illustration-wrapper">
                <img src="~/images/hero-clinic.svg" asp-append-version="true" alt="MediCare Clinic Healthcare Operating System" class="img-fluid rounded-4 shadow-lg border hero-graphic-img" style="max-height: 380px; width: 100%; object-fit: contain; background: var(--mc-card-bg);" />
                <div class="position-absolute bottom-0 start-0 bg-white p-2 px-3 rounded-3 shadow-sm border m-3 d-flex align-items-center gap-2" style="backdrop-filter: blur(8px);">
                    <i class="bi bi-shield-check text-success fs-5"></i>
                    <div class="text-start">
                        <div class="fw-bold small text-dark" style="font-size: 0.75rem;" data-i18n="badgeAcidSafe">ACID Protected</div>
                        <div class="text-muted" style="font-size: 0.65rem;" data-i18n="badgeSqlEngine">SQL Server Filtered Index</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- =====================================================================
     TRUST STATISTICS RIBBON
     ===================================================================== -->
<div class="trust-stats-ribbon mb-5">
    <div class="row g-4 align-items-center text-center">
        <div class="col-6 col-md-3">
            <div class="trust-stat-item">
                <div class="trust-stat-number text-primary">0</div>
                <div class="trust-stat-label" data-i18n="statDoubleBooking">Double Bookings (SQL Concurrency)</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="trust-stat-item">
                <div class="trust-stat-number text-success">100%</div>
                <div class="trust-stat-label" data-i18n="statVerified">Admin-Verified Clinicians</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="trust-stat-item">
                <div class="trust-stat-number text-info">&lt; 30s</div>
                <div class="trust-stat-label" data-i18n="statFastBooking">Instant Slot Reservation</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="trust-stat-item">
                <div class="trust-stat-number text-warning">Real-Time</div>
                <div class="trust-stat-label" data-i18n="statSignalR">SignalR Live Synchronization</div>
            </div>
        </div>
    </div>
</div>

<!-- =====================================================================
     ENGINEERING EXCELLENCE SECTION
     ===================================================================== -->
<div class="mb-5">
    <div class="text-center mb-4">
        <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill fw-bold text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.05em;" data-i18n="engBadge">Engineering Excellence</span>
        <h2 class="fw-bold mt-2" data-i18n="whyChooseTitle">Why Healthcare Providers Choose MediCare</h2>
        <p class="text-muted col-md-6 mx-auto" data-i18n="whyChooseSubtitle">Engineered from the ground up for medical data reliability, precision scheduling, and seamless doctor-patient interactions.</p>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card h-100 p-4 border-0 card-hover-elevate shadow-sm">
                <div class="feature-icon-box bg-primary-subtle text-primary">
                    <i class="bi bi-shield-check"></i>
                </div>
                <h4 class="fw-bold mb-2" data-i18n="feat1Title">Zero Double-Booking</h4>
                <p class="text-secondary small mb-3" data-i18n="feat1Desc">
                    Enforced at the database engine level via SQL Server filtered concurrency indexes. Overlapping bookings are mathematically prevented even under high concurrency.
                </p>
                <div class="mt-auto pt-2">
                    <span class="badge bg-light text-dark border">
                        <i class="bi bi-database-check me-1 text-primary"></i> <span data-i18n="feat1Tag">ACID Atomic Transactions</span>
                    </span>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 p-4 border-0 card-hover-elevate shadow-sm">
                <div class="feature-icon-box bg-success-subtle text-success">
                    <i class="bi bi-person-badge"></i>
                </div>
                <h4 class="fw-bold mb-2" data-i18n="feat2Title">Verified Specialists</h4>
                <p class="text-secondary small mb-3" data-i18n="feat2Desc">
                    Every physician undergoes clinical license validation before listing. View verified credentials, transparent consultation fees, and recurring shift schedules.
                </p>
                <div class="mt-auto pt-2">
                    <a asp-controller="Doctors" asp-action="Index" class="fw-bold text-success text-decoration-none small">
                        <span data-i18n="feat2Link">Explore Directory</span> <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 p-4 border-0 card-hover-elevate shadow-sm">
                <div class="feature-icon-box bg-info-subtle text-info">
                    <i class="bi bi-file-earmark-medical"></i>
                </div>
                <h4 class="fw-bold mb-2" data-i18n="feat3Title">Digital Health Passport</h4>
                <p class="text-secondary small mb-3" data-i18n="feat3Desc">
                    Automated clinical documentation upon encounter completion: diagnoses, physical symptoms, doctor notes, and printable digital prescriptions with dosage guidelines.
                </p>
                <div class="mt-auto pt-2">
                    <span class="badge bg-light text-dark border">
                        <i class="bi bi-printer me-1 text-info"></i> <span data-i18n="feat3Tag">Printable Rx Ready</span>
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- =====================================================================
     HOW IT WORKS SECTION
     ===================================================================== -->
<div class="card bg-white p-4 p-md-5 border-0 shadow-sm mb-5">
    <div class="row align-items-center g-4">
        <div class="col-lg-4 text-center text-lg-start">
            <span class="badge bg-secondary-subtle text-secondary px-3 py-1 rounded-pill fw-semibold small" data-i18n="howBadge">Quick Walkthrough</span>
            <h3 class="fw-bold mt-2" data-i18n="howTitle">Effortless Care in 3 Simple Steps</h3>
            <p class="text-muted small" data-i18n="howSubtitle">Designed to remove friction for both patients and clinicians, ensuring rapid consultations and continuous care.</p>
        </div>
        <div class="col-lg-8">
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="d-flex align-items-start gap-3">
                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold flex-shrink-0" style="width: 38px; height: 38px;">1</div>
                        <div>
                            <h6 class="fw-bold mb-1" data-i18n="step1Title">Find Specialist</h6>
                            <p class="text-muted small mb-0" data-i18n="step1Desc">Search by department, fee range, or weekly availability day.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="d-flex align-items-start gap-3">
                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold flex-shrink-0" style="width: 38px; height: 38px;">2</div>
                        <div>
                            <h6 class="fw-bold mb-1" data-i18n="step2Title">Reserve Slot</h6>
                            <p class="text-muted small mb-0" data-i18n="step2Desc">Select an open 30-minute interval on the interactive clinic calendar.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="d-flex align-items-start gap-3">
                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold flex-shrink-0" style="width: 38px; height: 38px;">3</div>
                        <div>
                            <h6 class="fw-bold mb-1" data-i18n="step3Title">Consult & Rx</h6>
                            <p class="text-muted small mb-0" data-i18n="step3Desc">Attend visit, receive medical diagnosis and digital prescription.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- =====================================================================
     DUAL CALL-TO-ACTION SECTION
     ===================================================================== -->
<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="card p-4 border-0 h-100 shadow-sm" style="background: linear-gradient(135deg, #EFF6FF 0%, #DBEAFE 100%);">
            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="rounded-circle bg-primary text-white p-3 fs-4 d-inline-flex shadow-sm">
                    <i class="bi bi-person-check-fill"></i>
                </div>
                <div>
                    <h4 class="fw-bold mb-0 text-dark" data-i18n="ctaPatientTitle">Need Medical Care?</h4>
                    <span class="text-secondary small" data-i18n="ctaPatientSub">Access over 20+ specialized clinic doctors</span>
                </div>
            </div>
            <p class="text-secondary small mb-4" data-i18n="ctaPatientDesc">
                Explore our accredited directory, check real-time availability in Cairo time, and book your appointment with zero conflict risk.
            </p>
            <div class="mt-auto">
                <a asp-controller="Doctors" asp-action="Index" class="btn btn-primary">
                    <i class="bi bi-calendar2-plus"></i> <span data-i18n="ctaPatientBtn">Book Consultation Now</span>
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card p-4 border-0 h-100 shadow-sm" style="background: linear-gradient(135deg, #F0FDF4 0%, #DCFCE7 100%);">
            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="rounded-circle bg-success text-white p-3 fs-4 d-inline-flex shadow-sm">
                    <i class="bi bi-hospital-fill"></i>
                </div>
                <div>
                    <h4 class="fw-bold mb-0 text-dark" data-i18n="ctaDoctorTitle">Are You a Physician?</h4>
                    <span class="text-secondary small" data-i18n="ctaDoctorSub">Expand your clinical reach with MediCare</span>
                </div>
            </div>
            <p class="text-secondary small mb-4" data-i18n="ctaDoctorDesc">
                Configure your weekly shifts, review patient appointments, manage attendance, and issue structured e-prescriptions.
            </p>
            <div class="mt-auto">
                @if (User.Identity?.IsAuthenticated != true)
                {
                    <a asp-controller="Account" asp-action="RegisterDoctor" class="btn btn-outline-success bg-white">
                        <i class="bi bi-clipboard2-plus"></i> <span data-i18n="ctaDoctorRegister">Register Doctor Practice</span>
                    </a>
                }
                else if (User.IsInRole("Doctor"))
                {
                    <a asp-controller="Doctor" asp-action="Appointments" class="btn btn-success text-white">
                        <i class="bi bi-clipboard-pulse"></i> <span data-i18n="ctaDoctorPortal">Open Doctor Portal</span>
                    </a>
                }
                else
                {
                    <span class="badge bg-light text-success border p-2" data-i18n="ctaLoggedPatient">Logged in as Patient</span>
                }
            </div>
        </div>
    </div>
</div>
