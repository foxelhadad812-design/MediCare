@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">
        <div class="card p-5 shadow-sm border-danger">
            <h1 class="display-4 text-danger fw-bold">403</h1>
            <h3 class="fw-bold">Access Denied</h3>
            <p class="text-muted mt-2">
                You do not have the required permissions to access this page or administrative action.
            </p>
            <div class="mt-4">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Return to Homepage</a>
                <a asp-controller="Doctors" asp-action="Index" class="btn btn-outline-secondary ms-2">Browse Doctors</a>
            </div>
        </div>
    </div>
</div>
