@model MediCare.Web.ViewModels.DoctorRegisterViewModel
@{
    ViewData["Title"] = "Doctor Registration";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-7">
        <div class="card shadow-sm mt-3">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <h2 class="fw-bold text-primary">Doctor Registration</h2>
                    <p class="text-muted">Register your clinic practice. Doctor profiles undergo administrative verification before activation.</p>
                </div>

                <div class="alert alert-info py-2 small mb-4">
                    <strong>Note:</strong> In accordance with clinic verification policies, new doctor accounts remain in <em>Pending</em> status until medical credentials are confirmed by an administrator.
                </div>

                <form asp-action="RegisterDoctor" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label"></label>
                            <input asp-for="FullName" class="form-control" placeholder="Dr. First Last" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" placeholder="doctor@clinic.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label"></label>
                            <input asp-for="Password" class="form-control" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label"></label>
                            <input asp-for="ConfirmPassword" class="form-control" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="SpecializationId" class="form-label"></label>
                            <select asp-for="SpecializationId" class="form-select">
                                <option value="">-- Select Specialization --</option>
                                @foreach (var spec in Model.AvailableSpecializations)
                                {
                                    <option value="@spec.Id">@spec.Name</option>
                                }
                            </select>
                            <span asp-validation-for="SpecializationId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LicenseNumber" class="form-label"></label>
                            <input asp-for="LicenseNumber" class="form-control" placeholder="e.g. EGY-MED-2022-1234" />
                            <span asp-validation-for="LicenseNumber" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="ConsultationFee" class="form-label"></label>
                            <div class="input-group">
                                <input asp-for="ConsultationFee" class="form-control" type="number" step="10" />
                                <span class="input-group-text">EGP</span>
                            </div>
                            <span asp-validation-for="ConsultationFee" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label"></label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="+201..." />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Bio" class="form-label"></label>
                        <textarea asp-for="Bio" class="form-control" rows="3" placeholder="Brief clinical background, education, and areas of expertise..."></textarea>
                        <span asp-validation-for="Bio" class="text-danger small"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg">Submit Doctor Application</button>
                    </div>

                    <div class="text-center mt-3">
                        <span class="text-muted">Already approved?</span>
                        <a asp-action="Login" class="text-decoration-none fw-semibold">Sign in here</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
