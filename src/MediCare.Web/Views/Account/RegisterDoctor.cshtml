@model MediCare.Web.ViewModels.DoctorRegisterViewModel
@{
    ViewData["Title"] = "Doctor Registration";
}

<div class="row justify-content-center py-4">
    <div class="col-md-8 col-lg-7">
        <div class="card shadow-lg border-0 rounded-4">
            <div class="card-body p-4 p-md-5">
                <div class="text-center mb-4">
                    <div class="brand-icon mx-auto mb-3" style="width: 50px; height: 50px; font-size: 1.5rem;">
                        <i class="bi bi-hospital-fill"></i>
                    </div>
                    <h3 class="fw-bold text-dark mb-1" data-i18n="regDoctorTitle">Doctor Practice Registration</h3>
                    <p class="text-muted small" data-i18n="regDoctorSubtitle">Join MediCare's verified healthcare provider network.</p>
                </div>

                <div class="alert alert-info py-2 small mb-4 border-0 d-flex align-items-center gap-2" style="background-color: #EFF6FF; color: #1E40AF;">
                    <i class="bi bi-shield-check fs-5"></i>
                    <div data-i18n="regDoctorPolicy">
                        <strong>Verification Policy:</strong> In accordance with clinic regulations, new doctor profiles undergo credential review by clinic administration before activation.
                    </div>
                </div>

                <form asp-action="RegisterDoctor" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label small fw-semibold" data-i18n="formDocName">Full Legal Name</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-person"></i></span>
                                <input asp-for="FullName" class="form-control" placeholder="Dr. First Last" data-i18n-ph="phDocName" />
                            </div>
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label small fw-semibold" data-i18n="formClinicEmail">Clinic Email Address</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-envelope"></i></span>
                                <input asp-for="Email" class="form-control" placeholder="doctor@clinic.com" data-i18n-ph="phClinicEmail" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label small fw-semibold" data-i18n="formPassword">Password</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-lock"></i></span>
                                <input asp-for="Password" id="regPassword" class="form-control" type="password" placeholder="••••••••" data-i18n-ph="phPassword" />
                                <button type="button" class="btn btn-outline-secondary btn-toggle-pwd" data-target="regPassword">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label small fw-semibold" data-i18n="formConfirmPassword">Confirm Password</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-shield-lock"></i></span>
                                <input asp-for="ConfirmPassword" id="regConfirmPassword" class="form-control" type="password" placeholder="••••••••" data-i18n-ph="phConfirmPassword" />
                                <button type="button" class="btn btn-outline-secondary btn-toggle-pwd" data-target="regConfirmPassword">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            <div id="pwdMatchStatus" class="small mt-1 d-none"></div>
                        </div>
                    </div>

                    <!-- Password Live Rules & Strength Meter -->
                    <div class="p-3 bg-light rounded-3 border mb-3 pwd-strength-container">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="small fw-semibold text-dark">مستوى أمان كلمة المرور (Security Level):</span>
                            <span class="small fw-bold" id="pwdStrengthLabel" style="color: #64748B;">لم تبدأ الكتابة</span>
                        </div>
                        <div class="pwd-strength-bar">
                            <div class="pwd-strength-fill" id="pwdStrengthFill"></div>
                        </div>
                        
                        <div class="row g-1 mt-2">
                            <div class="col-sm-6">
                                <div class="pwd-rule-item" id="ruleLength">
                                    <i class="bi bi-circle"></i> <span>8 أحرف على الأقل (Min 8 chars)</span>
                                </div>
                                <div class="pwd-rule-item" id="ruleUpper">
                                    <i class="bi bi-circle"></i> <span>حرف كبير واحد (A-Z)</span>
                                </div>
                                <div class="pwd-rule-item" id="ruleLower">
                                    <i class="bi bi-circle"></i> <span>حرف صغير واحد (a-z)</span>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="pwd-rule-item" id="ruleNumber">
                                    <i class="bi bi-circle"></i> <span>رقم واحد على الأقل (0-9)</span>
                                </div>
                                <div class="pwd-rule-item" id="ruleSpecial">
                                    <i class="bi bi-circle"></i> <span>رمز خاص (!@@#$%^&*)</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="SpecializationId" class="form-label small fw-semibold" data-i18n="formDocSpec">Clinical Specialization</label>
                            <select asp-for="SpecializationId" class="form-select">
                                <option value="" data-i18n="optSelectSpecialization">-- Select Specialization --</option>
                                @foreach (var spec in Model.AvailableSpecializations)
                                {
                                    <option value="@spec.Id">@spec.Name</option>
                                }
                            </select>
                            <span asp-validation-for="SpecializationId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LicenseNumber" class="form-label small fw-semibold" data-i18n="formDocLicense">Medical Syndicate License #</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-card-checklist"></i></span>
                                <input asp-for="LicenseNumber" class="form-control" placeholder="e.g. EGY-MED-2022-1234" data-i18n-ph="phDocLicense" />
                            </div>
                            <span asp-validation-for="LicenseNumber" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="ConsultationFee" class="form-label small fw-semibold" data-i18n="formDocFee">Visit Fee (EGP)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-cash"></i></span>
                                <input asp-for="ConsultationFee" class="form-control" type="number" step="10" />
                                <span class="input-group-text" data-i18n="currencyEgp">EGP</span>
                            </div>
                            <span asp-validation-for="ConsultationFee" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label small fw-semibold" data-i18n="formPhone">Phone Number</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-telephone"></i></span>
                                <input asp-for="PhoneNumber" class="form-control" placeholder="+201..." data-i18n-ph="phPhone" />
                            </div>
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Governorate" class="form-label small fw-semibold" data-i18n="formDocGov">Clinic Location / Governorate</label>
                            <select asp-for="Governorate" class="form-select">
                                <option value="Cairo">Cairo (القاهرة)</option>
                                <option value="Giza">Giza (الجيزة)</option>
                                <option value="Alexandria">Alexandria (الإسكندرية)</option>
                                <option value="Dakahlia">Dakahlia (الدقهلية)</option>
                                <option value="Gharbia">Gharbia (الغربية)</option>
                                <option value="Monufia">Monufia (المنوفية)</option>
                                <option value="Beheira">Beheira (البحيرة)</option>
                                <option value="Kafr El Sheikh">Kafr El Sheikh (كفر الشيخ)</option>
                                <option value="Damietta">Damietta (دمياط)</option>
                                <option value="Sharqia">Sharqia (الشرقية)</option>
                                <option value="Port Said">Port Said (بورسعيد)</option>
                                <option value="Ismailia">Ismailia (الإسماعيلية)</option>
                                <option value="Suez">Suez (السويس)</option>
                                <option value="Qalyubia">Qalyubia (القليوبية)</option>
                                <option value="Faiyum">Faiyum (الفيوم)</option>
                                <option value="Beni Suef">Beni Suef (بني سويف)</option>
                                <option value="Minya">Minya (المنيا)</option>
                                <option value="Assiut">Assiut (أسيوط)</option>
                                <option value="Sohag">Sohag (سوهاج)</option>
                                <option value="Qena">Qena (قنا)</option>
                                <option value="Luxor">Luxor (الأقصر)</option>
                                <option value="Aswan">Aswan (أسوان)</option>
                                <option value="Red Sea">Red Sea (البحر الأحمر)</option>
                                <option value="Matrouh">Matrouh (مطروح)</option>
                                <option value="South Sinai">South Sinai (جنوب سيناء)</option>
                                <option value="North Sinai">North Sinai (شمال سيناء)</option>
                                <option value="New Valley">New Valley (الوادي الجديد)</option>
                            </select>
                            <span asp-validation-for="Governorate" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Bio" class="form-label small fw-semibold" data-i18n="formDocBio">Professional Biography</label>
                        <textarea asp-for="Bio" class="form-control" rows="3" placeholder="Brief clinical background, education, fellowships, and areas of expertise..." data-i18n-ph="phDocBio"></textarea>
                        <span asp-validation-for="Bio" class="text-danger small"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg py-2 fw-semibold">
                            <i class="bi bi-send-check"></i> <span data-i18n="btnSubmitDoctorApp">Submit Practice Application</span>
                        </button>
                    </div>

                    <div class="text-center mt-3">
                        <span class="text-muted small" data-i18n="alreadyApproved">Already approved?</span>
                        <a asp-action="Login" class="text-primary fw-semibold small text-decoration-none ms-1" data-i18n="signInHere">Sign in here</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function() {
            const pwdInput = document.getElementById('regPassword');
            const confirmInput = document.getElementById('regConfirmPassword');
            const strengthBar = document.getElementById('pwdStrengthFill');
            const strengthLabel = document.getElementById('pwdStrengthLabel');
            const matchStatus = document.getElementById('pwdMatchStatus');

            const ruleLength = document.getElementById('ruleLength');
            const ruleUpper = document.getElementById('ruleUpper');
            const ruleLower = document.getElementById('ruleLower');
            const ruleNumber = document.getElementById('ruleNumber');
            const ruleSpecial = document.getElementById('ruleSpecial');

            // Show / Hide password toggles
            document.querySelectorAll('.btn-toggle-pwd').forEach(btn => {
                btn.addEventListener('click', function() {
                    const targetId = this.getAttribute('data-target');
                    const input = document.getElementById(targetId);
                    if (!input) return;
                    const isPassword = input.type === 'password';
                    input.type = isPassword ? 'text' : 'password';
                    const icon = this.querySelector('i');
                    if (icon) {
                        icon.className = isPassword ? 'bi bi-eye-slash' : 'bi bi-eye';
                    }
                });
            });

            function updateRules() {
                const val = pwdInput.value;
                const hasLength = val.length >= 8;
                const hasUpper = /[A-Z]/.test(val);
                const hasLower = /[a-z]/.test(val);
                const hasNumber = /[0-9]/.test(val);
                const hasSpecial = /[^A-Za-z0-9]/.test(val);

                function setRule(el, valid) {
                    if (!el) return;
                    if (valid) {
                        el.className = 'pwd-rule-item valid';
                        el.querySelector('i').className = 'bi bi-check-circle-fill text-success';
                    } else {
                        el.className = 'pwd-rule-item';
                        el.querySelector('i').className = 'bi bi-circle';
                    }
                }

                setRule(ruleLength, hasLength);
                setRule(ruleUpper, hasUpper);
                setRule(ruleLower, hasLower);
                setRule(ruleNumber, hasNumber);
                setRule(ruleSpecial, hasSpecial);

                let score = 0;
                if (hasLength) score++;
                if (hasUpper) score++;
                if (hasLower) score++;
                if (hasNumber) score++;
                if (hasSpecial) score++;

                if (val.length === 0) {
                    strengthBar.style.width = '0%';
                    strengthLabel.textContent = 'لم تبدأ الكتابة';
                    strengthLabel.style.color = '#64748B';
                } else if (score <= 2) {
                    strengthBar.style.width = '25%';
                    strengthBar.style.backgroundColor = '#EF4444';
                    strengthLabel.textContent = 'ضعيفة (Weak)';
                    strengthLabel.style.color = '#EF4444';
                } else if (score === 3) {
                    strengthBar.style.width = '50%';
                    strengthBar.style.backgroundColor = '#F59E0B';
                    strengthLabel.textContent = 'متوسطة (Fair)';
                    strengthLabel.style.color = '#F59E0B';
                } else if (score === 4) {
                    strengthBar.style.width = '75%';
                    strengthBar.style.backgroundColor = '#10B981';
                    strengthLabel.textContent = 'قوية (Strong)';
                    strengthLabel.style.color = '#10B981';
                } else {
                    strengthBar.style.width = '100%';
                    strengthBar.style.backgroundColor = '#0066F5';
                    strengthLabel.textContent = 'ممتازة وقوية جداً (Very Strong)';
                    strengthLabel.style.color = '#0066F5';
                }

                checkMatch();
            }

            function checkMatch() {
                if (!confirmInput || !matchStatus) return;
                const pwd = pwdInput.value;
                const confirm = confirmInput.value;
                if (!confirm) {
                    matchStatus.classList.add('d-none');
                    return;
                }
                matchStatus.classList.remove('d-none');
                if (pwd === confirm) {
                    matchStatus.className = 'small mt-1 text-success fw-semibold';
                    matchStatus.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i> كلمتا المرور متطابقتان (Passwords Match)';
                } else {
                    matchStatus.className = 'small mt-1 text-danger fw-semibold';
                    matchStatus.innerHTML = '<i class="bi bi-x-circle-fill me-1"></i> كلمتا المرور غير متطابقتين (Passwords Do Not Match)';
                }
            }

            if (pwdInput) pwdInput.addEventListener('input', updateRules);
            if (confirmInput) confirmInput.addEventListener('input', checkMatch);
        })();
    </script>
}
