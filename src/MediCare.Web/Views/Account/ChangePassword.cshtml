@model MediCare.Web.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Mandatory Password Change";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-warning bg-opacity-10 border-0 py-4 text-center">
                    <div class="rounded-circle bg-warning text-dark d-inline-flex align-items-center justify-content-center mb-2" style="width: 56px; height: 56px; font-size: 1.5rem;">
                        <i class="bi bi-shield-lock-fill"></i>
                    </div>
                    <h4 class="fw-bold text-dark mb-1">Set Your Private Password</h4>
                    <p class="text-muted small mb-0 px-3">
                        For security compliance, temporary administrator-issued passwords must be replaced before accessing any clinical records or services.
                    </p>
                </div>
                <div class="card-body p-4 p-md-5">
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger small d-flex align-items-center gap-2 mb-4" role="alert">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            <div>@TempData["ErrorMessage"]</div>
                        </div>
                    }

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-4" role="alert"></div>

                    <form asp-action="ChangePassword" method="post" novalidate>
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label asp-for="CurrentPassword" class="form-label small fw-semibold text-secondary"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-key"></i></span>
                                <input asp-for="CurrentPassword" class="form-control border-start-0" placeholder="Enter temporary password" autofocus />
                            </div>
                            <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label small fw-semibold text-secondary"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-lock"></i></span>
                                <input asp-for="NewPassword" class="form-control border-start-0" placeholder="Minimum 8 characters" />
                            </div>
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                            <div class="form-text small text-muted">
                                Must be at least 8 characters with uppercase, lowercase, digit, and symbol.
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label small fw-semibold text-secondary"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-lock-fill"></i></span>
                                <input asp-for="ConfirmPassword" class="form-control border-start-0" placeholder="Re-enter new password" />
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary py-2 fw-semibold shadow-sm">
                                <i class="bi bi-check2-circle me-1"></i> Update Password & Continue
                            </button>
                        </div>
                    </form>

                    <div class="text-center mt-4 pt-3 border-top">
                        <form asp-action="Logout" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-link text-muted small p-0 text-decoration-none">
                                <i class="bi bi-box-arrow-right me-1"></i> Sign out and change later
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
