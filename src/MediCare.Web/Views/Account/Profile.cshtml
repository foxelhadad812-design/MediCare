@model MediCare.Web.ViewModels.PatientProfileViewModel
@{
    ViewData["Title"] = "My Medical Profile";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-9 col-xl-8">
            <div class="card shadow-sm border-0 rounded-4 reveal reveal-scale is-visible">
                <div class="card-header bg-white border-bottom py-3 px-4">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-3">
                            <div class="brand-icon" style="width: 48px; height: 48px; font-size: 1.4rem;">
                                <i class="bi bi-person-badge"></i>
                            </div>
                            <div>
                                <h4 class="mb-0 fw-bold text-dark" data-i18n="profileHeaderTitle">Patient Medical Profile</h4>
                                <p class="text-muted small mb-0" data-i18n="profileHeaderSubtitle">View and update your personal information, emergency contacts, and clinical allergies.</p>
                            </div>
                        </div>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill">
                            <i class="bi bi-shield-check me-1"></i> <span data-i18n="patientAccount">Patient Account</span>
                        </span>
                    </div>
                </div>

                <div class="card-body p-4">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
                            <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                            <div>@TempData["SuccessMessage"]</div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                            <div>@TempData["ErrorMessage"]</div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form asp-action="Profile" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="UserId" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                        <!-- Account Credentials & Identity (Readonly Email) -->
                        <h6 class="text-uppercase text-muted fw-bold small mb-3">
                            <i class="bi bi-person-lines-fill me-1"></i> <span data-i18n="profPersonalInfo">Personal Identity</span>
                        </h6>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="FullName" class="form-label small fw-semibold" data-i18n="formFullName">Full Legal Name</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted"><i class="bi bi-person"></i></span>
                                    <input asp-for="FullName" class="form-control" placeholder="Full Name" data-i18n-ph="phFullName" />
                                </div>
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label small fw-semibold" data-i18n="formRegisteredEmail">Registered Email</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted"><i class="bi bi-envelope"></i></span>
                                    <input asp-for="Email" class="form-control bg-light" readonly />
                                </div>
                                <small class="text-muted" data-i18n="profEmailNotice">Email address is managed by authentication security.</small>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="PhoneNumber" class="form-label small fw-semibold" data-i18n="formPhone">Contact Phone Number</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted"><i class="bi bi-telephone"></i></span>
                                    <input asp-for="PhoneNumber" class="form-control" placeholder="+201..." data-i18n-ph="phPhone" />
                                </div>
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="DateOfBirth" class="form-label small fw-semibold" data-i18n="formDob">Date of Birth</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted"><i class="bi bi-calendar-event"></i></span>
                                    <input asp-for="DateOfBirth" class="form-control" type="date" />
                                </div>
                                <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Gender" class="form-label small fw-semibold" data-i18n="formGender">Gender</label>
                                <select asp-for="Gender" class="form-select">
                                    <option value="Male" data-i18n="optMale">Male</option>
                                    <option value="Female" data-i18n="optFemale">Female</option>
                                </select>
                                <span asp-validation-for="Gender" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="BloodGroup" class="form-label small fw-semibold" data-i18n="formBloodGroup">Blood Group</label>
                                <select asp-for="BloodGroup" class="form-select">
                                    <option value="" data-i18n="optSelectBloodGroup">Unknown / Select</option>
                                    <option value="A+">A+</option>
                                    <option value="A-">A-</option>
                                    <option value="B+">B+</option>
                                    <option value="B-">B-</option>
                                    <option value="AB+">AB+</option>
                                    <option value="AB-">AB-</option>
                                    <option value="O+">O+</option>
                                    <option value="O-">O-</option>
                                </select>
                                <span asp-validation-for="BloodGroup" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="EmergencyContact" class="form-label small fw-semibold" data-i18n="formEmergencyContact">Emergency Contact Phone</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted"><i class="bi bi-heart-pulse"></i></span>
                                    <input asp-for="EmergencyContact" class="form-control" placeholder="Contact number of next of kin or emergency guardian" data-i18n-ph="phEmergencyContact" />
                                </div>
                                <span asp-validation-for="EmergencyContact" class="text-danger small"></span>
                            </div>
                        </div>

                        <hr class="my-4 text-muted" />

                        <!-- Clinical & Medical Safety Profile -->
                        <h6 class="text-uppercase text-danger fw-bold small mb-3">
                            <i class="bi bi-shield-exclamation me-1"></i> <span data-i18n="profSafetyHeading">Clinical Safety & Medical History</span>
                        </h6>
                        <div class="row g-3 mb-4">
                            <div class="col-12">
                                <label asp-for="Allergies" class="form-label small fw-semibold text-danger" data-i18n="formAllergies">Known Drug & Environmental Allergies</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-danger-subtle text-danger"><i class="bi bi-exclamation-octagon"></i></span>
                                    <input asp-for="Allergies" class="form-control" placeholder="e.g. Penicillin, Sulfa drugs, Peanuts, Latex, Aspirin" data-i18n-ph="phAllergies" />
                                </div>
                                <span asp-validation-for="Allergies" class="text-danger small"></span>
                                <small class="text-muted" data-i18n="profAllergiesNotice">This critical safety information is displayed to attending physicians during clinical consultations.</small>
                            </div>
                            <div class="col-12">
                                <label asp-for="MedicalHistory" class="form-label small fw-semibold" data-i18n="formMedicalHistory">Medical History & Chronic Conditions</label>
                                <textarea asp-for="MedicalHistory" class="form-control" rows="3" placeholder="e.g. Type 2 Diabetes, Hypertension, Asthma..." data-i18n-ph="phMedicalHistory"></textarea>
                                <span asp-validation-for="MedicalHistory" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 pt-2">
                            <a asp-controller="Appointments" asp-action="MyAppointments" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i> <span data-i18n="btnBackToAppointments">Back to Appointments</span>
                            </a>
                            <button type="submit" class="btn btn-primary px-4 fw-semibold">
                                <i class="bi bi-check2-circle me-1"></i> <span data-i18n="btnSaveChanges">Save Changes</span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
