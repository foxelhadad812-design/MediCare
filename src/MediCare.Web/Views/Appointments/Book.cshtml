@model MediCare.Services.DTOs.DoctorDetailDto
@{
    ViewData["Title"] = $"Book Appointment - Dr. {Model.FullName}";
    var selectedDate = ViewBag.SelectedDate as string ?? DateTime.Today.ToString("yyyy-MM-dd");
}

<div class="row mb-3">
    <div class="col-12">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index"><i class="bi bi-house-door"></i> Home</a></li>
                <li class="breadcrumb-item"><a asp-controller="Doctors" asp-action="Index" data-i18n="findDoctors">Doctors</a></li>
                <li class="breadcrumb-item"><a asp-controller="Doctors" asp-action="Details" asp-route-id="@Model.Id"><span class="doc-name" data-doc-name-en="@Model.FullName">@Model.FullName</span></a></li>
                <li class="breadcrumb-item active" aria-current="page" data-i18n="docBookSlot">Book Slot</li>
            </ol>
        </nav>
    </div>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert" style="background-color: #FEF2F2; border-left: 4px solid #EF4444 !important; color: #991B1B;">
        <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
        <div class="flex-grow-1">
            <strong>Notice:</strong> @TempData["ErrorMessage"]
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4">
    <!-- Doctor Summary Column -->
    <div class="col-lg-4">
        <div class="card bg-white shadow-sm p-4 h-100 border-0">
            <div class="text-center mb-3">
                @if (!string.IsNullOrEmpty(Model.ProfileImageUrl))
                {
                    <img src="@Model.ProfileImageUrl" alt="@Model.FullName" class="rounded-circle shadow-sm mx-auto mb-3" style="width: 80px; height: 80px; object-fit: cover; border: 3px solid rgba(0, 102, 245, 0.2);" onerror="this.onerror=null; this.src='/images/doctors/doctor-default.svg';" />
                }
                else
                {
                    <div class="doctor-avatar-circle mx-auto mb-3" style="width: 80px; height: 80px; font-size: 2rem;">
                        @(string.IsNullOrEmpty(Model.FullName) ? "Dr" : Model.FullName.Substring(0, 1).ToUpper())
                    </div>
                }
                <h4 class="fw-bold mb-1 text-dark"><span class="doc-name" data-doc-name-en="@Model.FullName">@Model.FullName</span></h4>
                <span class="badge badge-specialty mb-2">
                    <i class="bi bi-heart-pulse-fill text-primary"></i> <span data-i18n-spec="@Model.SpecializationName">@Model.SpecializationName</span>
                </span>
                <div>
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill">
                        <i class="bi bi-patch-check-fill text-success me-1"></i> <span data-i18n="docVerifiedBadge">Verified Physician</span>
                    </span>
                </div>
            </div>

            <hr class="my-3 opacity-25" />

            <div class="mb-3 p-3 bg-light rounded-3 border">
                <div class="d-flex align-items-center gap-3 mb-2">
                    <div class="fs-3 text-primary"><i class="bi bi-cash-stack"></i></div>
                    <div>
                        <span class="text-muted small d-block" data-i18n="docConsultationFee">Consultation Fee</span>
                        @if (Model.AcceptsInsurance)
                        {
                            <span class="fs-4 fw-bold text-success">@Model.DiscountedFee.ToString("N0") EGP</span>
                            <span class="text-muted text-decoration-line-through small ms-1">@Model.ConsultationFee.ToString("N0") EGP</span>
                        }
                        else
                        {
                            <span class="fs-4 fw-bold text-dark">@Model.ConsultationFee.ToString("N0") EGP</span>
                        }
                        <span class="text-muted small"> / visit</span>
                    </div>
                </div>
                @if (Model.AcceptsInsurance)
                {
                    <div class="p-2 bg-emerald-subtle rounded-2 border border-success-subtle text-success small">
                        <i class="bi bi-shield-check me-1"></i> <strong>خصم التأمين والنقابة: @Model.InsuranceDiscountPercentage%</strong>
                    </div>
                }
            </div>

            <div class="mb-3">
                <span class="text-muted small d-block fw-semibold mb-1"><i class="bi bi-clock-history text-primary me-1"></i> <span data-i18n="docDuration">Slot Duration</span></span>
                <span class="fw-medium text-dark">@Model.SlotDurationMinutes <span data-i18n="docMinPerConsult">minutes per consultation</span></span>
            </div>

            <div class="mb-3">
                <span class="text-muted small d-block fw-semibold mb-1"><i class="bi bi-card-checklist text-primary me-1"></i> <span data-i18n="docLicense">Medical License</span></span>
                <span class="font-monospace text-dark bg-light px-2 py-1 rounded border">@Model.LicenseNumber</span>
            </div>

            @if (Model.WorkingHours.Any())
            {
                <div class="mb-3">
                    <span class="text-muted small d-block mb-1 fw-semibold"><i class="bi bi-calendar3-week text-primary me-1"></i> <span data-i18n="docShiftsTitle">Consultation Days:</span></span>
                    <div class="d-flex flex-wrap gap-1">
                        @foreach (var wh in Model.WorkingHours)
                        {
                            <span class="day-pill">@wh.DayName (@wh.FormattedTime)</span>
                        }
                    </div>
                </div>
            }

            <div class="mt-auto pt-3 border-top">
                <div class="alert alert-info py-2 small mb-0 border-0" style="background-color: #EFF6FF; color: #1E40AF;">
                    <i class="bi bi-info-circle-fill me-1"></i> <span data-i18n="bookHowToReserve">How to Reserve: Select any day on the calendar, choose an open time interval below, and confirm your reservation.</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Calendar & Slot Picker Column -->
    <div class="col-lg-8">
        <div class="card bg-white shadow-sm p-4 mb-4 border-0">
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                <h5 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                    <i class="bi bi-calendar2-week text-primary"></i> <span data-i18n="bookSelectDate">Select Consultation Date</span>
                </h5>
                <span class="badge bg-light text-secondary border px-3 py-2 rounded-pill">
                    <i class="bi bi-geo-alt-fill text-danger me-1"></i> <span data-i18n="bookCairoTime">Cairo Time (UTC+2/UTC+3)</span>
                </span>
            </div>
            
            <!-- FullCalendar Container -->
            <div id="bookingCalendar" style="min-height: 400px;"></div>
        </div>

        <!-- Available Slots Panel -->
        <div class="card bg-white shadow-sm p-4 border-0">
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                <div>
                    <h5 class="fw-bold mb-1 text-dark d-flex align-items-center gap-2">
                        <i class="bi bi-clock-history text-primary"></i> <span data-i18n="bookAvailSlots">Available Consultation Slots</span>
                    </h5>
                    <span id="selectedDateDisplay" class="text-muted small" data-i18n="bookSelectDateNotice">Select a date above to display available times.</span>
                </div>
                <div id="slotsSpinner" class="spinner-border spinner-border-sm text-primary d-none" role="status">
                    <span class="visually-hidden">Loading slots...</span>
                </div>
            </div>

            <div id="slotsContainer" class="d-flex flex-wrap gap-2 pt-2">
                <p class="text-muted mb-0"><i class="bi bi-arrow-up-circle me-1"></i> Click on a calendar day to load consultation slots.</p>
            </div>
        </div>
    </div>
</div>

<!-- Booking Confirmation Modal -->
<div class="modal fade" id="bookingModal" tabindex="-1" aria-labelledby="bookingModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <form id="bookingForm" asp-controller="Appointments" asp-action="BookAppointment" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="doctorId" value="@Model.Id" />
                <input type="hidden" id="modalDateInput" name="appointmentDate" value="" />
                <input type="hidden" id="modalTimeInput" name="startTime" value="" />

                <div class="modal-header border-bottom p-4">
                    <h5 class="modal-title fw-bold text-dark d-flex align-items-center gap-2" id="bookingModalLabel">
                        <i class="bi bi-calendar2-check-fill text-primary"></i> Confirm Your Reservation
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="p-3 rounded-3 mb-3 border bg-light">
                        <div class="row g-2">
                            <div class="col-6">
                                <span class="text-muted small d-block" data-i18n="apptAttendingPhysician">Doctor</span>
                                <span class="fw-bold text-dark"><span class="doc-name" data-doc-name-en="@Model.FullName">@Model.FullName</span></span>
                            </div>
                            <div class="col-6">
                                <span class="text-muted small d-block" data-i18n="docSpecLabel">Specialty</span>
                                <span class="badge badge-specialty"><span data-i18n-spec="@Model.SpecializationName">@Model.SpecializationName</span></span>
                            </div>
                            <div class="col-6 mt-2">
                                <span class="text-muted small d-block">Selected Date</span>
                                <span id="modalDateLabel" class="fw-bold text-primary"></span>
                            </div>
                            <div class="col-6 mt-2">
                                <span class="text-muted small d-block">Time Slot</span>
                                <span id="modalTimeLabel" class="fw-bold text-primary"></span>
                            </div>
                            <div class="col-12 mt-2 pt-2 border-top">
                                <span class="text-muted small d-block">Consultation Fee</span>
                                <span class="fw-bold fs-5 text-dark">@Model.ConsultationFee.ToString("N0") EGP</span>
                                <span class="badge bg-secondary-subtle text-secondary ms-1">Payment at Clinic</span>
                            </div>
                        </div>
                    </div>

                    <!-- Healthcare Insurance & Syndicate Discount Selection -->
                    @if (Model.AcceptsInsurance)
                    {
                        <div class="p-3 rounded-4 mb-3 border bg-light">
                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input cursor-pointer" type="checkbox" id="hasInsuranceToggle">
                                <label class="form-check-label fw-bold text-dark cursor-pointer d-flex align-items-center gap-1" for="hasInsuranceToggle">
                                    <i class="bi bi-shield-check text-success fs-5"></i> <span>لدي تأمين طبي أو كارنيه نقابة (خصم @Model.InsuranceDiscountPercentage%)</span>
                                </label>
                            </div>
                            <div id="insuranceDetailsBlock" class="d-none pt-2 border-top mt-2">
                                <div class="row g-2">
                                    <div class="col-sm-7">
                                        <label class="form-label small text-muted mb-1">جهة التأمين أو النقابة المعتمدة</label>
                                        <select id="insuranceProviderSelect" class="form-select form-select-sm">
                                            @foreach (var provider in Model.InsuranceProviders)
                                            {
                                                <option value="@provider">@provider</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-sm-5">
                                        <label class="form-label small text-muted mb-1">رقم الكارنيه / الوثيقة</label>
                                        <input type="text" id="insuranceCardNo" class="form-control form-control-sm" placeholder="مثال: 849201" />
                                    </div>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mt-3 p-2 bg-white rounded border">
                                    <span class="small text-success fw-bold"><i class="bi bi-tag-fill me-1"></i> السعر بعد تطبيق الخصم:</span>
                                    <div>
                                        <span class="fw-bold text-success fs-6">@Model.DiscountedFee.ToString("N0") ج.م</span>
                                        <span class="text-muted text-decoration-line-through small ms-1">@Model.ConsultationFee.ToString("N0") ج.م</span>
                                    </div>
                                </div>
                                <small class="text-muted d-block mt-1" style="font-size: 0.76rem;">* يرجى إبراز الكارنيه الأصلي عند موظف الاستقبال بالعيادة لتطبيق الخصم.</small>
                            </div>
                        </div>
                    }

                    <div class="mb-3">
                        <label for="appointmentTypeSelect" class="form-label fw-semibold">Visit Type</label>
                        <select id="appointmentTypeSelect" name="type" class="form-select">
                            <option value="Consultation" selected>New Consultation</option>
                            <option value="FollowUp">Follow-up Visit</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="patientNotesInput" class="form-label fw-semibold">Symptoms / Medical Notes (Optional)</label>
                        <textarea id="patientNotesInput" name="notes" class="form-control" rows="3" placeholder="Briefly describe symptoms or questions for the doctor..."></textarea>
                    </div>

                    <div id="conflictAlert" class="alert alert-danger py-2 small d-none" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i> <span id="conflictAlertText">This slot is no longer available.</span>
                    </div>

                    @if (!User.Identity?.IsAuthenticated == true || !User.IsInRole("Patient"))
                    {
                        <div class="alert alert-warning py-2 small mb-0 border-0" style="background-color: #FFFBEB; color: #92400E;">
                            <i class="bi bi-shield-lock me-1"></i> You must be logged in as a <strong>Patient</strong> to complete this reservation.
                            <div class="mt-2">
                                <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path" class="btn btn-sm btn-primary">
                                    <i class="bi bi-box-arrow-in-right"></i> Sign In to Continue
                                </a>
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer border-top p-3">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Patient"))
                    {
                        <button type="button" id="confirmBookingBtn" class="btn btn-primary px-4">
                            <i class="bi bi-check2-circle"></i> Confirm Reservation
                        </button>
                    }
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <!-- FullCalendar 6.1 loaded via pinned CDN per technology-stack.md specification -->
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const doctorId = @Model.Id;
            let currentSelectedDate = "@selectedDate";
            let modalInstance = null;

            const calendarEl = document.getElementById('bookingCalendar');
            const slotsContainer = document.getElementById('slotsContainer');
            const selectedDateDisplay = document.getElementById('selectedDateDisplay');
            const slotsSpinner = document.getElementById('slotsSpinner');
            const modalEl = document.getElementById('bookingModal');
            if (modalEl) {
                modalInstance = new bootstrap.Modal(modalEl);
            }

            // Initialize FullCalendar 6.1
            const calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'dayGridMonth',
                initialDate: currentSelectedDate,
                height: 420,
                selectable: true,
                validRange: {
                    start: new Date().toISOString().split('T')[0] // Disable past dates
                },
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth'
                },
                dateClick: function (info) {
                    selectDate(info.dateStr);
                }
            });

            calendar.render();

            // Load initial date slots
            selectDate(currentSelectedDate);

            function selectDate(dateStr) {
                currentSelectedDate = dateStr;
                selectedDateDisplay.textContent = "Available slots for: " + dateStr;
                slotsSpinner.classList.remove('d-none');
                slotsContainer.innerHTML = '';

                fetch(`/api/calendar/slots?doctorId=${doctorId}&date=${dateStr}`)
                    .then(response => response.json())
                    .then(result => {
                        slotsSpinner.classList.add('d-none');
                        if (!result.success || !result.data || result.data.length === 0) {
                            slotsContainer.innerHTML = '<div class="alert alert-light text-muted w-100 mb-0 border"><i class="bi bi-calendar-x me-1"></i> Doctor is currently unavailable or has no open slots on this date.</div>';
                            return;
                        }

                        let html = '';
                        result.data.forEach(slot => {
                            if (slot.isAvailable) {
                                html += `<button type="button" class="btn btn-outline-primary px-3 py-2 slot-btn shadow-sm" 
                                            data-start="${slot.startTime}" 
                                            data-end="${slot.endTime}" 
                                            data-formatted="${slot.formattedTime}">
                                            <i class="bi bi-clock me-1"></i> ${slot.formattedTime}
                                         </button>`;
                            } else {
                                html += `<button type="button" class="btn btn-light text-muted px-3 py-2 disabled border" title="Reserved or Unavailable">
                                            <i class="bi bi-slash-circle me-1"></i> ${slot.formattedTime}
                                         </button>`;
                            }
                        });

                        slotsContainer.innerHTML = html;

                        // Attach click handlers to available slot buttons
                        document.querySelectorAll('.slot-btn').forEach(btn => {
                            btn.addEventListener('click', function () {
                                openBookingModal(
                                    currentSelectedDate,
                                    this.getAttribute('data-start'),
                                    this.getAttribute('data-formatted')
                                );
                            });
                        });
                    })
                    .catch(err => {
                        slotsSpinner.classList.add('d-none');
                        slotsContainer.innerHTML = '<div class="alert alert-danger w-100 mb-0"><i class="bi bi-exclamation-triangle me-1"></i> Failed to load slots. Please try again.</div>';
                    });
            }

            function openBookingModal(dateStr, startTime, formattedTime) {
                if (!modalInstance) return;

                document.getElementById('modalDateInput').value = dateStr;
                document.getElementById('modalTimeInput').value = startTime;
                document.getElementById('modalDateLabel').textContent = dateStr;
                document.getElementById('modalTimeLabel').textContent = formattedTime;
                document.getElementById('conflictAlert').classList.add('d-none');

                modalInstance.show();
            }

            // Insurance Details Block Toggle
            const insuranceToggle = document.getElementById('hasInsuranceToggle');
            const insuranceBlock = document.getElementById('insuranceDetailsBlock');
            if (insuranceToggle && insuranceBlock) {
                insuranceToggle.addEventListener('change', function () {
                    if (this.checked) {
                        insuranceBlock.classList.remove('d-none');
                    } else {
                        insuranceBlock.classList.add('d-none');
                    }
                });
            }

            // Conflict Pre-Check and Submission
            const confirmBtn = document.getElementById('confirmBookingBtn');
            if (confirmBtn) {
                confirmBtn.addEventListener('click', function () {
                    const dateVal = document.getElementById('modalDateInput').value;
                    const timeVal = document.getElementById('modalTimeInput').value;
                    const alertDiv = document.getElementById('conflictAlert');
                    const alertText = document.getElementById('conflictAlertText');

                    // If insurance is checked, prepend insurance info to notes
                    if (insuranceToggle && insuranceToggle.checked) {
                        const prov = document.getElementById('insuranceProviderSelect')?.value || '';
                        const cardNo = document.getElementById('insuranceCardNo')?.value || 'غير مسجل';
                        const notesEl = document.getElementById('patientNotesInput');
                        const insNote = `[تأمين/نقابة: ${prov} | كارنيه: ${cardNo} | خصم @Model.InsuranceDiscountPercentage% | المطلوب سداده: @Model.DiscountedFee.ToString("N0") ج.م]`;
                        notesEl.value = notesEl.value ? `${insNote}\n${notesEl.value}` : insNote;
                    }

                    confirmBtn.disabled = true;
                    confirmBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Validating...';

                    // Pre-check conflict endpoint
                    fetch('/api/appointments/check-conflict', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            doctorId: doctorId,
                            appointmentDate: dateVal,
                            startTime: timeVal
                        })
                    })
                    .then(response => {
                        if (response.status === 409) {
                            return response.json().then(data => {
                                alertText.textContent = data.error || "The selected time slot is already booked. Please choose an alternative time.";
                                alertDiv.classList.remove('d-none');
                                confirmBtn.disabled = false;
                                confirmBtn.innerHTML = '<i class="bi bi-check2-circle"></i> Confirm Reservation';
                                selectDate(dateVal); // Refresh slot buttons
                            });
                        }
                        if (response.ok) {
                            // Slot free: submit main form with anti-forgery token
                            document.getElementById('bookingForm').submit();
                        } else {
                            return response.json().then(data => {
                                alertText.textContent = data.error || "Failed to validate slot availability.";
                                alertDiv.classList.remove('d-none');
                                confirmBtn.disabled = false;
                                confirmBtn.innerHTML = '<i class="bi bi-check2-circle"></i> Confirm Reservation';
                            });
                        }
                    })
                    .catch(err => {
                        alertText.textContent = "Communication error checking slot conflict. Proceeding with reservation...";
                        alertDiv.classList.remove('d-none');
                        confirmBtn.disabled = false;
                        confirmBtn.innerHTML = '<i class="bi bi-check2-circle"></i> Confirm Reservation';
                        document.getElementById('bookingForm').submit();
                    });
                });
            }
        });
    </script>
}
