@model MediCare.Services.DTOs.AppointmentSummaryDto
@{
    ViewData["Title"] = $"Appointment #{Model.Id} Details";
}

<div class="row mb-3">
    <div class="col-12">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index"><i class="bi bi-house-door"></i> Home</a></li>
                @if (User.IsInRole("Doctor"))
                {
                    <li class="breadcrumb-item"><a asp-controller="Doctor" asp-action="Appointments">Appointments Queue</a></li>
                }
                else
                {
                    <li class="breadcrumb-item"><a asp-action="MyAppointments">My Appointments</a></li>
                }
                <li class="breadcrumb-item active" aria-current="page">#@Model.Id</li>
            </ol>
        </nav>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card bg-white shadow-sm p-4 border-0 reveal">
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2 border-bottom pb-3">
                <div>
                    <h3 class="fw-bold mb-1 text-dark d-flex align-items-center gap-2">
                        <i class="bi bi-calendar2-check-fill text-primary"></i> Appointment #@Model.Id
                    </h3>
                    <span class="text-muted small">Scheduled on @Model.FormattedDate</span>
                </div>
                <div>
                    @switch (Model.Status)
                    {
                        case MediCare.Data.Enums.AppointmentStatus.Pending:
                            <span class="status-pill status-pending fs-6 px-3 py-2">
                                <span class="status-dot"></span> Pending Approval
                            </span>
                            break;
                        case MediCare.Data.Enums.AppointmentStatus.Confirmed:
                            <span class="status-pill status-confirmed fs-6 px-3 py-2">
                                <span class="status-dot"></span> Confirmed
                            </span>
                            break;
                        case MediCare.Data.Enums.AppointmentStatus.Completed:
                            <span class="status-pill status-completed fs-6 px-3 py-2">
                                <span class="status-dot"></span> Completed
                            </span>
                            break;
                        case MediCare.Data.Enums.AppointmentStatus.Cancelled:
                            <span class="status-pill status-cancelled fs-6 px-3 py-2">
                                <span class="status-dot"></span> Cancelled
                            </span>
                            break;
                        case MediCare.Data.Enums.AppointmentStatus.Rejected:
                            <span class="status-pill status-rejected fs-6 px-3 py-2">
                                <span class="status-dot"></span> Declined
                            </span>
                            break;
                        case MediCare.Data.Enums.AppointmentStatus.NoShow:
                            <span class="status-pill status-noshow fs-6 px-3 py-2">
                                <span class="status-dot"></span> No-Show
                            </span>
                            break;
                    }
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3 border">
                        <span class="text-muted small d-block mb-1 fw-semibold"><i class="bi bi-person-badge text-primary me-1"></i> <span data-i18n="apptAttendingPhysician">Attending Physician</span></span>
                        <h5 class="fw-bold text-dark mb-1">Dr. @Model.DoctorName</h5>
                        <span class="badge badge-specialty">@Model.SpecializationName</span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3 border">
                        <span class="text-muted small d-block mb-1 fw-semibold"><i class="bi bi-person text-primary me-1"></i> <span data-i18n="apptPatientDetails">Patient Details</span></span>
                        <h5 class="fw-bold text-dark mb-1">@Model.PatientName</h5>
                        @if (!string.IsNullOrEmpty(Model.PatientPhoneNumber))
                        {
                            <span class="text-muted small"><i class="bi bi-telephone me-1"></i> @Model.PatientPhoneNumber</span>
                        }
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3 border">
                        <span class="text-muted small d-block mb-1 fw-semibold"><i class="bi bi-clock-history text-primary me-1"></i> <span data-i18n="apptConsultationTime">Consultation Time</span></span>
                        <div class="fw-bold text-dark fs-5">@Model.FormattedTime</div>
                        <span class="text-muted small">@Model.FormattedDate</span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3 border">
                        <span class="text-muted small d-block mb-1 fw-semibold"><i class="bi bi-cash-stack text-primary me-1"></i> <span data-i18n="apptFeePayment">Consultation Fee & Payment</span></span>
                        <div class="fw-bold text-primary fs-5">$@Model.ConsultationFee.ToString("N0")</div>
                        @if (Model.PaymentStatus == MediCare.Data.Enums.PaymentStatus.Paid)
                        {
                            <div class="mt-2 d-flex align-items-center gap-2 flex-wrap">
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                    <i class="bi bi-check-circle-fill me-1"></i> <span data-i18n="apptPaidOnline">Paid Online</span>
                                </span>
                                <a asp-controller="Payment" asp-action="Receipt" asp-route-appointmentId="@Model.Id" class="btn btn-outline-success btn-sm">
                                    <i class="bi bi-receipt me-1"></i> <span data-i18n="apptViewReceipt">View Receipt</span>
                                </a>
                            </div>
                        }
                        else if (User.IsInRole("Patient") && Model.Status != MediCare.Data.Enums.AppointmentStatus.Cancelled && Model.Status != MediCare.Data.Enums.AppointmentStatus.Rejected)
                        {
                            <div class="mt-2 d-flex align-items-center gap-2 flex-wrap">
                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1">
                                    <i class="bi bi-clock-history me-1"></i> <span data-i18n="apptUnpaid">Unpaid</span>
                                </span>
                                <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#checkoutModal">
                                    <i class="bi bi-credit-card-fill me-1"></i> <span data-i18n="apptPayOnline">Pay Online</span> ($@Model.ConsultationFee.ToString("N0"))
                                </button>
                            </div>
                        }
                        else
                        {
                            <span class="badge bg-secondary-subtle text-secondary">@Model.PaymentStatus (Pay at clinic)</span>
                        }
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.Notes))
            {
                <div class="mb-4">
                    <h6 class="fw-bold text-dark mb-2 d-flex align-items-center gap-1">
                        <i class="bi bi-chat-left-text text-primary"></i> Patient Symptoms / Notes:
                    </h6>
                    <div class="p-3 bg-light rounded-3 border text-secondary">
                        @Model.Notes
                    </div>
                </div>
            }

            <!-- =====================================================================
                 🏥 LIVE CLINIC QUEUE TRACKER WIDGET (SignalR Real-Time Synchronized)
                 ===================================================================== -->
            @if (Model.Status == MediCare.Data.Enums.AppointmentStatus.Confirmed || Model.Status == MediCare.Data.Enums.AppointmentStatus.Pending)
            {
                <div class="mb-4 p-3 p-md-4 rounded-4 shadow-xs border" style="background: linear-gradient(135deg, #F8FAFC 0%, #EFF6FF 100%); border-color: rgba(0, 102, 245, 0.2) !important;">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-primary text-white rounded-pill px-3 py-1 fw-bold" style="font-size: 0.75rem; letter-spacing: 0.05em;">
                                <i class="bi bi-broadcast me-1"></i> LIVE CLINIC QUEUE
                            </span>
                            <span class="small text-muted" data-i18n="queueTrackerNotice">تتبع طابور العيادة الذكي في الوقت الفعلي</span>
                        </div>
                        <div class="small fw-semibold text-primary d-flex align-items-center gap-1">
                            <span class="status-dot" style="background:#0066F5; box-shadow:0 0 8px #0066F5;"></span>
                            <span data-i18n="queueSignalRSync">متزامن مع شاشة الاستقبال</span>
                        </div>
                    </div>

                    <div class="row g-3 text-center mb-3">
                        <div class="col-6 col-md-4">
                            <div class="p-3 bg-white rounded-3 shadow-xs border h-100">
                                <div class="text-muted small fw-semibold mb-1" data-i18n="queueYourTurn">رقم دورك في الكشف</div>
                                <div class="display-6 fw-bold text-primary">#@Model.QueueNumber</div>
                                <div class="text-muted small" style="font-size: 0.72rem;">بحسب جدول اليوم</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-4">
                            <div class="p-3 bg-white rounded-3 shadow-xs border h-100">
                                <div class="text-muted small fw-semibold mb-1" data-i18n="queueNowServing">يجري فحص الحالة</div>
                                <div class="display-6 fw-bold text-success">#@Model.CurrentServingQueueNumber</div>
                                <div class="text-muted small" style="font-size: 0.72rem;">داخل غرفة الكشف</div>
                            </div>
                        </div>
                        <div class="col-12 col-md-4">
                            <div class="p-3 bg-white rounded-3 shadow-xs border h-100 d-flex flex-column justify-content-center">
                                <div class="text-muted small fw-semibold mb-1" data-i18n="queueStatusTitle">حالة الانتظار الحالية</div>
                                @if (Model.QueueNumber == Model.CurrentServingQueueNumber)
                                {
                                    <div class="badge bg-success text-white py-2 px-3 fw-bold fs-6">
                                        <i class="bi bi-bell-fill me-1"></i> حان دورك الآن!
                                    </div>
                                    <div class="small text-success mt-1 fw-semibold">يرجى التوجه لغرفة الكشف</div>
                                }
                                else if (Model.QueueNumber > Model.CurrentServingQueueNumber)
                                {
                                    var remaining = Model.QueueNumber - Model.CurrentServingQueueNumber;
                                    <div class="badge bg-info-subtle text-info-emphasis py-2 px-3 fw-bold fs-6">
                                        متبقي قبلك: @remaining @(remaining == 1 ? "مريض" : "مرضى")
                                    </div>
                                    <div class="small text-muted mt-1">الوقت التقديري: @(remaining * 15) دقيقة</div>
                                }
                                else
                                {
                                    <div class="badge bg-secondary-subtle text-secondary py-2 px-3 fw-bold fs-6">
                                        تم الانتهاء
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    @if (User.IsInRole("Doctor") || User.IsInRole("Admin"))
                    {
                        <div class="d-flex justify-content-end align-items-center flex-wrap gap-2 pt-2 border-top">
                            <form asp-action="CheckIn" asp-route-id="@Model.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-primary fw-semibold d-flex align-items-center gap-1 shadow-xs">
                                    <i class="bi bi-person-check-fill"></i> <span>تسجيل وصول المريض (Check-in)</span>
                                </button>
                            </form>
                            <form asp-action="CallNextQueue" asp-route-id="@Model.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-success fw-bold d-flex align-items-center gap-1 shadow-xs">
                                    <i class="bi bi-megaphone-fill"></i> <span data-i18n="queueCallPatientBtn">استدعاء هذا المريض لغرفة الكشف</span>
                                </button>
                            </form>
                        </div>
                    }
                </div>
            }

            <!-- =====================================================================
                 💬 INSTANT WHATSAPP APPOINTMENT CONFIRMATION & REMINDER LINK
                 ===================================================================== -->
            @{
                var whatsappPhone = Model.PatientPhoneNumber?.Replace("+", "").Replace(" ", "").Replace("-", "") ?? "201000000000";
                var encodedReminder = Uri.EscapeDataString($"مرحباً! تفاصيل حجز موعدك في ميدي كير (MediCare):\nرقم الموعد: #{Model.Id}\nالطبيب: د. {Model.DoctorName} ({Model.SpecializationName})\nالتاريخ: {Model.FormattedDate}\nالوقت: {Model.FormattedTime}\nالمحافظة / المقر: {Model.Governorate}\nرقم الدور في العيادة: #{Model.QueueNumber}\nرابط الحجز: https://localhost:7050/Appointments/Details/{Model.Id}");
                var whatsappUrl = $"https://api.whatsapp.com/send?phone={whatsappPhone}&text={encodedReminder}";
            }
            <div class="mb-4 p-3 bg-light rounded-3 border d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div class="d-flex align-items-center gap-2">
                    <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center" style="width: 38px; height: 38px; font-size: 1.2rem;">
                        <i class="bi bi-whatsapp"></i>
                    </div>
                    <div>
                        <div class="fw-bold text-dark small" data-i18n="waTitle">تأكيد الموعد عبر تطبيق WhatsApp</div>
                        <div class="text-muted small" style="font-size: 0.75rem;" data-i18n="waSubtitle">أرسل أو احفظ تفاصيل الحجز، اسم الطبيب، والميعاد مباشرة على هاتفك بضغطة واحدة</div>
                    </div>
                </div>
                <a href="@whatsappUrl" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-success fw-semibold px-3 py-2 d-flex align-items-center gap-2 shadow-xs">
                    <i class="bi bi-whatsapp"></i> <span data-i18n="waActionBtn">فتح رسالة واتساب المعتمدة</span>
                </a>
            </div>

            <!-- =====================================================================
                 📹 TELEMEDICINE & LIVE VIDEO CONSULTATION (WEBRTC / JITSI MEET)
                 ===================================================================== -->
            <div class="mb-4 p-3 p-md-4 rounded-3 border shadow-xs" style="background: linear-gradient(135deg, #EFF6FF 0%, #F0FDF4 100%); border-color: #BFDBFE !important;">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center shadow-xs" style="width: 44px; height: 44px; font-size: 1.3rem;">
                            <i class="bi bi-camera-video-fill"></i>
                        </div>
                        <div>
                            <div class="fw-bold text-dark fs-6 d-flex align-items-center gap-2">
                                <span>الاستشارة الطبية بالفيديو أونلاين (Telemedicine Video Room)</span>
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 small">مباشر ومجاني</span>
                            </div>
                            <div class="text-muted small">غرفة فيديو مشفرة ومباشرة بين الطبيب والمريض داخل المتصفح بدون تحميل أي برامج خارجية</div>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-primary fw-bold d-flex align-items-center gap-2 shadow-xs" data-bs-toggle="modal" data-bs-target="#telehealthModal">
                            <i class="bi bi-camera-video-fill"></i> <span>بدء مكالمة الفيديو الآن</span>
                        </button>
                        <a href="@Model.TeleconsultationMeetingUrl" target="_blank" rel="noopener noreferrer" class="btn btn-outline-primary fw-semibold btn-sm d-flex align-items-center" title="فتح في نافذة كاملة">
                            <i class="bi bi-box-arrow-up-right"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- =====================================================================
                 📄 DIAGNOSTIC LAB & RADIOLOGY ATTACHMENTS (UPLOAD & PREVIEW)
                 ===================================================================== -->
            <div class="mb-4 p-3 p-md-4 bg-white rounded-3 border shadow-xs">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3 border-bottom pb-2">
                    <div>
                        <h6 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                            <i class="bi bi-file-earmark-medical-fill text-primary"></i> <span data-i18n="medDocHeading">الأشعة والتحاليل والمستندات الطبية المرفقة</span>
                        </h6>
                        <span class="text-muted small" data-i18n="medDocSub">يمكن للمريض والطبيب مشاركة صور التحاليل وتقارير الأشعة السريرية بأمان</span>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.MedicalRecordAttachmentPath))
                {
                    <div class="p-3 rounded-3 mb-3 d-flex justify-content-between align-items-center flex-wrap gap-2" style="background-color: #F8FAFC; border: 1px solid #E2E8F0;">
                        <div class="d-flex align-items-center gap-3">
                            <i class="bi bi-file-earmark-pdf-fill text-danger fs-3"></i>
                            <div>
                                <div class="fw-bold text-dark small">ملف الفحص والتحاليل المرفق</div>
                                <div class="text-muted small" style="font-size: 0.72rem;">@System.IO.Path.GetFileName(Model.MedicalRecordAttachmentPath)</div>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <a href="@Model.MedicalRecordAttachmentPath" target="_blank" class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-eye"></i> معاينة الملف
                            </a>
                            <a href="@Model.MedicalRecordAttachmentPath" download class="btn btn-primary btn-sm">
                                <i class="bi bi-download"></i> تحميل
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-muted small p-3 text-center bg-light rounded-3 mb-3 border border-dashed">
                        <i class="bi bi-cloud-upload text-muted fs-4 d-block mb-1"></i>
                        <span>لم يتم إرفاق ملفات تحاليل أو أشعة لهذا الموعد حتى الآن.</span>
                    </div>
                }

                @if (Model.Status != MediCare.Data.Enums.AppointmentStatus.Cancelled && Model.Status != MediCare.Data.Enums.AppointmentStatus.Rejected)
                {
                    <form asp-action="UploadAttachment" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="d-flex align-items-center gap-2 flex-wrap">
                        @Html.AntiForgeryToken()
                        <div class="flex-grow-1 min-w-0">
                            <input type="file" name="attachment" class="form-control form-control-sm" accept=".pdf,.jpg,.jpeg,.png" required />
                        </div>
                        <button type="submit" class="btn btn-outline-primary btn-sm px-3 fw-semibold">
                            <i class="bi bi-upload me-1"></i> <span data-i18n="medDocUploadBtn">رفع تقرير/أشعة جديدة</span>
                        </button>
                    </form>
                    <div class="text-muted small mt-1" style="font-size: 0.72rem;">الملفات المدعومة: PDF, JPG, PNG بحجم أقصى 10 ميجابايت.</div>
                }
            </div>

            @if (Model.Status == MediCare.Data.Enums.AppointmentStatus.Confirmed)
            {
                <div class="mb-4 p-3 rounded-3 d-flex justify-content-between align-items-center flex-wrap gap-3" style="background: linear-gradient(135deg, rgba(0, 102, 245, 0.08) 0%, rgba(14, 165, 233, 0.08) 100%); border: 1px solid rgba(0, 102, 245, 0.25);">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center flex-shrink-0" style="width: 44px; height: 44px; font-size: 1.25rem;">
                            <i class="bi bi-camera-video-fill"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
                                <span data-i18n="telehealthReadyTitle">Virtual Video Consultation Ready</span>
                                <span class="badge bg-success-subtle text-success border border-success-subtle small py-1 px-2">WebRTC</span>
                            </h6>
                            <span class="text-secondary small" data-i18n="telehealthReadyDesc">Join the encrypted WebRTC consultation room with your doctor/patient.</span>
                        </div>
                    </div>
                    <div>
                        <a asp-action="Telehealth" asp-route-id="@Model.Id" class="btn btn-primary px-3 py-2 fw-semibold shadow-sm d-flex align-items-center gap-2">
                            <i class="bi bi-camera-video-fill"></i> <span data-i18n="joinTelehealthBtn">Join Video Consultation</span>
                        </a>
                    </div>
                </div>
            }

            @if (Model.Status == MediCare.Data.Enums.AppointmentStatus.Completed)
            {
                <div class="mb-4 p-3 bg-primary-subtle border border-primary-subtle rounded-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <h6 class="fw-bold text-primary mb-1 d-flex align-items-center gap-1">
                            <i class="bi bi-check-circle-fill"></i> Clinical Encounter Finalized
                        </h6>
                        <span class="text-secondary small">Medical encounter notes and digital prescription are safely archived.</span>
                    </div>
                    <div class="d-flex gap-2">
                        <a asp-controller="Prescriptions" asp-action="ByAppointment" asp-route-appointmentId="@Model.Id" class="btn btn-primary btn-sm" target="_blank">
                            <i class="bi bi-printer"></i> View / Print Prescription
                        </a>
                    </div>
                </div>
            }

            <div class="d-flex justify-content-between align-items-center pt-3 border-top flex-wrap gap-2">
                @if (User.IsInRole("Doctor"))
                {
                    <a asp-controller="Doctor" asp-action="Appointments" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Back to Queue
                    </a>
                }
                else
                {
                    <a asp-action="MyAppointments" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Back to My Appointments
                    </a>
                }

                <div class="d-flex gap-2">
                    @if (Model.Status == MediCare.Data.Enums.AppointmentStatus.Confirmed)
                    {
                        <a asp-action="Telehealth" asp-route-id="@Model.Id" class="btn btn-primary">
                            <i class="bi bi-camera-video-fill me-1"></i> <span data-i18n="joinTelehealthBtn">Join Video Consultation</span>
                        </a>
                    }
                    @if (Model.CanCancel && (User.IsInRole("Patient") || User.IsInRole("Doctor") || User.IsInRole("Admin")))
                    {
                        <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to cancel this appointment?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-x-circle"></i> Cancel Appointment
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- =====================================================================
     📹 TELEHEALTH VIDEO CALL MODAL (JITSI MEET / WEBRTC)
     ===================================================================== -->
<div class="modal fade" id="telehealthModal" tabindex="-1" aria-labelledby="telehealthModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-dark text-white p-3">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-camera-video-fill text-danger fs-5"></i>
                    <h6 class="modal-title fw-bold mb-0 text-white" id="telehealthModalLabel">
                        غرفة الاستشارة الطبية المباشرة &bull; موعد رقم #@Model.Id مع د. @Model.DoctorName
                    </h6>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <a href="@Model.TeleconsultationMeetingUrl" target="_blank" class="btn btn-sm btn-outline-light">
                        <i class="bi bi-arrows-fullscreen"></i> شاشة كاملة
                    </a>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
            </div>
            <div class="modal-body p-0" style="height: 580px; background-color: #1e1e1e;">
                <iframe src="@Model.TeleconsultationMeetingUrl" 
                        allow="camera; microphone; fullscreen; display-capture; autoplay" 
                        style="width: 100%; height: 100%; border: none;"></iframe>
            </div>
            <div class="modal-footer bg-light py-2 px-3 justify-content-between">
                <span class="small text-muted">
                    <i class="bi bi-shield-lock-fill text-success me-1"></i> الاتصال مشفر ومباشر بتقنية WebRTC End-to-End
                </span>
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">إنهاء ومغادرة الغرفة</button>
            </div>
        </div>
    </div>
</div>

@if (User.IsInRole("Patient") && Model.PaymentStatus != MediCare.Data.Enums.PaymentStatus.Paid)
{
    <!-- =====================================================================
         💳 ONLINE PAYMENT CHECKOUT MODAL
         ===================================================================== -->
    <div class="modal fade" id="checkoutModal" tabindex="-1" aria-labelledby="checkoutModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header bg-light border-bottom p-4">
                    <div>
                        <h5 class="modal-title fw-bold text-dark mb-0" id="checkoutModalLabel">
                            <i class="bi bi-shield-lock-fill text-primary me-1"></i> <span data-i18n="payModalTitle">Secure Online Checkout</span>
                        </h5>
                        <div class="small text-muted">Consultation fee for Appointment #@Model.Id</div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <!-- Interactive Visual Credit Card Mockup -->
                    <div class="credit-card-mockup shadow-lg">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="card-chip"></div>
                            <div class="fs-4 fw-bold text-white opacity-75"><i class="bi bi-credit-card-2-front"></i></div>
                        </div>
                        <div class="fs-5 fw-bold font-monospace tracking-widest mb-3 text-white" id="cardPreviewNumber">
                            •••• •••• •••• ••••
                        </div>
                        <div class="d-flex justify-content-between align-items-end text-white">
                            <div>
                                <div class="text-white-50" style="font-size: 0.65rem; text-transform: uppercase;">Card Holder</div>
                                <div class="fw-semibold text-truncate small" id="cardPreviewName" style="max-width: 180px;">YOUR NAME</div>
                            </div>
                            <div>
                                <div class="text-white-50" style="font-size: 0.65rem; text-transform: uppercase;">Expires</div>
                                <div class="fw-semibold small" id="cardPreviewExpiry">MM/YY</div>
                            </div>
                        </div>
                    </div>

                    <div id="checkoutAlert" class="alert alert-danger py-2 px-3 small d-none mb-3"></div>

                    <!-- Payment Form -->
                    <form id="paymentForm">
                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-dark" data-i18n="payCardholder">Cardholder Full Name</label>
                            <input type="text" id="cardHolderInput" class="form-control" placeholder="e.g. Sarah Connor" required autocomplete="cc-name" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-dark" data-i18n="payCardNumber">Card Number</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white"><i class="bi bi-credit-card text-muted"></i></span>
                                <input type="text" id="cardNumberInput" class="form-control font-monospace" placeholder="4532 0150 0000 0000" maxlength="19" required autocomplete="cc-number" />
                            </div>
                            <div class="form-text small">Any valid test card (e.g. 4532015000000000)</div>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-4">
                                <label class="form-label small fw-semibold text-dark" data-i18n="payExpiry">Month</label>
                                <select id="expiryMonthInput" class="form-select" required autocomplete="cc-exp-month">
                                    <option value="01">01 - Jan</option>
                                    <option value="02">02 - Feb</option>
                                    <option value="03">03 - Mar</option>
                                    <option value="04">04 - Apr</option>
                                    <option value="05">05 - May</option>
                                    <option value="06">06 - Jun</option>
                                    <option value="07">07 - Jul</option>
                                    <option value="08">08 - Aug</option>
                                    <option value="09">09 - Sep</option>
                                    <option value="10">10 - Oct</option>
                                    <option value="11">11 - Nov</option>
                                    <option value="12" selected>12 - Dec</option>
                                </select>
                            </div>
                            <div class="col-4">
                                <label class="form-label small fw-semibold text-dark">Year</label>
                                <select id="expiryYearInput" class="form-select" required autocomplete="cc-exp-year">
                                    <option value="2026">2026</option>
                                    <option value="2027">2027</option>
                                    <option value="2028">2028</option>
                                    <option value="2029" selected>2029</option>
                                    <option value="2030">2030</option>
                                    <option value="2031">2031</option>
                                </select>
                            </div>
                            <div class="col-4">
                                <label class="form-label small fw-semibold text-dark" data-i18n="payCvv">CVV</label>
                                <input type="password" id="cvvInput" class="form-control text-center" placeholder="•••" maxlength="4" required autocomplete="cc-csc" />
                            </div>
                        </div>

                        <!-- Promo Code Section -->
                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-dark">كود الخصم أو العرض الترويجي (Promo Code)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white"><i class="bi bi-tag-fill text-primary"></i></span>
                                <input type="text" id="promoCodeInput" class="form-control text-uppercase font-monospace" placeholder="e.g. DEPI2026 or MEDICARE50" />
                                <button type="button" id="applyPromoBtn" class="btn btn-outline-primary fw-semibold">
                                    تطبيق (Apply)
                                </button>
                            </div>
                            <div id="promoNotice" class="small mt-1 d-none"></div>
                        </div>

                        <div class="p-3 bg-light rounded-3 border mb-3">
                            <div class="d-flex justify-content-between align-items-center small text-muted mb-1">
                                <span>Attending Doctor:</span>
                                <span class="fw-semibold text-dark">Dr. @Model.DoctorName</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center small text-muted mb-1">
                                <span>قيمة الكشف الأصلية:</span>
                                <span class="fw-semibold text-dark">$@Model.ConsultationFee.ToString("N0")</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center small text-success mb-1 d-none" id="discountRow">
                                <span>قيمة الخصم المطبق:</span>
                                <span class="fw-bold" id="discountText">-$0</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                <span class="fw-bold text-dark">Total Amount Due:</span>
                                <span class="fw-bold fs-5 text-primary" id="finalAmountText">$@Model.ConsultationFee.ToString("N0")</span>
                            </div>
                        </div>

                        <button type="submit" id="paySubmitBtn" class="btn btn-primary w-100 py-2 fw-semibold">
                            <i class="bi bi-lock-fill me-1"></i> <span data-i18n="paySubmitBtn">Pay & Confirm Now</span> (<span id="payBtnAmount">$@Model.ConsultationFee.ToString("N0")</span>)
                        </button>
                    </form>
                </div>
                <div class="modal-footer bg-light border-top py-2 px-4 justify-content-center">
                    <span class="text-muted small" style="font-size: 0.75rem;">
                        <i class="bi bi-shield-check text-success me-1"></i> <span data-i18n="paySecureBadge">Encrypted with TLS 1.3 &bull; PCI-DSS Level 1 Compliant Mock Gateway</span>
                    </span>
                </div>
            </div>
        </div>
    </div>

    @section Scripts {
        <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.browser.min.js"></script>
        <script>
            (function () {
                const cardInput = document.getElementById('cardNumberInput');
                const nameInput = document.getElementById('cardHolderInput');
                const monthInput = document.getElementById('expiryMonthInput');
                const yearInput = document.getElementById('expiryYearInput');
                const cvvInput = document.getElementById('cvvInput');
                const previewNumber = document.getElementById('cardPreviewNumber');
                const previewName = document.getElementById('cardPreviewName');
                const previewExpiry = document.getElementById('cardPreviewExpiry');
                const form = document.getElementById('paymentForm');
                const alertBox = document.getElementById('checkoutAlert');
                const submitBtn = document.getElementById('paySubmitBtn');

                // Card number formatting & preview
                if (cardInput) {
                    cardInput.addEventListener('input', function (e) {
                        let value = e.target.value.replace(/\D/g, '').substring(0, 16);
                        let formatted = value.match(/.{1,4}/g)?.join(' ') || value;
                        e.target.value = formatted;
                        previewNumber.textContent = formatted || '•••• •••• •••• ••••';
                    });
                }

                // Name preview
                if (nameInput) {
                    nameInput.addEventListener('input', function (e) {
                        previewName.textContent = e.target.value.toUpperCase() || 'YOUR NAME';
                    });
                }

                // Expiry preview
                function updateExpiry() {
                    const m = monthInput.value;
                    const y = yearInput.value.substring(2);
                    previewExpiry.textContent = `${m}/${y}`;
                }
                if (monthInput && yearInput) {
                    monthInput.addEventListener('change', updateExpiry);
                    yearInput.addEventListener('change', updateExpiry);
                    updateExpiry();
                }

                const promoInput = document.getElementById('promoCodeInput');
                const applyPromoBtn = document.getElementById('applyPromoBtn');
                const promoNotice = document.getElementById('promoNotice');
                const discountRow = document.getElementById('discountRow');
                const discountText = document.getElementById('discountText');
                const finalAmountText = document.getElementById('finalAmountText');
                const payBtnAmount = document.getElementById('payBtnAmount');

                let appliedPromoCode = null;

                if (applyPromoBtn && promoInput) {
                    applyPromoBtn.addEventListener('click', async function () {
                        const code = promoInput.value.trim();
                        if (!code) {
                            promoNotice.className = 'small text-danger mt-1';
                            promoNotice.textContent = 'يرجى كتابة كود الخصم أولاً.';
                            promoNotice.classList.remove('d-none');
                            return;
                        }

                        applyPromoBtn.disabled = true;
                        applyPromoBtn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';

                        try {
                            const res = await fetch('/api/payment/validate-promo', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ code: code, amount: @Model.ConsultationFee })
                            });
                            const data = await res.json();

                            if (data.success && data.data && data.data.isValid) {
                                appliedPromoCode = data.data.code;
                                discountRow.classList.remove('d-none');
                                discountText.textContent = `-$${data.data.discountAmount}`;
                                finalAmountText.textContent = `$${data.data.finalAmount}`;
                                if (payBtnAmount) payBtnAmount.textContent = `$${data.data.finalAmount}`;

                                promoNotice.className = 'small text-success mt-1 fw-semibold';
                                promoNotice.innerHTML = `<i class="bi bi-check-circle-fill me-1"></i> ${data.data.description}`;
                                promoNotice.classList.remove('d-none');
                            } else {
                                appliedPromoCode = null;
                                discountRow.classList.add('d-none');
                                finalAmountText.textContent = `$@Model.ConsultationFee.ToString("N0")`;
                                if (payBtnAmount) payBtnAmount.textContent = `$@Model.ConsultationFee.ToString("N0")`;

                                promoNotice.className = 'small text-danger mt-1';
                                promoNotice.textContent = data.error || 'كود الخصم غير صالح أو منتهي الصلاحية.';
                                promoNotice.classList.remove('d-none');
                            }
                        } catch (err) {
                            promoNotice.className = 'small text-danger mt-1';
                            promoNotice.textContent = 'فشل الاتصال بخادم التحقق من الكوبون.';
                            promoNotice.classList.remove('d-none');
                        } finally {
                            applyPromoBtn.disabled = false;
                            applyPromoBtn.textContent = 'تطبيق (Apply)';
                        }
                    });
                }

                // Form submit
                if (form) {
                    form.addEventListener('submit', async function (e) {
                        e.preventDefault();
                        alertBox.classList.add('d-none');
                        submitBtn.disabled = true;
                        submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Processing payment...';

                        const payload = {
                            appointmentId: @Model.Id,
                            cardNumber: cardInput.value.replace(/\s+/g, ''),
                            cardHolderName: nameInput.value.trim(),
                            expiryMonth: monthInput.value,
                            expiryYear: yearInput.value,
                            cvv: cvvInput.value.trim(),
                            paymentMethod: 'CreditCard',
                            promoCode: appliedPromoCode
                        };

                        try {
                            const res = await fetch('/api/payment/checkout', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json'
                                },
                                body: JSON.stringify(payload)
                            });

                            const data = await res.json();

                            if (data.success && data.receipt) {
                                if (window.confetti) {
                                    confetti({
                                        particleCount: 120,
                                        spread: 80,
                                        origin: { y: 0.6 }
                                    });
                                }
                                submitBtn.className = 'btn btn-success w-100 py-2 fw-semibold';
                                submitBtn.innerHTML = '<i class="bi bi-check-circle me-1"></i> Payment Verified! Redirecting...';
                                setTimeout(() => {
                                    window.location.href = `/Appointments/Receipt/${data.receipt.appointmentId}`;
                                }, 800);
                            } else {
                                alertBox.textContent = data.error || 'Payment failed. Please verify your card details.';
                                alertBox.classList.remove('d-none');
                                submitBtn.disabled = false;
                                submitBtn.innerHTML = '<i class="bi bi-lock-fill me-1"></i> Pay Now';
                            }
                        } catch (err) {
                            alertBox.textContent = 'Network communication failure. Please try again.';
                            alertBox.classList.remove('d-none');
                            submitBtn.disabled = false;
                            submitBtn.innerHTML = '<i class="bi bi-lock-fill me-1"></i> Pay Now';
                        }
                    });
                }
            })();
        </script>
    }
}

