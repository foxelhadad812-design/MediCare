@model ErrorViewModel
@{
    var is404 = Model?.IsNotFound == true || Model?.StatusCode == 404;
    ViewData["Title"] = is404 ? "404 - الصفحة غير موجودة - MediCare" : "Error - MediCare";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow-sm border-0 p-4 p-md-5 rounded-4">
                @if (is404)
                {
                    <div class="mb-4">
                        <div class="d-inline-flex align-items-center justify-content-center bg-warning-subtle text-warning rounded-circle" style="width: 80px; height: 80px;">
                            <i class="bi bi-question-circle-fill fs-1"></i>
                        </div>
                    </div>
                    <h2 class="fw-bold text-dark mb-2">404 - الصفحة غير موجودة</h2>
                    <p class="text-secondary mb-4">
                        عذراً، الصفحة التي تبحث عنها غير موجودة أو ربما تم نقلها. يرجى التحقق من الرابط أو استخدام الروابط أدناه للوصول إلى الخدمات المتاحة.
                    </p>
                    <div class="d-flex justify-content-center gap-2 flex-wrap">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4 py-2 rounded-pill">
                            <i class="bi bi-house-door me-1"></i> العودة للصفحة الرئيسية
                        </a>
                        <a asp-controller="Doctors" asp-action="Index" class="btn btn-outline-primary px-4 py-2 rounded-pill">
                            <i class="bi bi-people me-1"></i> دليل الأطباء
                        </a>
                    </div>
                }
                else
                {
                    <div class="mb-4">
                        <div class="d-inline-flex align-items-center justify-content-center bg-danger-subtle text-danger rounded-circle" style="width: 80px; height: 80px;">
                            <i class="bi bi-exclamation-triangle-fill fs-1"></i>
                        </div>
                    </div>
                    <h2 class="fw-bold text-dark mb-2">عذراً، حدث خطأ غير متوقع</h2>
                    <p class="text-secondary mb-4">
                        واجه النظام صعوبة فنية مؤقتة أثناء معالجة طلبك. تم تسجيل الحالة وإخطار الفريق التقني للعمل عليها فوراً.
                    </p>
                    @if (Model?.ShowRequestId == true)
                    {
                        <div class="alert alert-light border small text-muted mb-4 py-2">
                            <span>رقم التتبع (Reference ID):</span> <code class="text-dark">@Model.RequestId</code>
                        </div>
                    }
                    <div class="d-flex justify-content-center gap-2">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4 py-2 rounded-pill">
                            <i class="bi bi-house-door me-1"></i> العودة للصفحة الرئيسية
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
