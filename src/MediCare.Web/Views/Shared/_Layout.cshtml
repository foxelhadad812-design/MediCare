<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MediCare Clinic System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm mb-4">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <span>MediCare</span>
                    <span class="brand-badge">Clinic Management</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-semibold" asp-controller="Doctors" asp-action="Index">Find Doctors</a>
                        </li>
                        @if (User.IsInRole("Doctor"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Doctor" asp-action="Schedule">My Schedule</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Doctor" asp-action="Leaves">My Leaves</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Doctor" asp-action="Appointments">Appointments</a>
                            </li>
                        }
                        @if (User.IsInRole("Patient"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Appointments" asp-action="MyAppointments">My Appointments</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="MedicalRecords" asp-action="MyHistory">Medical Records</a>
                            </li>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Admin" asp-action="Index">Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Admin" asp-action="Approvals">Doctor Approvals</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Admin" asp-action="Reports">Reports</a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-center">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <!-- Real-Time Notification Bell Dropdown -->
                            <li class="nav-item dropdown me-3 position-relative">
                                <button class="btn btn-light position-relative p-2 rounded-circle border shadow-sm" id="notificationDropdownBtn" data-bs-toggle="dropdown" aria-expanded="false" title="Notifications">
                                    &#128276;
                                    <span id="notificationBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none">
                                        0
                                    </span>
                                </button>
                                <div class="dropdown-menu dropdown-menu-end shadow p-0" aria-labelledby="notificationDropdownBtn" style="min-width: 320px; max-width: 360px;">
                                    <div class="p-2 border-bottom fw-bold d-flex justify-content-between align-items-center bg-light">
                                        <span>&#128276; Notifications</span>
                                        <span id="notificationCountLabel" class="badge bg-primary rounded-pill">0</span>
                                    </div>
                                    <ul class="list-group list-group-flush" id="notificationList" style="max-height: 320px; overflow-y: auto;">
                                        <li class="list-group-item text-center text-muted small py-3">Loading notifications...</li>
                                    </ul>
                                </div>
                            </li>

                            <li class="nav-item me-3">
                                <span class="text-secondary small">Signed in as:</span>
                                <span class="fw-bold text-dark">@User.Identity.Name</span>
                                @if (User.IsInRole("Admin"))
                                {
                                    <span class="badge bg-danger ms-1">Admin</span>
                                }
                                else if (User.IsInRole("Doctor"))
                                {
                                    <span class="badge bg-success ms-1">Doctor</span>
                                }
                                else if (User.IsInRole("Patient"))
                                {
                                    <span class="badge bg-primary ms-1">Patient</span>
                                }
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-secondary btn-sm">Log Out</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item me-2">
                                <a class="btn btn-outline-primary btn-sm" asp-controller="Account" asp-action="Login">Log In</a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="btn btn-primary btn-sm dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Register
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="RegisterPatient">As Patient</a></li>
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="RegisterDoctor">As Doctor</a></li>
                                </ul>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                <strong>Success:</strong> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                <strong>Notice:</strong> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["InfoMessage"] != null)
        {
            <div class="alert alert-info alert-dismissible fade show shadow-sm" role="alert">
                <strong>Information:</strong> @TempData["InfoMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="footer text-muted">
        <div class="container d-flex justify-content-between align-items-center">
            <span>&copy; 2026 <strong>MediCare</strong> — Clinic Management & Appointment System</span>
            <span class="small text-muted">DEPI .NET Full Stack Graduation Project</span>
        </div>
    </footer>

    <!-- Real-Time Floating Toast Container -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1090;" id="realtimeToastContainer"></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <!-- SignalR 8.0 Client per technology-stack.md -->
        <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
        <script>
            (function () {
                const badge = document.getElementById('notificationBadge');
                const list = document.getElementById('notificationList');
                const countLabel = document.getElementById('notificationCountLabel');
                const toastContainer = document.getElementById('realtimeToastContainer');
                let unreadCount = 0;

                function updateBadge(count) {
                    unreadCount = Math.max(0, count);
                    if (countLabel) countLabel.textContent = unreadCount;
                    if (badge) {
                        badge.textContent = unreadCount;
                        if (unreadCount > 0) {
                            badge.classList.remove('d-none');
                        } else {
                            badge.classList.add('d-none');
                        }
                    }
                }

                function showToast(title, message) {
                    if (!toastContainer) return;
                    const toastId = 'toast_' + Date.now();
                    const toastHtml = `
                        <div id="${toastId}" class="toast align-items-center text-bg-primary border-0 shadow mb-2" role="alert" aria-live="assertive" aria-atomic="true">
                            <div class="d-flex">
                                <div class="toast-body">
                                    <strong>${title}</strong><br/>
                                    <span>${message}</span>
                                </div>
                                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                            </div>
                        </div>`;
                    toastContainer.insertAdjacentHTML('beforeend', toastHtml);
                    const toastEl = document.getElementById(toastId);
                    const bsToast = new bootstrap.Toast(toastEl, { delay: 6000 });
                    bsToast.show();
                    toastEl.addEventListener('hidden.bs.toast', () => toastEl.remove());
                }

                function addNotificationItem(item, prepend = false) {
                    if (!list) return;
                    const itemHtml = `
                        <li class="list-group-item p-2 list-group-item-action d-flex justify-content-between align-items-start" id="notif_${item.id}">
                            <div class="me-2">
                                <div class="fw-bold small text-dark">${item.title}</div>
                                <div class="text-secondary small">${item.message}</div>
                            </div>
                            <button class="btn btn-sm btn-link text-decoration-none text-muted p-0 mark-read-btn" data-id="${item.id}" title="Mark as read">&times;</button>
                        </li>`;
                    if (prepend) {
                        list.insertAdjacentHTML('afterbegin', itemHtml);
                    } else {
                        list.insertAdjacentHTML('beforeend', itemHtml);
                    }
                    attachMarkReadHandlers();
                }

                function attachMarkReadHandlers() {
                    document.querySelectorAll('.mark-read-btn').forEach(btn => {
                        btn.onclick = function (e) {
                            e.stopPropagation();
                            const id = this.getAttribute('data-id');
                            fetch(`/api/notifications/mark-read/${id}`, { method: 'POST' })
                                .then(res => res.json())
                                .then(data => {
                                    if (data.success) {
                                        const li = document.getElementById('notif_' + id);
                                        if (li) li.remove();
                                        updateBadge(unreadCount - 1);
                                        if (list.children.length === 0) {
                                            list.innerHTML = '<li class="list-group-item text-center text-muted small py-3">No unread notifications.</li>';
                                        }
                                    }
                                });
                        };
                    });
                }

                // Initial load from DB
                fetch('/api/notifications/unread')
                    .then(res => res.json())
                    .then(res => {
                        if (res.success && res.data) {
                            updateBadge(res.data.length);
                            if (res.data.length === 0) {
                                list.innerHTML = '<li class="list-group-item text-center text-muted small py-3">&#128077; All caught up! No unread alerts.</li>';
                            } else {
                                list.innerHTML = '';
                                res.data.forEach(item => addNotificationItem(item, false));
                            }
                        }
                    })
                    .catch(() => {
                        if (list) list.innerHTML = '<li class="list-group-item text-center text-muted small py-2">Unable to load notifications.</li>';
                    });

                // SignalR Connection
                const connection = new signalR.HubConnectionBuilder()
                    .withUrl("/hubs/appointment")
                    .withAutomaticReconnect()
                    .build();

                connection.on("ReceiveNotification", function (notification) {
                    showToast(notification.title, notification.message);
                    updateBadge(unreadCount + 1);
                    if (list.querySelector('.text-muted.py-3')) {
                        list.innerHTML = '';
                    }
                    addNotificationItem(notification, true);
                });

                connection.on("AppointmentStatusChanged", function (appointmentId, status) {
                    showToast("Appointment Status Updated", `Appointment #${appointmentId} is now ${status}.`);
                });

                connection.start().catch(err => console.error("SignalR Connection Error: ", err));
            })();
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
