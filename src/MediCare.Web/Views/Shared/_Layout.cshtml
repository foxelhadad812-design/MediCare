    </footer>

    <!-- Real-Time Floating Toast Container -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1090;" id="realtimeToastContainer"></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <!-- SignalR 8.0 Client per technology-stack.md -->
        <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
        <script>
            (function () {
                const badge = document.getElementById('notificationBadge');
                const list = document.getElementById('notificationList');
                const countLabel = document.getElementById('notificationCountLabel');
                const toastContainer = document.getElementById('realtimeToastContainer');
                let unreadCount = 0;

                function updateBadge(count) {
                    unreadCount = Math.max(0, count);
                    if (countLabel) countLabel.textContent = unreadCount + ' unread';
                    if (badge) {
                        badge.textContent = unreadCount;
                        if (unreadCount > 0) {
                            badge.classList.remove('d-none');
                        } else {
                            badge.classList.add('d-none');
                        }
                    }
                }

                function showToast(title, message) {
                    if (!toastContainer) return;
                    const toastId = 'toast_' + Date.now();
                    const toastHtml = `
                        <div id="${toastId}" class="toast align-items-center text-bg-primary border-0 shadow-lg mb-2 rounded-3" role="alert" aria-live="assertive" aria-atomic="true">
                            <div class="d-flex">
                                <div class="toast-body p-3">
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <i class="bi bi-bell-fill"></i>
                                        <strong class="fs-6">${title}</strong>
                                    </div>
                                    <div class="small opacity-90">${message}</div>
                                </div>
                                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                            </div>
                        </div>`;
                    toastContainer.insertAdjacentHTML('beforeend', toastHtml);
                    const toastEl = document.getElementById(toastId);
                    const bsToast = new bootstrap.Toast(toastEl, { delay: 6000 });
                    bsToast.show();
                    toastEl.addEventListener('hidden.bs.toast', () => toastEl.remove());
                }

                function addNotificationItem(item, prepend = false) {
                    if (!list) return;
                    const itemHtml = `
                        <li class="list-group-item p-3 list-group-item-action d-flex justify-content-between align-items-start border-bottom" id="notif_${item.id}">
                            <div class="me-2">
                                <div class="fw-bold small text-dark d-flex align-items-center gap-1">
                                    <i class="bi bi-info-circle text-primary"></i> ${item.title}
                                </div>
                                <div class="text-secondary small mt-1">${item.message}</div>
                            </div>
                            <button class="btn btn-sm btn-link text-decoration-none text-muted p-0 mark-read-btn" data-id="${item.id}" title="Mark as read">
                                <i class="bi bi-x-circle fs-6"></i>
                            </button>
                        </li>`;
                    if (prepend) {
                        list.insertAdjacentHTML('afterbegin', itemHtml);
                    } else {
                        list.insertAdjacentHTML('beforeend', itemHtml);
                    }
                    attachMarkReadHandlers();
                }

                function attachMarkReadHandlers() {
                    document.querySelectorAll('.mark-read-btn').forEach(btn => {
                        btn.onclick = function (e) {
                            e.stopPropagation();
                            const id = this.getAttribute('data-id');
                            fetch(`/api/notifications/mark-read/${id}`, { method: 'POST' })
                                .then(res => res.json())
                                .then(data => {
                                    if (data.success) {
                                        const li = document.getElementById('notif_' + id);
                                        if (li) li.remove();
                                        updateBadge(unreadCount - 1);
                                        if (list.children.length === 0) {
                                            list.innerHTML = '<li class="list-group-item text-center text-muted small py-4"><i class="bi bi-check2-all text-success fs-5 d-block mb-1"></i> All caught up! No unread alerts.</li>';
                                        }
                                    }
                                });
                        };
                    });
                }

                // Initial load from DB
                fetch('/api/notifications/unread')
                    .then(res => res.json())
                    .then(res => {
                        if (res.success && res.data) {
                            updateBadge(res.data.length);
                            if (res.data.length === 0) {
                                list.innerHTML = '<li class="list-group-item text-center text-muted small py-4"><i class="bi bi-check2-all text-success fs-5 d-block mb-1"></i> All caught up! No unread alerts.</li>';
                            } else {
                                list.innerHTML = '';
                                res.data.forEach(item => addNotificationItem(item, false));
                            }
                        }
                    })
                    .catch(() => {
                        if (list) list.innerHTML = '<li class="list-group-item text-center text-muted small py-3 text-danger"><i class="bi bi-wifi-off me-1"></i> Unable to load notifications.</li>';
                    });

                // SignalR Connection
                const connection = new signalR.HubConnectionBuilder()
                    .withUrl("/hubs/appointment")
                    .withAutomaticReconnect()
                    .build();

                connection.on("ReceiveNotification", function (notification) {
                    showToast(notification.title, notification.message);
                    updateBadge(unreadCount + 1);
                    if (list.querySelector('.text-muted.py-4') || list.querySelector('.text-muted.py-3')) {
                        list.innerHTML = '';
                    }
                    addNotificationItem(notification, true);
                });

                connection.on("AppointmentStatusChanged", function (appointmentId, status) {
                    showToast("Appointment Status Updated", `Appointment #${appointmentId} is now ${status}.`);
                });

                connection.start().catch(err => console.error("SignalR Connection Error: ", err));
            })();
        </script>
    }

    <!-- =====================================================================
         🤖 FLOATING AI MEDICAL ASSISTANT WIDGET
         ===================================================================== -->
    <div id="aiChatbotContainer">
        <!-- Floating Trigger Button -->
        <button id="chatbotFloatingBtn" class="chatbot-floating-btn" type="button" aria-label="Open AI Medical Assistant" title="Chat with AI Medical Assistant">
            <i class="bi bi-robot fs-4" id="chatBtnIcon"></i>
        </button>

        <!-- Floating Chat Window -->
        <div id="chatbotWindow" class="chatbot-window">
            <!-- Header -->
            <div class="chatbot-header">
                <div class="d-flex align-items-center gap-2">
                    <div class="rounded-circle bg-white text-primary d-flex align-items-center justify-content-center shadow-sm" style="width: 34px; height: 34px;">
                        <i class="bi bi-heart-pulse-fill text-danger fs-6"></i>
                    </div>
                    <div>
                        <div class="fw-bold fs-6 text-white lh-1" data-i18n="chatTitle">MediCare AI Assistant</div>
                        <div class="small text-white-50 mt-1 d-flex align-items-center gap-1" style="font-size: 0.72rem;">
