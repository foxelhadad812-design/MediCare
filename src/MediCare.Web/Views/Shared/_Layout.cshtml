                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div class="brand-icon" style="width: 32px; height: 32px; font-size: 1rem;">
                            <i class="bi bi-heart-pulse-fill"></i>
                        </div>
                        <span class="fw-bold fs-5 text-dark">MediCare</span>
                        <span class="brand-badge" data-i18n="footerHealthcareBadge">Healthcare OS</span>
                    </div>
                    <p class="text-muted small pe-lg-4" data-i18n="footerDesc">
                        Modern enterprise clinic management system engineered for high concurrency, zero double-booking, and end-to-end digital clinical workflows.
                    </p>
                    <div class="d-flex align-items-center gap-2 text-muted small mt-3">
                        <span class="d-inline-block rounded-circle bg-success" style="width: 8px; height: 8px;"></span>
                        <span class="fw-semibold text-dark" data-i18n="footerOperational">All Systems Operational</span>
                        <span class="text-secondary" data-i18n="footerCairoTime">• Egypt Standard Time</span>
                    </div>
                </div>

                <div class="col-lg-2 col-md-6 col-6">
                    <h6 class="footer-heading" data-i18n="footerForPatients">For Patients</h6>
                    <ul class="footer-link-list">
                        <li><a asp-controller="Doctors" asp-action="Index"><i class="bi bi-chevron-right small me-1"></i> <span data-i18n="footerFindDoctors">Find Doctors</span></a></li>
                        <li><a asp-controller="Home" asp-action="Index"><i class="bi bi-chevron-right small me-1"></i> <span data-i18n="footerSpecialties">Specialties</span></a></li>
                        <li><a asp-controller="Appointments" asp-action="MyAppointments"><i class="bi bi-chevron-right small me-1"></i> <span data-i18n="footerMyVisits">My Visits</span></a></li>
                        <li><a asp-controller="MedicalRecords" asp-action="MyHistory"><i class="bi bi-chevron-right small me-1"></i> <span data-i18n="footerDigitalRecords">Digital Records</span></a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6 col-6">
                    <h6 class="footer-heading" data-i18n="footerClinicalPortals">Clinical Portals</h6>
                    <ul class="footer-link-list">
                        <li><a asp-controller="Account" asp-action="RegisterDoctor"><i class="bi bi-chevron-right small me-1"></i> <span data-i18n="footerJoinDoctor">Join as Physician</span></a></li>
                        <li><a asp-controller="Doctor" asp-action="Schedule"><i class="bi bi-chevron-right small me-1"></i> <span data-i18n="footerShiftMgmt">Shift Management</span></a></li>
                        <li><a asp-controller="Doctor" asp-action="Appointments"><i class="bi bi-chevron-right small me-1"></i> <span data-i18n="footerPatientQueue">Patient Queue</span></a></li>
                        <li><a asp-controller="Admin" asp-action="Approvals"><i class="bi bi-chevron-right small me-1"></i> <span data-i18n="footerDoctorLicensing">Doctor Licensing</span></a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
