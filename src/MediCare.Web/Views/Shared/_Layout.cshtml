<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MediCare Clinic System</title>
    <!-- Instant Zero-Flash Theme & Localization Loader -->
    <script>
        (function() {
            var savedTheme = localStorage.getItem('medicare-theme') || 'light';
            document.documentElement.setAttribute('data-bs-theme', savedTheme);
            var savedLang = localStorage.getItem('medicare-lang') || 'en';
            document.documentElement.setAttribute('lang', savedLang);
            document.documentElement.setAttribute('dir', savedLang === 'ar' ? 'rtl' : 'ltr');
        })();
    </script>
    <!-- Google Fonts: Cairo (Arabic) & Inter (English) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons 1.11.3 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Progressive Web App (PWA) Manifest -->
    <meta name="theme-color" content="#0066F5" />
    <link rel="manifest" href="~/manifest.json" />
    <link rel="apple-touch-icon" href="~/images/pwa-icon-192.png" />
    <!-- Custom World-Class Design System -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="mc-header">
        <nav class="navbar navbar-expand-lg mc-navbar">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <div class="brand-icon">
                        <i class="bi bi-heart-pulse-fill"></i>
                    </div>
                    <span>MediCare</span>
                    <span class="brand-badge">Healthcare</span>
                </a>
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <i class="bi bi-list fs-2 text-dark"></i>
                </button>
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door"></i> <span data-i18n="home">Home</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-semibold" asp-controller="Doctors" asp-action="Index">
                                <i class="bi bi-search-heart"></i> <span data-i18n="findDoctors">Find Doctors</span>
                            </a>
                        </li>
                        @if (User.IsInRole("Doctor"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Doctor" asp-action="Schedule">
                                    <i class="bi bi-calendar-range"></i> <span data-i18n="schedule">Schedule</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Doctor" asp-action="Leaves">
                                    <i class="bi bi-calendar-x"></i> <span data-i18n="leaves">Leaves</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Doctor" asp-action="Appointments">
                                    <i class="bi bi-clipboard2-pulse"></i> <span data-i18n="appointments">Appointments</span>
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("Patient"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Appointments" asp-action="MyAppointments">
                                    <i class="bi bi-calendar-check"></i> <span data-i18n="myAppointments">My Appointments</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="MedicalRecords" asp-action="MyHistory">
                                    <i class="bi bi-journal-medical"></i> <span data-i18n="medicalRecords">Medical Records</span>
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Index">
                                    <i class="bi bi-speedometer2"></i> <span data-i18n="dashboard">Dashboard</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Approvals">
                                    <i class="bi bi-person-check"></i> <span data-i18n="approvals">Approvals</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Reports">
                                    <i class="bi bi-bar-chart-line"></i> <span data-i18n="reports">Reports</span>
                                </a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-center gap-2">
                        <!-- Theme Toggle Button -->
                        <li class="nav-item">
                            <button class="btn btn-sm btn-outline-secondary rounded-pill px-2 py-1 d-flex align-items-center gap-1" id="themeToggleBtn" type="button" title="Toggle Dark/Light Mode">
                                <i class="bi bi-moon-stars-fill" id="themeIcon"></i>
                                <span class="d-none d-md-inline small fw-medium" id="themeLabel">Dark</span>
                            </button>
                        </li>

                        <!-- Language Toggle Button -->
                        <li class="nav-item">
                            <button class="btn btn-sm btn-outline-primary rounded-pill px-2 py-1 d-flex align-items-center gap-1" id="langToggleBtn" type="button" title="Toggle Arabic / English">
                                <i class="bi bi-translate"></i>
                                <span class="small fw-bold" id="langLabel">العربية</span>
                            </button>
                        </li>

                        <!-- PWA Install Button -->
                        <li class="nav-item" id="pwaInstallLi" style="display: none;">
                            <button class="btn btn-sm btn-outline-success rounded-pill px-2 py-1 d-flex align-items-center gap-1" id="pwaInstallBtn" type="button" title="Install App">
                                <i class="bi bi-download"></i>
                                <span class="d-none d-md-inline small fw-semibold" data-i18n="installAppBtn">Install App</span>
                            </button>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <!-- Real-Time Notification Bell Dropdown -->
                            <li class="nav-item dropdown position-relative">
                                <button class="notification-bell-btn" id="notificationDropdownBtn" data-bs-toggle="dropdown" aria-expanded="false" title="Real-time Notifications">
                                    <i class="bi bi-bell"></i>
                                    <span id="notificationBadge" class="notification-pulse-badge d-none">
                                        0
                                    </span>
                                </button>
                                <div class="dropdown-menu dropdown-menu-end shadow-lg p-0 border-0 rounded-3 mt-2" aria-labelledby="notificationDropdownBtn" style="min-width: 340px; max-width: 380px;">
                                    <div class="p-3 border-bottom d-flex justify-content-between align-items-center bg-light rounded-top-3">
                                        <div class="fw-bold text-dark d-flex align-items-center gap-2">
                                            <i class="bi bi-bell-fill text-primary"></i> <span data-i18n="notifications">Notifications</span>
                                        </div>
                                        <span id="notificationCountLabel" class="badge bg-primary rounded-pill px-2 py-1">0 unread</span>
                                    </div>
                                    <ul class="list-group list-group-flush" id="notificationList" style="max-height: 320px; overflow-y: auto;">
                                        <li class="list-group-item text-center text-muted small py-4">
                                            <i class="bi bi-arrow-repeat spin me-1"></i> Checking notifications...
                                        </li>
                                    </ul>
                                </div>
                            </li>

                            <!-- User Profile Chip -->
                            <li class="nav-item">
                                <div class="user-chip">
                                    <div class="user-avatar-badge">
                                        @(string.IsNullOrEmpty(User.Identity.Name) ? "U" : User.Identity.Name.Substring(0, 1).ToUpper())
                                    </div>
                                    <div class="d-none d-sm-block text-start">
                                        <div class="fw-bold text-dark lh-1 small">@User.Identity.Name</div>
                                    </div>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <span class="user-role-badge user-role-admin">Admin</span>
                                    }
                                    else if (User.IsInRole("Doctor"))
                                    {
                                        <span class="user-role-badge user-role-doctor">Doctor</span>
                                    }
                                    else if (User.IsInRole("Patient"))
                                    {
                                        <span class="user-role-badge user-role-patient">Patient</span>
                                    }
                                </div>
                            </li>

                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-secondary btn-sm" title="Log out of system">
                                        <i class="bi bi-box-arrow-right"></i> <span class="d-none d-md-inline" data-i18n="logout">Log Out</span>
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-outline-primary btn-sm" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right"></i> <span data-i18n="signIn">Sign In</span>
                                </a>
                            </li>
                            <li class="nav-item dropdown">
                                <button class="btn btn-primary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-plus"></i> <span data-i18n="join">Join MediCare</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3 p-2">
                                    <li>
                                        <a class="dropdown-item py-2 px-3 rounded-2" asp-controller="Account" asp-action="RegisterPatient">
                                            <div class="fw-semibold text-dark"><i class="bi bi-person me-2 text-primary"></i> <span data-i18n="patientAccount">Patient Account</span></div>
                                            <div class="small text-muted ps-4">Book slots & view digital medical records</div>
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider my-1"></li>
                                    <li>
                                        <a class="dropdown-item py-2 px-3 rounded-2" asp-controller="Account" asp-action="RegisterDoctor">
                                            <div class="fw-semibold text-dark"><i class="bi bi-hospital me-2 text-success"></i> <span data-i18n="doctorPractice">Doctor Practice</span></div>
                                            <div class="small text-muted ps-4">Manage schedules & clinical encounters</div>
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container my-4 flex-grow-1">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert" style="background-color: #ECFDF5; border-left: 4px solid #10B981 !important; color: #065F46;">
                <i class="bi bi-check-circle-fill text-success fs-5"></i>
                <div class="flex-grow-1">
                    <strong>Success:</strong> @TempData["SuccessMessage"]
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert" style="background-color: #FEF2F2; border-left: 4px solid #EF4444 !important; color: #991B1B;">
                <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
                <div class="flex-grow-1">
                    <strong>Notice:</strong> @TempData["ErrorMessage"]
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["InfoMessage"] != null)
        {
            <div class="alert alert-info alert-dismissible fade show border-0 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert" style="background-color: #EFF6FF; border-left: 4px solid #0066F5 !important; color: #1E40AF;">
                <i class="bi bi-info-circle-fill text-primary fs-5"></i>
                <div class="flex-grow-1">
                    <strong>Information:</strong> @TempData["InfoMessage"]
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <main role="main">
            @RenderBody()
        </main>
    </div>

