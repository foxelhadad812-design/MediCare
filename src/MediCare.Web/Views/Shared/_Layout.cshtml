            function setLanguage(lang) {
                document.documentElement.setAttribute('lang', lang);
                document.documentElement.setAttribute('dir', lang === 'ar' ? 'rtl' : 'ltr');
                localStorage.setItem('medicare-lang', lang);

                if (langLabel) {
                    langLabel.textContent = lang === 'ar' ? 'English' : 'العربية';
                }

                const currentTheme = document.documentElement.getAttribute('data-bs-theme') || 'light';
                updateThemeUI(currentTheme);

                const dict = translations[lang] || translations.en;
                document.querySelectorAll('[data-i18n]').forEach(el => {
                    const key = el.getAttribute('data-i18n');
                    if (dict[key]) {
                        el.textContent = dict[key];
                    }
                });

                document.querySelectorAll('[data-i18n-ph]').forEach(el => {
                    const key = el.getAttribute('data-i18n-ph');
                    if (dict[key]) {
                        el.setAttribute('placeholder', dict[key]);
                    }
                });

                document.querySelectorAll('[data-i18n-title]').forEach(el => {
                    const key = el.getAttribute('data-i18n-title');
                    if (dict[key]) {
                        el.setAttribute('title', dict[key]);
                    }
                });

                // Update Doctor Names across cards, details, and breadcrumbs
                document.querySelectorAll('[data-doc-name-en]').forEach(el => {
                    const enName = el.getAttribute('data-doc-name-en');
                    if (!enName) return;
                    if (lang === 'ar') {
                        if (doctorNamesAr[enName]) {
                            el.textContent = doctorNamesAr[enName];
                        } else if (enName.startsWith('Dr. ')) {
                            el.textContent = 'د. ' + enName.substring(4);
                        } else {
                            el.textContent = 'د. ' + enName;
                        }
                    } else {
                        el.textContent = enName;
                    }
                });

                // Update Specialties
                document.querySelectorAll('[data-i18n-spec]').forEach(el => {
                    const enSpec = el.getAttribute('data-i18n-spec');
                    if (!enSpec) return;
                    if (lang === 'ar') {
                        el.textContent = specialtiesAr[enSpec] || enSpec;
                    } else {
                        el.textContent = enSpec;
                    }
                });

                const chatInput = document.getElementById('chatInput');
                if (chatInput && dict.chatPlaceholder) {
                    chatInput.setAttribute('placeholder', dict.chatPlaceholder);
                }
                const chatGreeting = document.getElementById('chatGreetingText');
                if (chatGreeting && dict.chatGreeting) {
                    chatGreeting.innerHTML = dict.chatGreeting;
                }

                window.dispatchEvent(new CustomEvent('medicare:langChange', { detail: { lang } }));
            }

            window.getMedicareLang = function() {
                return document.documentElement.getAttribute('lang') || 'en';
            };
            window.setMedicareLanguage = setLanguage;

            const initialLang = localStorage.getItem('medicare-lang') || 'en';
            setLanguage(initialLang);

            if (langToggleBtn) {
                langToggleBtn.addEventListener('click', function () {
                    const currentLang = document.documentElement.getAttribute('lang') || 'en';
                    const nextLang = currentLang === 'ar' ? 'en' : 'ar';
                    setLanguage(nextLang);
                });
            }

            // -------------------------------------------------------------
            // 3. AI Medical Assistant Chatbot Engine
            // -------------------------------------------------------------
            const chatbotFloatingBtn = document.getElementById('chatbotFloatingBtn');
            const chatbotWindow = document.getElementById('chatbotWindow');
            const chatbotCloseBtn = document.getElementById('chatbotCloseBtn');
            const chatbotForm = document.getElementById('chatbotForm');
            const chatInput = document.getElementById('chatInput');
            const chatMessages = document.getElementById('chatMessages');
            const chatChips = document.querySelectorAll('.chat-chip');

            let isChatOpen = false;

            function toggleChat() {
                isChatOpen = !isChatOpen;
                if (isChatOpen) {
                    chatbotWindow.style.display = 'flex';
                    if (chatInput) chatInput.focus();
                } else {
                    chatbotWindow.style.display = 'none';
                }
            }

            if (chatbotFloatingBtn) {
                chatbotFloatingBtn.addEventListener('click', toggleChat);
            }

            if (chatbotCloseBtn) {
                chatbotCloseBtn.addEventListener('click', function () {
                    isChatOpen = false;
                    chatbotWindow.style.display = 'none';
                });
            }

            // Quick suggestion chips
            chatChips.forEach(chip => {
                chip.addEventListener('click', function () {
                    const query = this.getAttribute('data-query');
                    if (query && chatInput) {
                        chatInput.value = query;
                        sendUserMessage(query);
                    }
                });
            });

            let isSubmittingChat = false;

            if (chatbotForm) {
                chatbotForm.addEventListener('submit', function (e) {
                    e.preventDefault();
                    if (isSubmittingChat) return;
                    const text = chatInput.value.trim();
                    if (!text) return;
                    sendUserMessage(text);
                });
            }

            function appendBubble(contentHtml, isUser = false) {
                const bubble = document.createElement('div');
                bubble.className = isUser ? 'chat-bubble chat-bubble-user' : 'chat-bubble chat-bubble-bot';
                bubble.innerHTML = contentHtml;
                chatMessages.appendChild(bubble);
                chatMessages.scrollTop = chatMessages.scrollHeight;
                return bubble;
            }

            // Click listener for dynamic quick reply chips inside chat
            if (chatMessages) {
                chatMessages.addEventListener('click', function (e) {
                    const chip = e.target.closest('.dynamic-chat-chip');
                    if (chip && !isSubmittingChat) {
                        const query = chip.getAttribute('data-query');
                        if (query) {
                            if (chatInput) chatInput.value = query;
                            sendUserMessage(query);
                        }
                    }
                });
            }

            function isClientEmergency(message) {
                if (!message) return false;
                const lower = message.trim().toLowerCase();
                const engKeywords = [
                    "chest pain", "heart attack", "stroke", "paralysis", "loss of consciousness",
                    "unconscious", "passed out", "severe bleeding", "bleeding profusely", "coughing blood",
                    "difficulty breathing", "cannot breathe", "can't breathe", "shortness of breath",
                    "short of breath", "suffocating", "severe convulsion", "seizure", "poisoning",
                    "suicide", "overdose", "anaphylaxis", "faint", "fainting"
                ];
                const arKeywords = [
                    "ألم في الصدر", "الم في الصدر", "وجع في صدري", "وجع في الصدر", "وجع بالصدر", "الم بالصدر",
                    "جلطة", "سكته", "سكتة", "ازمة قلبية", "أزمة قلبية", "ذبحة", "ذبحة صدرية", "شلل", "تنميل نصفي",
                    "نزيف حاد", "نزيف مستمر", "تشنج", "فقدان وعي", "اغماء", "إغماء", "غيبوبة", "ضيق تنفس",
                    "مش قادر اتنفس", "اختناق", "كحة دم", "تسمم", "انتحار"
                ];
                return engKeywords.some(k => lower.includes(k)) || arKeywords.some(k => lower.includes(k));
            }

            function renderEmergencyAlert(isAr, isOffline = false) {
                const headerText = isOffline
                    ? (isAr ? '⚠️ تنبيه طوارئ عاجل (أثناء انقطاع الاتصال)' : '⚠️ CRITICAL EMERGENCY NOTICE (Offline Mode)')
                    : (isAr ? '⚠️ تنبيه طوارئ عاجل' : '⚠️ CRITICAL EMERGENCY NOTICE');
                const bodyText = isAr
                    ? 'الأعراض التي وصفتها (ألم الصدر / صعوبة التنفس / أعراض حادة) قد تشير إلى حالة حرجة تتطلب تدخلاً فورياً. يرجى الاتصال فوراً بالإسعاف (123 في مصر) أو التوجه لأقرب قسم طوارئ بمستشفى دون أي تأخير.'
                    : 'The symptoms described (chest pain, shortness of breath, acute symptoms) may indicate a critical emergency. Please call emergency services (123 in Egypt / 911) or proceed immediately to the nearest Emergency Room without delay.';
                return `
                    <div class="alert alert-danger py-3 px-3 my-2 small border-0 shadow-sm rounded-3" style="background-color: #FEF2F2; color: #991B1B;">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <i class="bi bi-exclamation-octagon-fill fs-5 text-danger"></i>
                            <span class="fs-6 fw-bold">${headerText}</span>
                        </div>
                        <p class="mb-2 fw-semibold" style="line-height: 1.5;">${bodyText}</p>
                        <div class="d-flex gap-2 flex-wrap pt-1">
                            <a href="tel:123" class="btn btn-danger btn-sm fw-bold"><i class="bi bi-telephone-fill me-1"></i> ${isAr ? 'اتصال بالإسعاف (123)' : 'Call Ambulance (123)'}</a>
                        </div>
                    </div>`;
            }

            async function sendUserMessage(text) {
                if (isSubmittingChat) return;
                isSubmittingChat = true;

                appendBubble(escapeHtml(text), true);
                chatInput.value = '';

                const sendBtn = document.getElementById('chatSendBtn');
                const consentCheckbox = document.getElementById('aiConsentCheckbox');
                const isConsentGiven = consentCheckbox ? consentCheckbox.checked : false;

                const currentLang = document.documentElement.getAttribute('lang') || 'en';
                const isAr = currentLang === 'ar';

                // Instant offline detection: if browser has no network connectivity
                if (typeof navigator !== 'undefined' && navigator.onLine === false) {
                    isSubmittingChat = false;
                    if (isClientEmergency(text)) {
                        appendBubble(renderEmergencyAlert(isAr, true), false);
                    } else {
                        const offlineNotice = isAr
                            ? 'انقطع الاتصال بالإنترنت. يرجى التحقق من الشبكة والمحاولة مجدداً.'
                            : 'You are currently offline. Please check your connection and try again.';
                        appendBubble(`<div class="alert alert-warning py-2 px-3 small border-0 shadow-sm"><i class="bi bi-wifi-off me-1 text-danger"></i> <strong>${offlineNotice}</strong><div class="small text-muted mt-1">${isAr ? 'إذا كنت تعاني من أعراض طارئة، اتصل بالإسعاف (123) فوراً.' : 'If experiencing an emergency, call 123 (or 911) immediately.'}</div></div>`, false);
                    }
                    return;
                }

                if (sendBtn) sendBtn.disabled = true;

                // Typing indicator
                const typingBubble = appendBubble('<div class="d-flex align-items-center gap-2"><span class="spinner-grow spinner-grow-sm text-primary" role="status"></span> <span class="small text-muted">MediCare is checking your message...</span></div>', false);

                const abortController = new AbortController();
                const timeoutId = setTimeout(() => abortController.abort(), 20000);

                try {
                    const response = await fetch('/api/chatbot/message', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            message: text,
                            culture: currentLang,
                            consentGiven: isConsentGiven
                        }),
                        signal: abortController.signal
                    });

                    clearTimeout(timeoutId);
                    typingBubble.remove();
                    if (sendBtn) sendBtn.disabled = false;
                    isSubmittingChat = false;

                    if (!response.ok) {
                        if (response.status === 429) {
                            const rateLimitNotice = isAr
                                ? 'تم إرسال عدد كبير من الرسائل في وقت قصير. يرجى الانتظار بضع ثوانٍ قبل المحاولة مجدداً.'
                                : 'Too many messages sent in a short period. Please wait a moment before trying again.';
                            appendBubble(`<div class="text-warning small"><i class="bi bi-clock-history me-1"></i> ${rateLimitNotice}</div>`, false);
                            return;
                        }

                        let errMsg = isAr ? 'تعذر معالجة الطلب في الوقت الحالي.' : 'Unable to analyze request at this moment.';
                        try {
                            const errData = await response.json();
                            if (errData && errData.error) {
                                errMsg = errData.error;
                            }
                        } catch (_) { }

                        appendBubble(`<div class="text-danger small"><i class="bi bi-exclamation-circle me-1"></i> ${escapeHtml(errMsg)}</div>`, false);
                        return;
                    }

                    const res = await response.json();
                    if (res.success && res.data) {
                        renderBotResponse(res.data);
                    } else {
                        const fallbackErr = isAr ? 'تعذر معالجة الطلب في الوقت الحالي.' : 'Unable to analyze request at this moment.';
                        appendBubble(`<div class="text-danger small"><i class="bi bi-exclamation-circle me-1"></i> ${escapeHtml(res.error || fallbackErr)}</div>`, false);
                    }
                } catch (err) {
                    clearTimeout(timeoutId);
                    typingBubble.remove();
                    if (sendBtn) sendBtn.disabled = false;
                    isSubmittingChat = false;

                    if (isClientEmergency(text)) {
                        appendBubble(renderEmergencyAlert(isAr, true), false);
                    } else if (err.name === 'AbortError') {
                        const timeoutNotice = isAr
                            ? 'استغرقت الاستجابة وقتاً أطول من المتوقع. يرجى المحاولة مرة أخرى أو توضيح الأعراض.'
                            : 'The request timed out. Please try again or rephrase your symptoms.';
                        appendBubble(`<div class="text-warning small"><i class="bi bi-hourglass-split me-1"></i> ${timeoutNotice}</div>`, false);
                    } else {
                        const connNotice = isAr
                            ? 'تعذر الاتصال بدليل العيادة. يرجى التحقق من اتصالك بالإنترنت.'
                            : 'Unable to connect to the clinic guide. Please verify server connectivity.';
                        appendBubble(`<div class="alert alert-warning py-2 px-3 small border-0 shadow-sm"><i class="bi bi-wifi-off me-1 text-danger"></i> <strong>${connNotice}</strong><div class="small text-muted mt-1">${isAr ? 'إذا كنت تعاني من أعراض طارئة، اتصل بالإسعاف (123) فوراً.' : 'If experiencing an emergency, call 123 (or 911) immediately.'}</div></div>`, false);
                    }
                }
            }

            function renderBotResponse(data) {
                const isAr = document.documentElement.getAttribute('lang') === 'ar';
                let engineLabel = isAr ? 'وضع تجريبي محلي' : 'Local demo mode';
                let badgeClass = 'text-bg-light border';

                if (data.engineMode === 'openai') {
                    engineLabel = isAr ? 'مساعد AI (OpenAI)' : 'AI Assistant (OpenAI)';
                    badgeClass = 'bg-primary-subtle text-primary border border-primary-subtle';
                } else if (data.engineMode === 'azure_openai') {
                    engineLabel = isAr ? 'مساعد AI (Azure OpenAI)' : 'AI Assistant (Azure OpenAI)';
                    badgeClass = 'bg-info-subtle text-info-emphasis border border-info-subtle';
                } else if (data.engineMode === 'emergency_triage') {
                    engineLabel = isAr ? 'توجيه طوارئ فوري' : 'Immediate Emergency Triage';
                    badgeClass = 'bg-danger-subtle text-danger border border-danger-subtle';
                } else if (data.engineMode === 'unconfigured_local') {
                    engineLabel = isAr ? 'الذكاء الاصطناعي غير مهيأ' : 'AI unconfigured';
                    badgeClass = 'bg-warning-subtle text-warning-emphasis border border-warning-subtle';
                }

                let html = `<div class="d-flex flex-wrap gap-1 mb-2"><span class="badge ${badgeClass}">${engineLabel}</span>`;

                if (data.consentRequired) {
                    const consentMsg = isAr ? 'يلزم تأكيد الموافقة لتشغيل المساعد الخارجي' : 'Consent required for external AI';
                    html += `<span class="badge bg-secondary-subtle text-secondary border">${consentMsg}</span>`;
                }

                if (data.piiDetected) {
                    const piiMsg = isAr ? 'تم حجب المعرفات الشخصية للخصوصية' : 'Personal identifiers redacted';
                    html += `<span class="badge bg-warning-subtle text-warning-emphasis border"><i class="bi bi-shield-lock-fill me-1"></i>${piiMsg}</span>`;
                }
                html += `</div><div>${escapeHtml(data.replyMessage || data.replyText).replace(/\n/g, '<br>')}</div>`;

                const disclaimer = data.disclaimer || (isAr ? 'معلومات إرشادية فقط، وليست تشخيصاً أو بديلاً عن استشارة الطبيب.' : 'For general guidance only. This is not a diagnosis or a substitute for medical advice.');
                html += `<div class="small text-muted mt-2 border-top pt-1" style="font-size: 0.72rem;">${escapeHtml(disclaimer)}</div>`;

                if (data.isEmergency) {
                    html += `
                        <div class="alert alert-danger py-2 px-3 my-2 small fw-bold border-0 shadow-sm" style="background-color: #FEF2F2; color: #991B1B;">
                            <i class="bi bi-exclamation-octagon-fill text-danger me-1"></i> ${escapeHtml(data.emergencyNotice)}
                        </div>`;
                }

                if (data.specialtySuggested) {
                    const dispSpec = isAr ? (specialtiesAr[data.specialtySuggested] || data.specialtySuggested) : data.specialtySuggested;
                    html += `
                        <div class="mt-2 mb-1">
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle py-1 px-2">
                                <i class="bi bi-hospital me-1"></i> ${isAr ? 'التخصص الطبي:' : 'Specialty:'} ${escapeHtml(dispSpec)}
                            </span>
                        </div>`;
                }

                if (data.recommendedDoctors && data.recommendedDoctors.length > 0) {
                    html += `<div class="mt-2 fw-semibold small text-muted">${isAr ? 'الأطباء الاستشاريون المقترحون:' : 'Recommended Specialist Doctors:'}</div>`;
                    data.recommendedDoctors.forEach(doc => {
                        const cleanDocName = (doc.fullName || 'Doctor').replace(/^Dr\.\s*/i, '').trim();
                        const nameParts = cleanDocName.split(/\s+/).filter(Boolean);
                        const initials = nameParts.length >= 2 ? (nameParts[0][0] + nameParts[1][0]).toUpperCase() : cleanDocName.substring(0, 2).toUpperCase();
                        const displayName = isAr ? (doctorNamesAr[doc.fullName] || (doc.fullName.startsWith('Dr. ') ? 'د. ' + doc.fullName.substring(4) : 'د. ' + doc.fullName)) : doc.fullName;
                        const displaySpec = isAr ? (specialtiesAr[doc.specialization] || doc.specialization) : doc.specialization;
                        const feeText = isAr ? `${doc.consultationFee.toFixed(0)} ج.م` : `${doc.consultationFee.toFixed(0)} EGP`;
                        const bookText = isAr ? 'احجز' : 'Book';

                        const avatarMarkup = doc.profileImageUrl
                            ? `<img src="${escapeHtml(doc.profileImageUrl)}" class="rounded-circle shadow-sm" style="width: 38px; height: 38px; object-fit: cover;" onerror="this.outerHTML='<div class=\\'rounded-circle d-flex align-items-center justify-content-center text-white fw-bold bg-primary shadow-sm\\' style=\\'width: 38px; height: 38px; font-size: 0.85rem; flex-shrink: 0;\\'>${escapeHtml(initials)}</div>';" alt="${escapeHtml(displayName)}" />`
                            : `<div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold bg-primary shadow-sm" style="width: 38px; height: 38px; font-size: 0.85rem; flex-shrink: 0;">${escapeHtml(initials)}</div>`;

                        html += `
                            <div class="chat-doctor-card">
                                ${avatarMarkup}
                                <div class="flex-grow-1 min-w-0">
                                    <div class="fw-bold small text-truncate text-dark" data-doc-name-en="${escapeHtml(doc.fullName)}">${escapeHtml(displayName)}</div>
                                    <div class="text-muted small" style="font-size: 0.72rem;"><span data-i18n-spec="${escapeHtml(doc.specialization)}">${escapeHtml(displaySpec)}</span> &bull; ${feeText}</div>
                                </div>
                                <a href="/Appointments/Book/${doc.doctorId}" class="btn btn-primary btn-sm py-1 px-2" style="font-size: 0.75rem;">
                                    ${bookText}
                                </a>
                            </div>`;
                    });
                }

                if (data.quickReplies && data.quickReplies.length > 0) {
                    html += `<div class="d-flex flex-wrap gap-1 mt-2 pt-1">`;
                    data.quickReplies.forEach(qr => {
                        html += `<button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2 dynamic-chat-chip" style="font-size: 0.73rem; border-radius: 12px;" data-query="${escapeHtml(qr)}">${escapeHtml(qr)}</button>`;
                    });
                    html += `</div>`;
                }

                appendBubble(html, false);
            }

            function escapeHtml(string) {
                if (!string) return '';
                return String(string)
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#039;');
            }

            // -------------------------------------------------------------
            // 4. Guest Authentication Interceptor for Doctors & Departments
            // -------------------------------------------------------------
            const authPromptModalEl = document.getElementById('authPromptModal');
            if (authPromptModalEl) {
                function showAuthModal(targetUrl) {
                    const loginBtn = document.getElementById('authPromptLoginBtn');
                    if (loginBtn) {
                        const returnUrl = encodeURIComponent(targetUrl || '/Doctors');
                        loginBtn.setAttribute('href', `/Account/Login?ReturnUrl=${returnUrl}`);
                    }
                    const registerBtn = document.getElementById('authPromptRegisterBtn');
                    if (registerBtn) {
                        const returnUrl = encodeURIComponent(targetUrl || '/Doctors');
                        registerBtn.setAttribute('href', `/Account/RegisterPatient?ReturnUrl=${returnUrl}`);
                    }
                    const bsModal = bootstrap.Modal.getOrCreateInstance(authPromptModalEl);
                    bsModal.show();
                }

                document.addEventListener('click', function (e) {
                    const targetLink = e.target.closest('a');
                    if (targetLink) {
                        const href = targetLink.getAttribute('href') || '';
                        // Intercept links to Doctors directory, booking, department cards, and tagged links
                        if (
                            href.startsWith('/Doctors') ||
                            href.startsWith('/Appointments/Book') ||
                            targetLink.classList.contains('medical-dept-card') ||
                            targetLink.classList.contains('specialty-quick-pill') ||
                            targetLink.classList.contains('require-auth-guest')
                        ) {
                            e.preventDefault();
                            e.stopPropagation();
                            showAuthModal(href);
                            return;
                        }
                    }

                    // Intercept Hero search form button submit
                    const submitBtn = e.target.closest('button[type="submit"]');
                    const searchForm = e.target.closest('form.hero-search-card');
                    if (submitBtn && searchForm) {
                        e.preventDefault();
                        e.stopPropagation();
                        const searchInput = searchForm.querySelector('input[name="SearchTerm"]');
                        const term = searchInput ? encodeURIComponent(searchInput.value.trim()) : '';
                        const targetUrl = term ? `/Doctors?SearchTerm=${term}` : '/Doctors';
                        showAuthModal(targetUrl);
                    }
                }, true);

                // Intercept Enter key submit on Hero search form
                const heroSearchForm = document.querySelector('form.hero-search-card');
                if (heroSearchForm) {
                    heroSearchForm.addEventListener('submit', function (e) {
                        e.preventDefault();
                        e.stopPropagation();
                        const searchInput = heroSearchForm.querySelector('input[name="SearchTerm"]');
                        const term = searchInput ? encodeURIComponent(searchInput.value.trim()) : '';
                        const targetUrl = term ? `/Doctors?SearchTerm=${term}` : '/Doctors';
                        showAuthModal(targetUrl);
                    });
                }
            }
        })();
    </script>

    <!-- =====================================================================
         📱 PWA MOBILE APP INSTALL BANNER & SERVICE WORKER
         ===================================================================== -->
    <div id="pwaInstallBanner" class="position-fixed bottom-0 start-50 translate-middle-x p-3 d-none" style="z-index: 1090; max-width: 480px; width: 95%;">
        <div class="card pwa-banner-card border-0 rounded-4 p-3 d-flex flex-row align-items-center gap-3">
            <div class="brand-icon flex-shrink-0" style="width: 44px; height: 44px; font-size: 1.25rem;">
                <i class="bi bi-heart-pulse-fill"></i>
            </div>
            <div class="flex-grow-1">
                <div class="fw-bold text-dark small" data-i18n="pwaInstallTitle">Install MediCare App</div>
                <div class="text-muted small" style="font-size: 0.75rem;" data-i18n="pwaInstallSubtitle">Fast experience & direct access from your home screen</div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button type="button" id="pwaBannerInstallBtn" class="btn btn-primary btn-sm fw-bold px-3 shadow-xs">
                    <i class="bi bi-download me-1"></i> <span data-i18n="pwaInstallAction">Install</span>
                </button>
                <button type="button" id="pwaDismissBtn" class="btn btn-outline-secondary btn-sm border-0" aria-label="Close">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        </div>
    </div>

    <script>
        // PWA Single Canonical Service Worker Registration & App Install Prompt Engine
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', function () {
                navigator.serviceWorker.register('/sw.js')
                    .then(reg => {
                        reg.addEventListener('updatefound', () => {
                            const newWorker = reg.installing;
                            if (newWorker) {
                                newWorker.addEventListener('statechange', () => {
                                    if (newWorker.state === 'installed' && navigator.serviceWorker.controller) {
                                        console.log('MediCare PWA update available.');
                                    }
                                });
                            }
                        });
                    })
                    .catch(err => console.warn('MediCare PWA Service Worker registration failed:', err));
            });
        }

        (function () {
            let deferredPrompt = null;
            const navLi = document.getElementById('pwaInstallLi');
            const navBtn = document.getElementById('pwaNavInstallBtn');
            const banner = document.getElementById('pwaInstallBanner');
            const bannerBtn = document.getElementById('pwaBannerInstallBtn');
            const dismissBtn = document.getElementById('pwaDismissBtn');

            function triggerPwaInstall() {
                if (!deferredPrompt) return;
                deferredPrompt.prompt();
                deferredPrompt.userChoice.then(({ outcome }) => {
                    if (outcome === 'accepted') {
                        if (navLi) navLi.style.display = 'none';
                        if (banner) banner.classList.add('d-none');
                    }
                    deferredPrompt = null;
                });
            }

            window.addEventListener('beforeinstallprompt', (e) => {
                e.preventDefault();
                deferredPrompt = e;
                if (navLi) {
                    navLi.style.display = 'block';
                }
                if (banner && !sessionStorage.getItem('medicare-pwa-dismissed')) {
                    banner.classList.remove('d-none');
                }
            });

            if (navBtn) {
                navBtn.addEventListener('click', triggerPwaInstall);
            }
            if (bannerBtn) {
                bannerBtn.addEventListener('click', triggerPwaInstall);
            }
            if (dismissBtn) {
                dismissBtn.addEventListener('click', () => {
                    if (banner) banner.classList.add('d-none');
                    sessionStorage.setItem('medicare-pwa-dismissed', 'true');
                });
            }

            window.addEventListener('appinstalled', () => {
                if (navLi) navLi.style.display = 'none';
                if (banner) banner.classList.add('d-none');
                deferredPrompt = null;
            });
        })();
    </script>


    <!-- Back-to-top button -->
    <button id="mc-back-to-top" aria-label="Back to top" title="Back to top">
        <i class="bi bi-chevron-up"></i>
    </button>

    <!-- MediCare Animation System -->
    <script src="~/js/animations.js" asp-append-version="true"></script>

    <!-- Real-time Input Sanitization & Smart Validation for FullName & Phone fields -->
    <script>
        (function () {
            document.addEventListener('input', function (e) {
                if (!e.target || !e.target.name) return;
                const name = e.target.name;
                const form = e.target.closest('form');
                if (!form) return;

                if (name === 'FullName') {
                    const input = e.target;
                    const val = input.value;
                    const hasDigits = /[0-9\u0660-\u0669\u06F0-\u06F9]/.test(val);
                    const feedback = form.querySelector('span[data-valmsg-for="FullName"]');
                    if (hasDigits) {
                        input.classList.add('is-invalid');
                        if (feedback) {
                            feedback.classList.remove('field-validation-valid');
                            feedback.classList.add('field-validation-error');
                            const isAr = (window.getMedicareLang && window.getMedicareLang() === 'ar') || document.documentElement.getAttribute('lang') === 'ar';
                            feedback.textContent = isAr 
                                ? 'الاسم يجب أن يحتوي على حروف فقط وبدون أرقام' 
                                : 'Full Name must contain only letters and cannot contain numbers.';
                        }
                    } else if (input.classList.contains('is-invalid') && !hasDigits) {
                        input.classList.remove('is-invalid');
                        if (feedback && (feedback.textContent.includes('أرقام') || feedback.textContent.includes('numbers'))) {
                            feedback.textContent = '';
                        }
                    }
                } else if (name === 'PhoneNumber' || name === 'EmergencyContact') {
                    const input = e.target;
                    const val = input.value;
                    const hasLetters = /[a-zA-Z\u0621-\u064A\u0671-\u06D3]/.test(val);
                    const feedback = form.querySelector('span[data-valmsg-for="' + name + '"]');
                    if (hasLetters) {
                        input.classList.add('is-invalid');
                        if (feedback) {
                            feedback.classList.remove('field-validation-valid');
                            feedback.classList.add('field-validation-error');
                            const isAr = (window.getMedicareLang && window.getMedicareLang() === 'ar') || document.documentElement.getAttribute('lang') === 'ar';
                            feedback.textContent = isAr 
                                ? 'رقم الهاتف يجب أن يحتوي على أرقام فقط وبدون حروف' 
                                : 'Phone number must contain only digits without letters.';
                        }
                    } else if (input.classList.contains('is-invalid') && !hasLetters) {
                        input.classList.remove('is-invalid');
                        if (feedback && (feedback.textContent.includes('أرقام فقط') || feedback.textContent.includes('digits without letters'))) {
                            feedback.textContent = '';
                        }
                    }
                }
            });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
