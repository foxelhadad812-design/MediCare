<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MediCare Clinic System</title>
    <!-- Instant Zero-Flash Theme & Localization Loader -->
    <script>
        (function() {
            var savedTheme = localStorage.getItem('medicare-theme') || 'light';
            document.documentElement.setAttribute('data-bs-theme', savedTheme);
            var savedLang = localStorage.getItem('medicare-lang') || 'en';
            document.documentElement.setAttribute('lang', savedLang);
            document.documentElement.setAttribute('dir', savedLang === 'ar' ? 'rtl' : 'ltr');
        })();
    </script>
    <!-- Typography: Cairo & Inter (Self-Hosted under wwwroot/lib/fonts/) -->
    <link rel="stylesheet" href="~/lib/fonts/fonts.css" asp-append-version="true" />
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons 1.11.3 (Self-Hosted) -->
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" asp-append-version="true" />
    <!-- Progressive Web App (PWA) Manifest -->
    <meta name="theme-color" content="#0066F5" />
    <link rel="manifest" href="~/manifest.json" />
    <link rel="apple-touch-icon" href="~/images/pwa-icon-192.png" />
    <!-- Custom World-Class Design System -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <!-- MediCare Animation System -->
    <link rel="stylesheet" href="~/css/animations.css" asp-append-version="true" />
</head>
<body>
    <a class="visually-hidden-focusable position-absolute top-0 start-0 p-2 bg-white text-primary rounded-end shadow" href="#main-content" data-i18n="skipToContent">Skip to main content</a>
    <header class="mc-header">
        <nav class="navbar navbar-expand-lg mc-navbar">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <div class="brand-icon">
                        <i class="bi bi-heart-pulse-fill"></i>
                    </div>
                    <span>MediCare</span>
                    <span class="brand-badge">Healthcare</span>
                </a>
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <i class="bi bi-list fs-2 text-dark"></i>
                </button>
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door"></i> <span data-i18n="home">Home</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-semibold" asp-controller="Doctors" asp-action="Index">
                                <i class="bi bi-search-heart"></i> <span data-i18n="findDoctors">Find Doctors</span>
                            </a>
                        </li>
                        @if (User.IsInRole("Doctor"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Doctor" asp-action="Schedule">
                                    <i class="bi bi-calendar-range"></i> <span data-i18n="schedule">Schedule</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Doctor" asp-action="Leaves">
                                    <i class="bi bi-calendar-x"></i> <span data-i18n="leaves">Leaves</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Doctor" asp-action="Appointments">
                                    <i class="bi bi-clipboard2-pulse"></i> <span data-i18n="appointments">Appointments</span>
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("Patient"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Appointments" asp-action="MyAppointments">
                                    <i class="bi bi-calendar-check"></i> <span data-i18n="myAppointments">My Appointments</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="MedicalRecords" asp-action="MyHistory">
                                    <i class="bi bi-journal-medical"></i> <span data-i18n="medicalRecords">Medical Records</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Profile">
                                    <i class="bi bi-person-circle"></i> <span data-i18n="myProfile">My Profile</span>
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Index">
                                    <i class="bi bi-speedometer2"></i> <span data-i18n="dashboard">Dashboard</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Patients">
                                    <i class="bi bi-people"></i> <span>Patients</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Pharmacists">
                                    <i class="bi bi-capsule"></i> <span>Pharmacists</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Specializations">
                                    <i class="bi bi-tags"></i> <span>Specializations</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Approvals">
                                    <i class="bi bi-person-check"></i> <span data-i18n="approvals">Approvals</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Reports">
                                    <i class="bi bi-bar-chart-line"></i> <span data-i18n="reports">Reports</span>
                                </a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-center gap-2">
                        <!-- Theme Toggle Button -->
                        <li class="nav-item">
                            <button class="btn btn-sm btn-outline-secondary rounded-pill px-2 py-1 d-flex align-items-center gap-1" id="themeToggleBtn" type="button" title="Toggle Dark/Light Mode">
                                <i class="bi bi-moon-stars-fill" id="themeIcon"></i>
                                <span class="d-none d-md-inline small fw-medium" id="themeLabel">Dark</span>
                            </button>
                        </li>

                        <!-- Language Toggle Button -->
                        <li class="nav-item">
                            <button class="btn btn-sm btn-outline-primary rounded-pill px-2 py-1 d-flex align-items-center gap-1" id="langToggleBtn" type="button" title="Toggle Arabic / English">
                                <i class="bi bi-translate"></i>
                                <span class="small fw-bold" id="langLabel">العربية</span>
                            </button>
                        </li>

                        <!-- PWA Install Button -->
                        <li class="nav-item" id="pwaInstallLi" style="display: none;">
                            <button class="btn btn-sm btn-outline-success rounded-pill px-2 py-1 d-flex align-items-center gap-1" id="pwaNavInstallBtn" type="button" title="Install App">
                                <i class="bi bi-download"></i>
                                <span class="d-none d-md-inline small fw-semibold" data-i18n="installAppBtn">Install App</span>
                            </button>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <!-- Real-Time Notification Bell Dropdown -->
                            <li class="nav-item dropdown position-relative">
                                <button class="notification-bell-btn" id="notificationDropdownBtn" data-bs-toggle="dropdown" aria-expanded="false" title="Real-time Notifications">
                                    <i class="bi bi-bell"></i>
                                    <span id="notificationBadge" class="notification-pulse-badge d-none">
                                        0
                                    </span>
                                </button>
                                <div class="dropdown-menu dropdown-menu-end shadow-lg p-0 border-0 rounded-3 mt-2" aria-labelledby="notificationDropdownBtn" style="min-width: 340px; max-width: 380px;">
                                    <div class="p-3 border-bottom d-flex justify-content-between align-items-center bg-light rounded-top-3">
                                        <div class="fw-bold text-dark d-flex align-items-center gap-2">
                                            <i class="bi bi-bell-fill text-primary"></i> <span data-i18n="notifications">Notifications</span>
                                        </div>
                                        <span id="notificationCountLabel" class="badge bg-primary rounded-pill px-2 py-1">0 unread</span>
                                    </div>
                                    <ul class="list-group list-group-flush" id="notificationList" style="max-height: 320px; overflow-y: auto;">
                                        <li class="list-group-item text-center text-muted small py-4">
                                            <i class="bi bi-arrow-repeat spin me-1"></i> Checking notifications...
                                        </li>
                                    </ul>
                                </div>
                            </li>

                            <!-- User Profile Chip -->
                            <li class="nav-item">
                                <div class="user-chip">
                                    <div class="user-avatar-badge">
                                        @(string.IsNullOrEmpty(User.Identity.Name) ? "U" : User.Identity.Name.Substring(0, 1).ToUpper())
                                    </div>
                                    <div class="d-none d-sm-block text-start">
                                        <div class="fw-bold text-dark lh-1 small">@User.Identity.Name</div>
                                    </div>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <span class="user-role-badge user-role-admin">Admin</span>
                                    }
                                    else if (User.IsInRole("Doctor"))
                                    {
                                        <span class="user-role-badge user-role-doctor">Doctor</span>
                                    }
                                    else if (User.IsInRole("Patient"))
                                    {
                                        <span class="user-role-badge user-role-patient">Patient</span>
                                    }
                                </div>
                            </li>

                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-secondary btn-sm" title="Log out of system">
                                        <i class="bi bi-box-arrow-right"></i> <span class="d-none d-md-inline" data-i18n="logout">Log Out</span>
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-outline-primary btn-sm" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right"></i> <span data-i18n="signIn">Sign In</span>
                                </a>
                            </li>
                            <li class="nav-item dropdown">
                                <button class="btn btn-primary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-plus"></i> <span data-i18n="join">Join MediCare</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3 p-2">
                                    <li>
                                        <a class="dropdown-item py-2 px-3 rounded-2" asp-controller="Account" asp-action="RegisterPatient">
                                            <div class="fw-semibold text-dark"><i class="bi bi-person me-2 text-primary"></i> <span data-i18n="patientAccount">Patient Account</span></div>
                                            <div class="small text-muted ps-4">Book slots & view digital medical records</div>
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider my-1"></li>
                                    <li>
                                        <a class="dropdown-item py-2 px-3 rounded-2" asp-controller="Account" asp-action="RegisterDoctor">
                                            <div class="fw-semibold text-dark"><i class="bi bi-hospital me-2 text-success"></i> <span data-i18n="doctorPractice">Doctor Practice</span></div>
                                            <div class="small text-muted ps-4">Manage schedules & clinical encounters</div>
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container my-4 flex-grow-1">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert" style="background-color: #ECFDF5; border-left: 4px solid #10B981 !important; color: #065F46;">
                <i class="bi bi-check-circle-fill text-success fs-5"></i>
                <div class="flex-grow-1">
                    <strong>Success:</strong> @TempData["SuccessMessage"]
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert" style="background-color: #FEF2F2; border-left: 4px solid #EF4444 !important; color: #991B1B;">
                <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
                <div class="flex-grow-1">
                    <strong>Notice:</strong> @TempData["ErrorMessage"]
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["InfoMessage"] != null)
        {
            <div class="alert alert-info alert-dismissible fade show border-0 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert" style="background-color: #EFF6FF; border-left: 4px solid #0066F5 !important; color: #1E40AF;">
                <i class="bi bi-info-circle-fill text-primary fs-5"></i>
                <div class="flex-grow-1">
                    <strong>Information:</strong> @TempData["InfoMessage"]
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <main id="main-content" role="main" tabindex="-1">
            @RenderBody()
        </main>
    </div>

    <!-- World-Class 4-Column Footer -->
    <footer class="mc-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div class="brand-icon" style="width: 32px; height: 32px; font-size: 1rem;">
                            <i class="bi bi-heart-pulse-fill"></i>
                        </div>
                        <span class="fw-bold fs-5 text-dark">MediCare</span>
                        <span class="brand-badge" data-i18n="footerHealthcareBadge">Healthcare OS</span>
                    </div>
                    <p class="text-muted small pe-lg-4" data-i18n="footerDesc">
                        A clinic management graduation project for appointment booking and basic digital clinical workflows.
                    </p>
                    <div class="d-flex align-items-center gap-2 text-muted small mt-3">
                        <span class="d-inline-block rounded-circle bg-success" style="width: 8px; height: 8px;"></span>
                            <span class="fw-semibold text-dark" data-i18n="footerOperational">Demo version</span>
                        <span class="text-secondary" data-i18n="footerCairoTime">• Egypt Standard Time</span>
                    </div>
                </div>

                <div class="col-lg-2 col-md-6 col-6">
                    <h6 class="footer-heading" data-i18n="footerForPatients">For Patients</h6>
                    <ul class="footer-link-list">
                        <li><a asp-controller="Doctors" asp-action="Index"><i class="bi bi-chevron-right small me-1"></i> <span data-i18n="footerFindDoctors">Find Doctors</span></a></li>
                        <li><a asp-controller="Home" asp-action="Index"><i class="bi bi-chevron-right small me-1"></i> <span data-i18n="footerSpecialties">Specialties</span></a></li>
                        <li><a asp-controller="Appointments" asp-action="MyAppointments"><i class="bi bi-chevron-right small me-1"></i> <span data-i18n="footerMyVisits">My Visits</span></a></li>
                        <li><a asp-controller="MedicalRecords" asp-action="MyHistory"><i class="bi bi-chevron-right small me-1"></i> <span data-i18n="footerDigitalRecords">Digital Records</span></a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6 col-6">
                    <h6 class="footer-heading" data-i18n="footerClinicalPortals">Clinical Portals</h6>
                    <ul class="footer-link-list">
                        <li><a asp-controller="Account" asp-action="RegisterDoctor"><i class="bi bi-chevron-right small me-1"></i> <span data-i18n="footerJoinDoctor">Join as Physician</span></a></li>
                        <li><a asp-controller="Doctor" asp-action="Schedule"><i class="bi bi-chevron-right small me-1"></i> <span data-i18n="footerShiftMgmt">Shift Management</span></a></li>
                        <li><a asp-controller="Doctor" asp-action="Appointments"><i class="bi bi-chevron-right small me-1"></i> <span data-i18n="footerPatientQueue">Patient Queue</span></a></li>
                        <li><a asp-controller="Admin" asp-action="Approvals"><i class="bi bi-chevron-right small me-1"></i> <span data-i18n="footerDoctorLicensing">Doctor Licensing</span></a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h6 class="footer-heading" data-i18n="footerArchTrust">Architecture & Trust</h6>
                    <ul class="footer-link-list">
                        <li class="text-muted small"><i class="bi bi-shield-check text-success me-1"></i> <span data-i18n="footerSqlConcurrency">SQL Server Filtered Concurrency</span></li>
                        <li class="text-muted small"><i class="bi bi-broadcast text-primary me-1"></i> <span data-i18n="footerSignalR">Real-time SignalR 8.0 Hub</span></li>
                        <li class="text-muted small"><i class="bi bi-file-earmark-medical text-info me-1"></i> <span data-i18n="footerRxGen">Digital Prescription Generator</span></li>
                        <li class="text-muted small"><i class="bi bi-mortarboard text-warning me-1"></i> <span data-i18n="footerDepi">DEPI .NET Full Stack Project</span></li>
                    </ul>
                </div>
            </div>

            <!-- DEPI Official Project Attribution Banner -->
            <div class="mt-4 pt-3 border-top d-flex justify-content-between align-items-center flex-wrap gap-3" style="border-color: rgba(226, 232, 240, 0.4) !important;">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-primary text-white px-2 py-1 fw-bold rounded-pill shadow-xs" style="font-size: 0.72rem; letter-spacing: 0.04em;">DEPI 2026</span>
                    <span class="small fw-semibold text-dark" data-i18n="footerDepiGraduates">
                        مشروع تخرج مُطوّر ومُنفّذ بواسطة: خريجي منحة مبادرة رواد مصر الرقمية (DEPI - Digital Egypt Pioneers Initiative)
                    </span>
                </div>
                <div class="text-muted small d-flex align-items-center gap-1" data-i18n="footerDepiTrack">
                    <i class="bi bi-mortarboard-fill text-warning"></i> مسار تطوير تطبيقات الويب المتكاملة (.NET Full Stack Track)
                </div>
            </div>

            <div class="footer-bottom d-flex justify-content-between align-items-center flex-wrap gap-2 mt-3 pt-2">
                <div>
                    &copy; 2026 <strong data-i18n="footerBrandName">MediCare Healthcare Systems</strong>. <span data-i18n="footerAllRights">All rights reserved.</span>
                </div>
                    <a asp-controller="Home" asp-action="Privacy" class="small" data-i18n="privacyTitle">Privacy and Demo Data</a>
                <div class="text-muted small" data-i18n="footerCredits">
                    Built with ASP.NET Core 8.0 LTS &bull; Entity Framework Core &bull; Clean 3-Tier Architecture
                </div>
            </div>
        </div>
    </footer>

    <!-- Real-Time Floating Toast Container -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1090;" id="realtimeToastContainer"></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <!-- SignalR 8.0 Client (Self-Hosted) -->
        <script src="~/lib/signalr/signalr.min.js" asp-append-version="true"></script>
        <script>
            (function () {
                const badge = document.getElementById('notificationBadge');
                const list = document.getElementById('notificationList');
                const countLabel = document.getElementById('notificationCountLabel');
                const toastContainer = document.getElementById('realtimeToastContainer');
                let unreadCount = 0;

                function updateBadge(count) {
                    unreadCount = Math.max(0, count);
                    if (countLabel) countLabel.textContent = unreadCount + ' unread';
                    if (badge) {
                        badge.textContent = unreadCount;
                        if (unreadCount > 0) {
                            badge.classList.remove('d-none');
                        } else {
                            badge.classList.add('d-none');
                        }
                    }
                }

                window.showMediCareToast = function(title, message, type = 'primary') {
                    if (!toastContainer) return;
                    const toastId = 'toast_' + Date.now();
                    const bgClass = type === 'success' ? 'text-bg-success' : (type === 'danger' ? 'text-bg-danger' : (type === 'warning' ? 'text-bg-warning text-dark' : 'text-bg-primary'));
                    const iconClass = type === 'success' ? 'bi-check-circle-fill' : (type === 'danger' ? 'bi-exclamation-triangle-fill' : 'bi-bell-fill');
                    const toastHtml = `
                        <div id="${toastId}" class="toast align-items-center ${bgClass} border-0 shadow-lg mb-2 rounded-3" role="alert" aria-live="assertive" aria-atomic="true">
                            <div class="d-flex">
                                <div class="toast-body p-3">
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <i class="bi ${iconClass}"></i>
                                        <strong class="fs-6">${title}</strong>
                                    </div>
                                    <div class="small opacity-90">${message}</div>
                                </div>
                                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                            </div>
                        </div>`;
                    toastContainer.insertAdjacentHTML('beforeend', toastHtml);
                    const toastEl = document.getElementById(toastId);
                    const bsToast = new bootstrap.Toast(toastEl, { delay: 6000 });
                    bsToast.show();
                    toastEl.addEventListener('hidden.bs.toast', () => toastEl.remove());
                };

                function showToast(title, message) {
                    window.showMediCareToast(title, message, 'primary');
                }

                function addNotificationItem(item, prepend = false) {
                    if (!list) return;
                    const itemHtml = `
                        <li class="list-group-item p-3 list-group-item-action d-flex justify-content-between align-items-start border-bottom" id="notif_${item.id}">
                            <div class="me-2">
                                <div class="fw-bold small text-dark d-flex align-items-center gap-1">
                                    <i class="bi bi-info-circle text-primary"></i> ${item.title}
                                </div>
                                <div class="text-secondary small mt-1">${item.message}</div>
                            </div>
                            <button class="btn btn-sm btn-link text-decoration-none text-muted p-0 mark-read-btn" data-id="${item.id}" title="Mark as read">
                                <i class="bi bi-x-circle fs-6"></i>
                            </button>
                        </li>`;
                    if (prepend) {
                        list.insertAdjacentHTML('afterbegin', itemHtml);
                    } else {
                        list.insertAdjacentHTML('beforeend', itemHtml);
                    }
                    attachMarkReadHandlers();
                }

                function attachMarkReadHandlers() {
                    document.querySelectorAll('.mark-read-btn').forEach(btn => {
                        btn.onclick = function (e) {
                            e.stopPropagation();
                            const id = this.getAttribute('data-id');
                            fetch(`/api/notifications/mark-read/${id}`, { method: 'POST' })
                                .then(res => res.json())
                                .then(data => {
                                    if (data.success) {
                                        const li = document.getElementById('notif_' + id);
                                        if (li) li.remove();
                                        updateBadge(unreadCount - 1);
                                        if (list.children.length === 0) {
                                            list.innerHTML = '<li class="list-group-item text-center text-muted small py-4"><i class="bi bi-check2-all text-success fs-5 d-block mb-1"></i> All caught up! No unread alerts.</li>';
                                        }
                                    }
                                });
                        };
                    });
                }

                // Initial load from DB
                fetch('/api/notifications/unread')
                    .then(res => res.json())
                    .then(res => {
                        if (res.success && res.data) {
                            updateBadge(res.data.length);
                            if (res.data.length === 0) {
                                list.innerHTML = '<li class="list-group-item text-center text-muted small py-4"><i class="bi bi-check2-all text-success fs-5 d-block mb-1"></i> All caught up! No unread alerts.</li>';
                            } else {
                                list.innerHTML = '';
                                res.data.forEach(item => addNotificationItem(item, false));
                            }
                        }
                    })
                    .catch(() => {
                        if (list) list.innerHTML = '<li class="list-group-item text-center text-muted small py-3 text-danger"><i class="bi bi-wifi-off me-1"></i> Unable to load notifications.</li>';
                    });

                // SignalR Connection
                const connection = new signalR.HubConnectionBuilder()
                    .withUrl("/hubs/appointment")
                    .withAutomaticReconnect()
                    .build();

                connection.on("ReceiveNotification", function (notification) {
                    showToast(notification.title, notification.message);
                    updateBadge(unreadCount + 1);
                    if (list.querySelector('.text-muted.py-4') || list.querySelector('.text-muted.py-3')) {
                        list.innerHTML = '';
                    }
                    addNotificationItem(notification, true);
                });

                connection.on("AppointmentStatusChanged", function (appointmentId, status) {
                    showToast("Appointment Status Updated", `Appointment #${appointmentId} is now ${status}.`);
                });

                connection.start().catch(err => console.error("SignalR Connection Error: ", err));
            })();
        </script>
    }

