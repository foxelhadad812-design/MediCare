@model CreateEncounterViewModel
@{
    ViewData["Title"] = "Document Clinical Consultation";
}

<div class="row mb-3">
    <div class="col-12">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item"><a asp-controller="Doctor" asp-action="Appointments">Appointments</a></li>
                <li class="breadcrumb-item active" aria-current="page">Clinical Encounter</li>
            </ol>
        </nav>
    </div>
</div>

<!-- Patient Summary Ribbon -->
<div class="card shadow-sm border-0 mb-4 bg-light">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <span class="badge bg-primary mb-1">Appointment #@Model.Appointment.Id</span>
                <h3 class="fw-bold mb-1 text-dark">&#128100; Patient: @Model.Appointment.PatientName</h3>
                <p class="text-muted mb-0">
                    <span>&#128197; <strong>Date:</strong> @Model.Appointment.FormattedDate</span>
                    <span class="ms-3">&#128337; <strong>Time:</strong> @Model.Appointment.FormattedTime</span>
                    @if (!string.IsNullOrEmpty(Model.Appointment.PatientPhoneNumber))
                    {
                        <span class="ms-3">&#128222; <strong>Phone:</strong> @Model.Appointment.PatientPhoneNumber</span>
                    }
                </p>
            </div>
            <div class="text-end">
                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 fs-6">
                    Status: @Model.Appointment.Status
                </span>
                <div class="text-muted small mt-1">Fee: @Model.Appointment.ConsultationFee.ToString("N0") EGP</div>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(Model.Appointment.Notes))
        {
            <div class="mt-3 p-2 bg-white rounded border">
                <strong class="text-secondary small">Patient Booking Note:</strong>
                <span class="text-dark small ms-1">@Model.Appointment.Notes</span>
            </div>
        }
    </div>
</div>

<form asp-action="Create" method="post" enctype="multipart/form-data" id="encounterForm">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Encounter.AppointmentId" />

    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

    <div class="row g-4">
        <!-- Left Column: Clinical Diagnosis & Documentation -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="fw-bold mb-0 text-dark">&#128221; Clinical Consultation Notes</h5>
                </div>
                <div class="card-body p-4">
                    <div class="mb-3">
                        <label asp-for="Encounter.Diagnosis" class="form-label fw-bold text-dark">
                            Clinical Diagnosis <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Encounter.Diagnosis" class="form-control form-control-lg" placeholder="e.g. Acute Pharyngitis, Essential Hypertension" required />
                        <span asp-validation-for="Encounter.Diagnosis" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Encounter.Symptoms" class="form-label fw-semibold text-secondary">
                            Symptoms & Observations
                        </label>
                        <textarea asp-for="Encounter.Symptoms" class="form-control" rows="3" placeholder="Patient reported fever, sore throat for 3 days..."></textarea>
                        <span asp-validation-for="Encounter.Symptoms" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Encounter.VisitNotes" class="form-label fw-semibold text-secondary">
                            Consultation & Follow-up Notes
                        </label>
                        <textarea asp-for="Encounter.VisitNotes" class="form-control" rows="4" placeholder="Advised bed rest, hydration. Review in 10 days if symptoms persist..."></textarea>
                        <span asp-validation-for="Encounter.VisitNotes" class="text-danger small"></span>
                    </div>

                    <!-- Diagnostic File Upload -->
                    <div class="mb-3">
                        <label asp-for="Attachment" class="form-label fw-semibold text-secondary">
                            &#128206; Diagnostic Attachment (Lab Report / Radiology / Scan)
                        </label>
                        <input asp-for="Attachment" type="file" class="form-control" accept=".jpg,.jpeg,.png,.pdf" />
                        <div class="form-text text-muted small">
                            Accepted file formats: <strong>JPG, PNG, PDF</strong> (Maximum size: <strong>5 MB</strong>).
                        </div>
                        <span asp-validation-for="Attachment" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Digital Prescription Items -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0 text-dark">&#128138; Digital Prescription (Rx)</h5>
                    <button type="button" class="btn btn-outline-primary btn-sm" id="btnAddMedication">
                        + Add Medication
                    </button>
                </div>
                <div class="card-body p-4">
                    <div id="prescriptionItemsContainer">
                        @if (Model.Encounter.PrescriptionItems != null && Model.Encounter.PrescriptionItems.Any())
                        {
                            for (int i = 0; i < Model.Encounter.PrescriptionItems.Count; i++)
                            {
                                <div class="prescription-row border rounded p-3 mb-3 bg-light position-relative">
                                    <button type="button" class="btn btn-sm btn-outline-danger position-absolute top-0 end-0 m-2 btn-remove-row" title="Remove">&times;</button>
                                    <div class="row g-2">
                                        <div class="col-md-7">
                                            <label class="form-label small fw-bold">Medication Name *</label>
                                            <input name="Encounter.PrescriptionItems[@i].MedicationName" value="@Model.Encounter.PrescriptionItems[i].MedicationName" class="form-control form-control-sm" placeholder="e.g. Amoxicillin 500mg" required />
                                        </div>
                                        <div class="col-md-5">
                                            <label class="form-label small fw-bold">Dosage *</label>
                                            <input name="Encounter.PrescriptionItems[@i].Dosage" value="@Model.Encounter.PrescriptionItems[i].Dosage" class="form-control form-control-sm" placeholder="e.g. 1 capsule" required />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label small fw-bold">Frequency *</label>
                                            <input name="Encounter.PrescriptionItems[@i].Frequency" value="@Model.Encounter.PrescriptionItems[i].Frequency" class="form-control form-control-sm" placeholder="e.g. 3 times daily" required />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label small fw-bold">Duration (Days) *</label>
                                            <input type="number" min="1" max="365" name="Encounter.PrescriptionItems[@i].DurationDays" value="@(Model.Encounter.PrescriptionItems[i].DurationDays > 0 ? Model.Encounter.PrescriptionItems[i].DurationDays : 7)" class="form-control form-control-sm" required />
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label small text-secondary">Instructions / Advice</label>
                                            <input name="Encounter.PrescriptionItems[@i].Instructions" value="@Model.Encounter.PrescriptionItems[i].Instructions" class="form-control form-control-sm" placeholder="e.g. After meals with plenty of water" />
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>

                    <div id="noMedicationsPlaceholder" class="@(Model.Encounter.PrescriptionItems != null && Model.Encounter.PrescriptionItems.Any() ? "d-none" : "") p-4 text-center text-muted border rounded border-dashed mb-3">
                        <div class="fs-3 mb-1">&#128138;</div>
                        <p class="mb-2">No medications added yet.</p>
                        <button type="button" class="btn btn-sm btn-outline-primary" id="btnAddMedicationEmpty">
                            + Add First Medication
                        </button>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Encounter.Notes" class="form-label fw-semibold text-secondary">
                            Pharmacist / General Dispensing Notes
                        </label>
                        <textarea asp-for="Encounter.Notes" class="form-control" rows="2" placeholder="e.g. Generic substitutions allowed..."></textarea>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Sticky Bottom Bar -->
    <div class="card shadow-sm border-0 mt-4 bg-white">
        <div class="card-body p-3 d-flex justify-content-between align-items-center">
            <a asp-controller="Doctor" asp-action="Appointments" class="btn btn-outline-secondary">
                &larr; Back to Appointments
            </a>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success btn-lg px-4 fw-bold shadow-sm">
                    &#10003; Complete Consultation & Finalize Visit
                </button>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const container = document.getElementById("prescriptionItemsContainer");
            const placeholder = document.getElementById("noMedicationsPlaceholder");
            const btnAdd = document.getElementById("btnAddMedication");
            const btnAddEmpty = document.getElementById("btnAddMedicationEmpty");

            function updateRowIndices() {
                const rows = container.querySelectorAll(".prescription-row");
                rows.forEach((row, index) => {
                    row.querySelectorAll("input, select, textarea").forEach(input => {
                        const name = input.getAttribute("name");
                        if (name && name.startsWith("Encounter.PrescriptionItems[")) {
                            input.setAttribute("name", name.replace(/Encounter\.PrescriptionItems\[\d+\]/, `Encounter.PrescriptionItems[${index}]`));
                        }
                    });
                });

                if (rows.length === 0) {
                    placeholder.classList.remove("d-none");
                } else {
                    placeholder.classList.add("d-none");
                }
            }

            function addMedicationRow() {
                const count = container.querySelectorAll(".prescription-row").length;
                const rowHtml = `
                    <div class="prescription-row border rounded p-3 mb-3 bg-light position-relative">
                        <button type="button" class="btn btn-sm btn-outline-danger position-absolute top-0 end-0 m-2 btn-remove-row" title="Remove">&times;</button>
                        <div class="row g-2">
                            <div class="col-md-7">
                                <label class="form-label small fw-bold">Medication Name *</label>
                                <input name="Encounter.PrescriptionItems[${count}].MedicationName" class="form-control form-control-sm" placeholder="e.g. Amoxicillin 500mg" required />
                            </div>
                            <div class="col-md-5">
                                <label class="form-label small fw-bold">Dosage *</label>
                                <input name="Encounter.PrescriptionItems[${count}].Dosage" class="form-control form-control-sm" placeholder="e.g. 1 capsule" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Frequency *</label>
                                <input name="Encounter.PrescriptionItems[${count}].Frequency" class="form-control form-control-sm" placeholder="e.g. 3 times daily" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Duration (Days) *</label>
                                <input type="number" min="1" max="365" name="Encounter.PrescriptionItems[${count}].DurationDays" value="7" class="form-control form-control-sm" required />
                            </div>
                            <div class="col-12">
                                <label class="form-label small text-secondary">Instructions / Advice</label>
                                <input name="Encounter.PrescriptionItems[${count}].Instructions" class="form-control form-control-sm" placeholder="e.g. After meals with water" />
                            </div>
                        </div>
                    </div>
                `;
                container.insertAdjacentHTML("beforeend", rowHtml);
                updateRowIndices();
            }

            btnAdd?.addEventListener("click", addMedicationRow);
            btnAddEmpty?.addEventListener("click", addMedicationRow);

            container.addEventListener("click", function (e) {
                if (e.target && (e.target.classList.contains("btn-remove-row") || e.target.closest(".btn-remove-row"))) {
                    const row = e.target.closest(".prescription-row");
                    if (row) {
                        row.remove();
                        updateRowIndices();
                    }
                }
            });
        });
    </script>
}
