@{
    ViewData["Title"] = "التحقق الرقمي من الروشتة - كود غير صالح";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5 text-center">
            <div class="card border-0 shadow-sm rounded-4 p-5">
                <div class="brand-icon mx-auto mb-3 bg-danger bg-opacity-10 text-danger" style="width: 64px; height: 64px; font-size: 2rem;">
                    <i class="bi bi-shield-x"></i>
                </div>
                <h4 class="fw-bold text-dark mb-2">فشل التحقق من الروشتة</h4>
                <p class="text-muted small mb-4">
                    رمز التحقق غير صالح أو لم يتم العثور على روشتة طبية مطابقة. يرجى مسح رمز الـ QR الأصلي المطبوع على الروشتة أو مراجعة الطبيب المعالج.
                </p>
                <div>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary btn-sm px-4 rounded-pill">
                        <i class="bi bi-house me-1"></i> الصفحة الرئيسية
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
