@model MediCare.Services.DTOs.PrescriptionVerificationDto
@{
    ViewData["Title"] = "التحقق الرقمي من الروشتة الطبية";
    Layout = "_Layout";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <!-- Brand & Security Header -->
            <div class="text-center mb-4">
                <div class="brand-icon mx-auto mb-2" style="width: 48px; height: 48px; font-size: 1.5rem;">
                    <i class="bi bi-shield-check text-success"></i>
                </div>
                <h3 class="fw-bold text-dark">بوابة التحقق الرقمي من الروشتات الطبية</h3>
                <p class="text-muted small">MediCare Official Rx Digital Verification Portal &bull; صالحة ومعتمدة نقابياً</p>
            </div>

            <div class="card border-0 shadow rounded-4 overflow-hidden mb-4 reveal reveal-scale is-visible">
                <!-- Status Banner -->
                <div class="p-4 @(Model.IsDispensed ? "bg-info bg-opacity-10 border-bottom border-info" : "bg-success bg-opacity-10 border-bottom border-success")">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            @if (Model.IsDispensed)
                            {
                                <span class="badge bg-info text-dark px-3 py-2 fs-6 mb-1">
                                    <i class="bi bi-bag-check-fill me-1"></i> تم صرف الروشتة (Already Dispensed)
                                </span>
                                @if (Model.DispensedAt.HasValue)
                                {
                                    <div class="small text-muted">تاريخ وتوقيت الصرف: @Model.DispensedAt.Value.ToString("yyyy-MM-dd hh:mm tt")</div>
                                }
                            }
                            else
                            {
                                <span class="badge bg-success px-3 py-2 fs-6 mb-1">
                                    <i class="bi bi-patch-check-fill me-1"></i> روشتة إلكترونية أصلية معتمدة وقابلة للصرف
                                </span>
                                <div class="small text-success fw-semibold">صالحة للصرف لدى جميع الصيدليات المعتمدة</div>
                            }
                        </div>
                        <div class="text-end">
                            <span class="badge bg-dark px-3 py-2">روشتة موثقة</span>
                            <div class="small text-muted mt-1">تاريخ الإصدار: @Model.PrescriptionDate.ToString("yyyy-MM-dd")</div>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4 p-md-5">
                    <!-- Physician & Patient Details Grid (Minimal Public Disclosure) -->
                    <div class="row g-4 mb-4 pb-4 border-bottom">
                        <div class="col-md-6 border-end-md">
                            <h6 class="text-muted small fw-bold text-uppercase mb-2">
                                <i class="bi bi-hospital text-primary me-1"></i> الطبيب المعالج
                            </h6>
                            <h5 class="fw-bold text-dark mb-1">د. @Model.DoctorName</h5>
                            <div class="text-primary fw-semibold small">@Model.Specialization</div>
                        </div>
                        <div class="col-md-6 ps-md-4">
                            <h6 class="text-muted small fw-bold text-uppercase mb-2">
                                <i class="bi bi-person text-primary me-1"></i> اسم المريض (مموه لحماية الخصوصية)
                            </h6>
                            <h5 class="fw-bold text-dark mb-1 font-monospace">@Model.MaskedPatientName</h5>
                            <div class="text-muted small">تم تشفير الاسم لحماية الخصوصية الطبية للمريض</div>
                        </div>
                    </div>

                    <!-- Security Notice -->
                    <div class="p-3 bg-light rounded-3 border d-flex align-items-center gap-3">
                        <i class="bi bi-info-circle-fill text-primary fs-3"></i>
                        <div class="small text-muted">
                            وفقاً لمعايير الخصوصية الطبية وأمن المعلومات، لا تُعرض قائمة الأدوية أو التشخيص الطبي للعامة، ويقتصر صرف الأدوية والاطلاع على الجرعات للصيادلة المعتمدين المسجلين في النظام.
                        </div>
                    </div>

                    @if (User.IsInRole("Pharmacist") || User.IsInRole("Admin"))
                    {
                        <div class="mt-4 pt-3 border-top text-center">
                            <a asp-action="Dispense" asp-route-token="@ViewBag.Token" class="btn btn-primary px-4 py-2 rounded-pill shadow-sm">
                                <i class="bi bi-capsule-pill me-1"></i> الدخول إلى بوابة الصيدلي المعتمد لصرف الأدوية
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
