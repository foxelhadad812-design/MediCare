@model MediCare.Web.ViewModels.DoctorListViewModel
@{
    ViewData["Title"] = "Find Verified Doctors";
}

<!-- Page Header -->
<div class="row mb-4 align-items-center">
    <div class="col-md-8">
        <h2 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
            <i class="bi bi-person-heart text-primary"></i> <span data-i18n="docHeaderTitle">Find a Verified Doctor</span>
        </h2>
        <p class="text-secondary mb-0" data-i18n="docHeaderSubtitle">Browse accredited medical specialists, review clinic fees, and check weekly available consultation shifts.</p>
    </div>
    <div class="col-md-4 text-md-end mt-3 mt-md-0">
        <span class="badge bg-light text-dark border px-3 py-2 rounded-pill">
            <i class="bi bi-check-circle-fill text-success me-1"></i> <strong>@Model.Doctors.TotalCount</strong> <span data-i18n="docDoctorsAvailable">Doctors Available</span>
        </span>
    </div>
</div>

<!-- Modern Search & Filter Card -->
<div class="card mb-4 p-4 bg-white shadow-sm border-0">
    <form method="get" asp-action="Index">
        <div class="row g-3">
            <div class="col-lg-4 col-md-6">
                <label class="form-label small fw-semibold" data-i18n="docSearchLabel">Doctor Name or Keyword</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="SearchTerm" value="@Model.Filter.SearchTerm" class="form-control border-start-0" placeholder="e.g. Ahmed, Cardiology..." data-i18n-ph="docSearchPlaceholder" />
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <label class="form-label small fw-semibold" data-i18n="docSpecLabel">Specialization</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-hospital"></i></span>
                    <select name="SpecializationId" class="form-select border-start-0">
                        <option value="" data-i18n="docAllSpecs">All Specializations</option>
                        @foreach (var spec in Model.Specializations)
                        {
                            if (Model.Filter.SpecializationId == spec.Id)
                            {
                                <option value="@spec.Id" selected="selected">@spec.Name</option>
                            }
                            else
                            {
                                <option value="@spec.Id">@spec.Name</option>
                            }
                        }
                    </select>
                </div>
            </div>
            <div class="col-lg-2 col-md-4">
                <label class="form-label small fw-semibold" data-i18n="docFeeLabel">Max Fee (EGP)</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-cash"></i></span>
                    <input type="number" name="MaxFee" value="@Model.Filter.MaxFee" step="10" class="form-control border-start-0" placeholder="Any" data-i18n-ph="docFeePlaceholder" />
                </div>
            </div>
            <div class="col-lg-2 col-md-4">
                <label class="form-label small fw-semibold" data-i18n="docDayLabel">Available Day</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-calendar3"></i></span>
                    <select name="AvailableDay" class="form-select border-start-0">
                        <option value="" data-i18n="docAnyDay">Any Day</option>
                        @foreach (DayOfWeek day in Enum.GetValues(typeof(DayOfWeek)))
                        {
                            if (Model.Filter.AvailableDay == day)
                            {
                                <option value="@day" selected="selected">@day</option>
                            }
                            else
                            {
                                <option value="@day">@day</option>
                            }
                        }
                    </select>
                </div>
            </div>
            <div class="col-lg-1 col-md-4 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100 py-2" title="Filter" data-i18n-title="docFilterBtn">
                    <i class="bi bi-funnel-fill"></i>
                </button>
            </div>
        </div>
        @if (Model.Filter.SpecializationId.HasValue || Model.Filter.MaxFee.HasValue || Model.Filter.AvailableDay.HasValue || !string.IsNullOrWhiteSpace(Model.Filter.SearchTerm))
        {
            <div class="mt-3 pt-2 border-top d-flex justify-content-between align-items-center">
                <span class="small text-muted" data-i18n="docFilterApplied">Filtered results applied</span>
                <a asp-action="Index" class="btn btn-link btn-sm text-danger text-decoration-none p-0">
                    <i class="bi bi-x-circle me-1"></i> <span data-i18n="docResetFilters">Reset all filters</span>
                </a>
            </div>
        }
    </form>
</div>

<!-- Governorate Quick-Filter Pills -->
<div class="d-flex flex-wrap align-items-center gap-2 mb-4 p-2 bg-light rounded-3 border">
    <span class="small fw-bold text-dark px-2 d-flex align-items-center gap-1">
        <i class="bi bi-geo-alt-fill text-danger"></i> <span data-i18n="docQuickGov">Governorates:</span>
    </span>
    <a asp-action="Index" class="btn btn-sm gov-pill @(string.IsNullOrEmpty(Model.Filter.SearchTerm) ? "btn-primary text-white" : "btn-outline-secondary")">الكل (All)</a>
    <a asp-action="Index" asp-route-SearchTerm="القاهرة" class="btn btn-sm gov-pill @(Model.Filter.SearchTerm == "القاهرة" ? "btn-primary text-white" : "btn-outline-secondary")">القاهرة (Cairo)</a>
    <a asp-action="Index" asp-route-SearchTerm="الجيزة" class="btn btn-sm gov-pill @(Model.Filter.SearchTerm == "الجيزة" ? "btn-primary text-white" : "btn-outline-secondary")">الجيزة (Giza)</a>
    <a asp-action="Index" asp-route-SearchTerm="الإسكندرية" class="btn btn-sm gov-pill @(Model.Filter.SearchTerm == "الإسكندرية" ? "btn-primary text-white" : "btn-outline-secondary")">الإسكندرية (Alexandria)</a>
    <a asp-action="Index" asp-route-SearchTerm="المنصورة" class="btn btn-sm gov-pill @(Model.Filter.SearchTerm == "المنصورة" ? "btn-primary text-white" : "btn-outline-secondary")">المنصورة (Mansoura)</a>
    <a asp-action="Index" asp-route-SearchTerm="طنطا" class="btn btn-sm gov-pill @(Model.Filter.SearchTerm == "طنطا" ? "btn-primary text-white" : "btn-outline-secondary")">طنطا (Tanta)</a>
    <a asp-action="Index" asp-route-SearchTerm="أسيوط" class="btn btn-sm gov-pill @(Model.Filter.SearchTerm == "أسيوط" ? "btn-primary text-white" : "btn-outline-secondary")">أسيوط (Assiut)</a>
    <a asp-action="Index" asp-route-SearchTerm="الزقازيق" class="btn btn-sm gov-pill @(Model.Filter.SearchTerm == "الزقازيق" ? "btn-primary text-white" : "btn-outline-secondary")">الزقازيق (Zagazig)</a>
    <a asp-action="Index" asp-route-SearchTerm="الإسماعيلية" class="btn btn-sm gov-pill @(Model.Filter.SearchTerm == "الإسماعيلية" ? "btn-primary text-white" : "btn-outline-secondary")">الإسماعيلية (Ismailia)</a>
    <a asp-action="Index" asp-route-SearchTerm="سوهاج" class="btn btn-sm gov-pill @(Model.Filter.SearchTerm == "سوهاج" ? "btn-primary text-white" : "btn-outline-secondary")">سوهاج (Sohag)</a>
    <a asp-action="Index" asp-route-SearchTerm="بور سعيد" class="btn btn-sm gov-pill @(Model.Filter.SearchTerm == "بور سعيد" ? "btn-primary text-white" : "btn-outline-secondary")">بور سعيد (Port Said)</a>
</div>

<!-- Doctors Grid -->
@if (!Model.Doctors.Items.Any())
{
    <div class="card p-5 text-center bg-white shadow-sm border-0">
        <div class="mb-3 text-muted" style="font-size: 3rem;">
            <i class="bi bi-search text-secondary opacity-50"></i>
        </div>
        <h4 class="fw-bold text-dark" data-i18n="docNoDoctors">No Doctors Found</h4>
        <p class="text-secondary col-md-6 mx-auto mb-4" data-i18n="docNoDoctorsDesc">No verified physicians matched your search criteria. Try removing some filters or searching with a different term.</p>
        <div>
            <a asp-action="Index" class="btn btn-outline-primary">
                <i class="bi bi-arrow-clockwise me-1"></i> <span data-i18n="docClearFilters">Clear Filters & View All</span>
            </a>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var doctor in Model.Doctors.Items)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 bg-white p-3 border-0 shadow-sm card-hover-tilt position-relative">
                    <div class="card-body d-flex flex-column p-2">
                        <!-- Top Row: Doctor Avatar + Specialty & Fee -->
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="position-relative flex-shrink-0">
                                @if (!string.IsNullOrEmpty(doctor.ProfileImageUrl))
                                {
                                    <img src="@doctor.ProfileImageUrl" alt="@doctor.FullName" class="rounded-circle shadow-sm doctor-avatar-img" style="width: 64px; height: 64px; object-fit: cover; border: 2.5px solid #2563eb;" onerror="this.onerror=null; this.src='/images/doctors/doctor-default.svg';" />
                                }
                                else
                                {
                                    <div class="doctor-avatar-circle" style="width: 64px; height: 64px; font-size: 1.35rem;">
                                        @(string.IsNullOrEmpty(doctor.FullName) ? "Dr" : doctor.FullName.Substring(0, 1).ToUpper())
                                    </div>
                                }
                                <span class="position-absolute bottom-0 end-0 bg-success border border-white rounded-circle pulse-indicator" style="width: 14px; height: 14px;" title="Active Verified Physician" data-i18n-title="docVerifiedBadge"></span>
                            </div>
                            <div class="flex-grow-1 overflow-hidden">
                                <h5 class="fw-bold text-dark mb-1 text-truncate" title="@doctor.FullName">
                                    <a asp-action="Details" asp-route-id="@doctor.Id" class="text-decoration-none text-dark hover-primary">
                                        @doctor.FullName
                                    </a>
                                </h5>
                                <div class="d-flex flex-wrap align-items-center gap-1 mb-1">
                                    <span class="badge badge-specialty">
                                        <i class="bi bi-heart-pulse-fill text-primary"></i> @doctor.SpecializationName
                                    </span>
                                    <span class="badge bg-light text-secondary border">@doctor.Title</span>
                                </div>
                                <div class="d-flex align-items-center gap-1 small">
                                    <span class="star-gold fw-bold"><i class="bi bi-star-fill"></i> @doctor.Rating.ToString("F1")</span>
                                    <span class="text-muted" style="font-size: 0.78rem;">(@doctor.ReviewCount تقييم)</span>
                                </div>
                            </div>
                        </div>

                        <!-- Location & Experience Row -->
                        <div class="d-flex align-items-center justify-content-between small text-muted mb-2 px-1">
                            <span class="text-truncate" title="@doctor.ClinicAddress">
                                <i class="bi bi-geo-alt-fill text-danger me-1"></i> @doctor.Governorate
                            </span>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill">
                                <i class="bi bi-award-fill me-1"></i> @doctor.ExperienceYears سنة خبرة
                            </span>
                        </div>

                        <!-- Bio Excerpt -->
                        <p class="text-secondary small flex-grow-1 mb-3" style="min-height: 38px; line-height: 1.5;">
                            @(string.IsNullOrWhiteSpace(doctor.Bio) ? "استشاري متخصص يقدم رعاية طبية متكاملة وفق أحدث البروتوكولات العلاجية العالمية." : (doctor.Bio.Length > 115 ? doctor.Bio.Substring(0, 112) + "..." : doctor.Bio))
                        </p>

                        <!-- Pricing & Schedule Info Box -->
                        <div class="p-3 bg-light rounded-3 mb-3 border border-light-subtle">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="small text-muted fw-semibold" data-i18n="docConsultationFee">سعر الكشف</span>
                                <span class="fw-bold text-primary fs-6">@doctor.ConsultationFee.ToString("N0") ج.م</span>
                            </div>
                            <div class="border-top pt-2">
                                <span class="small text-muted d-block mb-1" data-i18n="docAvailableShifts">أيام العمل المتاحة:</span>
                                @if (doctor.WorkingDays.Any())
                                {
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (var day in doctor.WorkingDays)
                                        {
                                            <span class="day-pill">@day.ToString().Substring(0, 3)</span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="small text-muted fst-italic" data-i18n="docScheduleReq">المواعيد بالتنسيق المسبق</span>
                                }
                            </div>
                        </div>

                        <!-- Actions -->
                        <div class="d-flex gap-2 mt-auto">
                            <a asp-action="Details" asp-route-id="@doctor.Id" class="btn btn-outline-secondary btn-sm flex-grow-1 d-flex align-items-center justify-content-center gap-1">
                                <i class="bi bi-person-lines-fill"></i> <span data-i18n="docProfile">الملف والتقييمات</span>
                            </a>
                            <a asp-controller="Appointments" asp-action="Book" asp-route-id="@doctor.Id" class="btn btn-primary btn-sm flex-grow-1 d-flex align-items-center justify-content-center gap-1 shadow-sm">
                                <i class="bi bi-calendar-plus"></i> <span data-i18n="docBookSlot">حجز كشف</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Pagination -->
    @if (Model.Doctors.TotalPages > 1)
    {
        <nav class="mt-5 d-flex justify-content-center" aria-label="Doctor directory pagination">
            <ul class="pagination shadow-sm">
                <li class="page-item @(Model.Doctors.HasPreviousPage ? "" : "disabled")">
                    <a class="page-link" asp-action="Index"
                       asp-route-Page="@(Model.Doctors.PageNumber - 1)"
                       asp-route-SearchTerm="@Model.Filter.SearchTerm"
                       asp-route-SpecializationId="@Model.Filter.SpecializationId"
                       asp-route-MaxFee="@Model.Filter.MaxFee"
                       asp-route-AvailableDay="@Model.Filter.AvailableDay">
                        <i class="bi bi-chevron-left"></i> <span data-i18n="docPrev">Previous</span>
                    </a>
                </li>
                @for (int p = 1; p <= Model.Doctors.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.Doctors.PageNumber ? "active" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-Page="@p"
                           asp-route-SearchTerm="@Model.Filter.SearchTerm"
                           asp-route-SpecializationId="@Model.Filter.SpecializationId"
                           asp-route-MaxFee="@Model.Filter.MaxFee"
                           asp-route-AvailableDay="@Model.Filter.AvailableDay">@p</a>
                    </li>
                }
                <li class="page-item @(Model.Doctors.HasNextPage ? "" : "disabled")">
                    <a class="page-link" asp-action="Index"
                       asp-route-Page="@(Model.Doctors.PageNumber + 1)"
                       asp-route-SearchTerm="@Model.Filter.SearchTerm"
                       asp-route-SpecializationId="@Model.Filter.SpecializationId"
                       asp-route-MaxFee="@Model.Filter.MaxFee"
                       asp-route-AvailableDay="@Model.Filter.AvailableDay">
                        <span data-i18n="docNext">Next</span> <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    }
}
